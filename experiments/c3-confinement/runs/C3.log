s routine: the refusal owes nothing to the classification.\\n\\tordinary := []string{\\\"internal/tui/model.go\\\"}\\n\\twidened := modifiedDiff(\\\"internal/tui/model.go\\\") + modifiedDiff(\\\"internal/tui/other.go\\\")\\n\\tif d := classifyRoutine(qualifyingPreflight(), nil, cleanEditCheck(), ordinary, shapeOf(widened)); !d.Routine {\\n\\t\\tt.Fatalf(\\\"this candidate should classify routine; blocked by %q\\\", d.Blocking)\\n\\t}\\n\\tif err := confineToPlan(widened, ordinary); err == nil {\\n\\t\\tt.Fatal(\\\"a routine classification carried a candidate outside its plan\\\")\\n\\t}\\n}\\nEOF\\ngofmt -l cmd internal; go vet ./... \u0026\u0026 go test ./internal/workflow/ -run 'Confine|WiderThanPlan|Formatter|OperationalTestGrant|SuppliedPlanIsNotWidened|GovernancePathClassification' -v 2\u003e\u00261 | tail -40\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":489,\"cache_read_input_tokens\":93008,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":489},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"ce908977-0f54-4f48-af44-0b16fb55e88c\",\"uuid\":\"c5b9ea81-b262-4d83-8d52-ee22c8107640\",\"timestamp\":\"2026-08-29T13:53:20.248Z\",\"request_id\":\"req_011CeX9irCXoLXzWVXTCLzj3\"}","payload":{"stream":"stdout"}}
