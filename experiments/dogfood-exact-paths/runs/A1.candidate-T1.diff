+)
+
+// The payoff: a candidate's pathnames reach the change report and the recorded
+// decision as the capture MEASURED them.
+//
+// Built with real Git, because what is at stake is exactly what Git emits for a
+// name it has to quote -- and the reader this replaces parsed that text back
+// and lost the name entirely.
+func TestExactPathsFromTheCaptureReachTheReportAndTheDecision(t *testing.T) {
+	repo, _ := mintRepo(t)
+	git := func(args ...string) {
+		t.Helper()
+		if out, err := exec.Command("git", append([]string{"-C", repo.Root}, args...)...).CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v\n%s", args, err, out)
+		}
+	}
+	awkward := "quo\"ted\tpath.go"
+	renamed := "re\tnamed.go"
+	if err := os.WriteFile(filepath.Join(repo.Root, awkward), []byte("package main\n"), 0o644); err != nil {
+		t.Skipf("this filesystem will not hold %q: %v", awkward, err)
+	}
+	os.Remove(filepath.Join(repo.Root, awkward))
+
+	// The base holds the two ordinary files the candidate goes on to delete and
+	// rename, so the candidate carries all three shapes at once. The deleted
+	// file shares nothing with the added one but its package line, so Git's
+	// rename detection cannot pair them into a rename the candidate never made.
+	os.WriteFile(filepath.Join(repo.Root, "gone.go"), []byte("package main\n\nconst removed = \"zzzzzzzzzzzzzzzzzzzzzzzzzzzz\"\n"), 0o644)
+	os.WriteFile(filepath.Join(repo.Root, "old.go"), []byte("package main\n\nfunc old() {}\n"), 0o644)
+	git("add", "-A")
+	git("commit", "-q", "-m", "base for the exact-path candidate")
+	out, err := exec.Command("git", "-C", repo.Root, "rev-parse", "HEAD").Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	base := strings.TrimSpace(string(out))
+
+	if err := os.WriteFile(filepath.Join(repo.Root, awkward), []byte("package main\n\nfunc added() {\n\tfor i := 0; i < 9; i++ {\n\t\tprintln(i)\n\t}\n}\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	os.Remove(filepath.Join(repo.Root, "gone.go"))
+	git("mv", "old.go", renamed)
+
+	capture, err := repo.CandidateCapture(context.Background(), base, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Git's own diff of Git's own path set: if these two readings of one
+	// candidate disagree, the constructor is wrong about the text Git emits.
+	if _, err := report.FromCapture(capture.Diff, capture.Paths); err != nil {
+		t.Fatalf("the capture and the diff rendered from it disagree: %v", err)
+	}
+
+	change, err := exactChange(capture.Diff, capture.Paths)
+	if err != nil {
+		t.Fatal(err)
+	}
+	paths := changedPathsOf(change)
+	held := map[string]bool{}
+	for _, p := range paths {
+		held[p] = true
+	}
+	if !held[awkward] {
+		t.Fatalf("the pathname Git quotes did not reach changedPaths: %q", paths)
+	}
+	if !held[renamed] {
+		t.Fatalf("the rename destination did not reach changedPaths: %q", paths)
+	}
+	if held["gone.go"] {
+		t.Fatalf("a deleted path is still listed as work that exists: %q", paths)
+	}
+	var rename report.FileChange
+	for _, f := range change.Files {
+		if f.Status == report.Renamed {
+			rename = f
+		}
+	}
+	if rename.Path != renamed || rename.OldPath != "old.go" {
+		t.Fatalf("the rename lost its exact paths: %#v (files %#v)", rename, change.Files)
+	}
+	if len(change.Files) != 3 {
+		t.Fatalf("files = %#v, want the addition, the deletion and the rename", change.Files)
+	}
+}
+
+// The report and the decision are built ONCE, from the capture's path set, and
+// the accepted candidate is described by that one reading rather than by two
+// re-parses of the diff text that could disagree.
+func TestTheChangeReportAndTheDecisionShareTheCapturesPathSet(t *testing.T) {
+	loop := funcBody(t, "internal/workflow/engine.go", "runCandidate")
+	if !strings.Contains(loop, "exactChange") || !strings.Contains(loop, "capture.Paths") {
+		t.Fatal("the accepted candidate's change is not built from the capture's exact path set")
+	}
+	if strings.Contains(funcBody(t, "internal/workflow/engine.go", "emitChangeReport"), "FromDiff") {
+		t.Fatal("the change report re-parses the diff text instead of using the change it was given")
+	}
+}
+
+// The diff a formatter rewrote and the path set the capture measured must be
+// two halves of ONE reading, so validate carries the path set through with the
+// diff it re-reads instead of leaving the caller to pair a fresh diff with a
+// stale measurement.
+func TestValidationReturnsTheExactPathsBesideTheDiffItReread(t *testing.T) {
+	body := funcBody(t, "internal/workflow/engine.go", "validate")
+	if !strings.Contains(body, "repo.CandidateCapture") {
+		t.Fatal("validate re-reads the diff without the path set the same capture measured")
+	}
+	if strings.Contains(body, "repo.CandidateDiff") {
+		t.Fatal("validate still throws away the measured path set of its re-read")
+	}
+	loop := funcBody(t, "internal/workflow/engine.go", "runCandidate")
+	if !strings.Contains(loop, "exactPaths") {
+		t.Fatal("the accepted candidate is not reported on the path set validation returned")
+	}
+}
+
+// A disagreement between the two readings of one candidate FAILS CLOSED.
+//
+// The parser this change exists to replace is still there, still exported, and
+// still lossy for a pathname Git quotes. Falling back to it when the exact
+// reading refuses would produce precisely the report this change was asked to
+// make impossible -- one that looks measured and was parsed.
+func TestAMismatchProducesNoChangeAtAllRatherThanAParsedOne(t *testing.T) {
+	// What a formatter that created a file after the measurement would leave:
+	// the diff names two files, the measured set holds one.
+	diff := "diff --git a/kept.go b/kept.go\n--- a/kept.go\n+++ b/kept.go\n@@ -1 +1 @@\n-package a\n+package b\n" +
+		"diff --git a/added_by_the_formatter.go b/added_by_the_formatter.go\nnew file mode 100644\n--- /dev/null\n+++ b/added_by_the_formatter.go\n@@ -0,0 +1 @@\n+package a\n"
+	change, err := exactChange(diff, []string{"kept.go"})
+	if err == nil {
+		t.Fatalf("the mismatch was accepted: %#v", change)
+	}
+	if len(change.Files) != 0 {
+		t.Fatalf("a refused reading still returned files, which a caller may report: %#v", change.Files)
+	}
+	// The other direction: a path measured that no diff entry claims.
+	if _, err := exactChange(diff, []string{"kept.go", "added_by_the_formatter.go", "unclaimed.go"}); err == nil {
+		t.Fatal("a measured path no diff entry claims was accepted")
+	}
+	if !strings.Contains(err.Error(), "no report or decision may be built") {
+		t.Fatalf("the refusal does not say what it stops: %v", err)
+	}
+}
+
+// ...and the accepted-candidate path STOPS on that refusal: no change report is
+// emitted and no decision is recorded from pathnames parsed out of diff text.
+func TestAPostValidationMismatchStopsBeforeTheReportAndTheDecision(t *testing.T) {
+	body := funcSource(t, "internal/workflow/engine.go", "runCandidate")
+	i := strings.Index(body, "exactChange(")
+	if i < 0 {
+		t.Fatal("the accepted candidate no longer builds an exact change")
+	}
+	gate := body[i:]
+	j := strings.Index(gate, "emitChangeReport")
+	if j < 0 {
+		t.Fatal("the accepted candidate no longer emits a change report")
+	}
+	gate = gate[:j]
+	if !strings.Contains(gate, "if err != nil") || !strings.Contains(gate, "return false") {
+		t.Fatalf("nothing stops the run between the exact reading and the report it must not produce:\n%s", gate)
+	}
+	if k := strings.Index(body, "recordDecision"); k < i {
+		t.Fatal("the decision is recorded before the exact reading it must depend on")
+	}
+	if strings.Contains(funcSource(t, "internal/workflow/engine.go", "exactChange"), "FromDiff") {
+		t.Fatal("exactChange fell back to the lossy parser again")
+	}
+}
+
+// funcSource is the declaration's own text, for an assertion about the ORDER of
+// statements rather than about which identifiers a function mentions.
+func funcSource(t *testing.T, rel, name string) string {
+	t.Helper()
+	src, err := os.ReadFile("../../" + rel)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fset := token.NewFileSet()
+	f, err := parser.ParseFile(fset, "../../"+rel, src, 0)
+	if err != nil {
+		t.Fatalf("parse %s: %v", rel, err)
+	}
+	for _, d := range f.Decls {
+		fn, ok := d.(*ast.FuncDecl)
+		if !ok || fn.Name.Name != name || fn.Body == nil {
+			continue
+		}
+		return string(src[fset.Position(fn.Body.Pos()).Offset:fset.Position(fn.Body.End()).Offset])
+	}
+	t.Fatalf("function %s not found in %s", name, rel)
+	return ""
+}
