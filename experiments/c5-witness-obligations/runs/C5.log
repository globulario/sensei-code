{"id":"20260830T003519.833179479Z-3e991efa","time":"2026-08-30T00:35:19.833179479Z","session_id":"session-20260830T002012.706816133Z","task_id":"task-1788049212707426532","source":"claude","kind":"output","summary":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01LhyuAd9797BfL6ShR5M8G8\",\"type\":\"tool_result\",\"content\":\"diff --git a/internal/workflow/engine.go b/internal/workflow/engine.go\\nindex 2ba26ec..5ba005d 100644\\n--- a/internal/workflow/engine.go\\n+++ b/internal/workflow/engine.go\\n@@ -7,6 +7,8 @@ import (\\n \\t\\\"fmt\\\"\\n \\t\\\"os\\\"\\n \\t\\\"path/filepath\\\"\\n+\\t\\\"sort\\\"\\n+\\t\\\"strconv\\\"\\n \\t\\\"strings\\\"\\n \\t\\\"sync\\\"\\n \\t\\\"time\\\"\\n@@ -1024,6 +1026,86 @@ func changedPaths(diff string) []string {\\n \\treturn out\\n }\\n \\n+// confineCandidate establishes what the candidate changed, from Git, and holds\\n+// it to the plan.\\n+//\\n+// The two acts are one question, so they happen in one place. gitx.ChangeSet is\\n+// the authority on pathnames; report.FromDiff reads the same change out of a\\n+// text format, and everything downstream reads the renderer's answer -- the\\n+// prospective inspection, the test-edit inspection, the change report, the\\n+// recorded decision. When the two disagree, one of them is wrong about what\\n+// this candidate IS, no consumer downstream is in a position to tell which, and\\n+// the disagreement is not a detail to be reconciled by preferring one: the\\n+// candidate is refused and the disagreement is named.\\n+//\\n+// Confinement then compares Git's paths to the plan's, exactly. See\\n+// confineToPlan.\\n+func (e *Engine) confineCandidate(ctx context.Context, candidate gitx.Repo, base, diff string, planned []string) error {\\n+\\tchanges, err := candidate.ChangeSet(ctx, base)\\n+\\tif err != nil {\\n+\\t\\treturn fmt.Errorf(\\\"establish what the candidate changed: %w\\\", err)\\n+\\t}\\n+\\tif err := reconcileChangeSet(changes, report.FromDiff(diff)); err != nil {\\n+\\t\\treturn err\\n+\\t}\\n+\\treturn confineToPlan(changes.Paths(), planned)\\n+}\\n+\\n+// reconcileChangeSet refuses a candidate its two readings disagree about.\\n+//\\n+// Paths, statuses and rename old paths, all three: a diff that reports a file\\n+// the change set does not is a file nobody authorised appearing in the\\n+// evidence, and a change set holding a file the diff does not is a file the\\n+// reviewer will never see. Either way the candidate is not one thing.\\n+func reconcileChangeSet(authoritative gitx.ChangeSet, rendered report.Change) error {\\n+\\ttype reading struct{ status, oldPath string }\\n+\\tdescribe := func(r reading) string {\\n+\\t\\tif r.oldPath == \\\"\\\" {\\n+\\t\\t\\treturn r.status\\n+\\t\\t}\\n+\\t\\treturn r.status + \\\" from \\\" + strconv.Quote(r.oldPath)\\n+\\t}\\n+\\tbyGit := map[string]reading{}\\n+\\tfor _, f := range authoritative.Files {\\n+\\t\\tbyGit[f.Path] = reading{string(f.Status), f.OldPath}\\n+\\t}\\n+\\tbyDiff := map[string]reading{}\\n+\\tfor _, f := range rendered.Files {\\n+\\t\\tbyDiff[f.Path] = reading{string(f.Status), f.OldPath}\\n+\\t}\\n+\\tvar disagreements []string\\n+\\tfor _, p := range sortedReadingKeys(byGit) {\\n+\\t\\tswitch d, ok := byDiff[p]; {\\n+\\t\\tcase !ok:\\n+\\t\\t\\tdisagreements = append(disagreements, fmt.Sprintf(\\\"%s: Git reports it %s, the diff does not report it at all\\\",\\n+\\t\\t\\t\\tstrconv.Quote(p), describe(byGit[p])))\\n+\\t\\tcase d != byGit[p]:\\n+\\t\\t\\tdisagreements = append(disagreements, fmt.Sprintf(\\\"%s: Git reports %s, the diff reports %s\\\",\\n+\\t\\t\\t\\tstrconv.Quote(p), describe(byGit[p]), describe(d)))\\n+\\t\\t}\\n+\\t}\\n+\\tfor _, p := range sortedReadingKeys(byDiff) {\\n+\\t\\tif _, ok := byGit[p]; !ok {\\n+\\t\\t\\tdisagreements = append(disagreements, fmt.Sprintf(\\\"%s: the diff reports it %s, Git does not report it at all\\\",\\n+\\t\\t\\t\\tstrconv.Quote(p), describe(byDiff[p])))\\n+\\t\\t}\\n+\\t}\\n+\\tif len(disagreements) == 0 {\\n+\\t\\treturn nil\\n+\\t}\\n+\\treturn fmt.Errorf(\\\"Git and the candidate's diff disagree about what this candidate changed, so neither reading may govern it: %s\\\",\\n+\\t\\tstrings.Join(disagreements, \\\"; \\\"))\\n+}\\n+\\n+func sortedReadingKeys[V any](m map[string]V) []string {\\n+\\tout := make([]string, 0, len(m))\\n+\\tfor k := range m {\\n+\\t\\tout = append(out, k)\\n+\\t}\\n+\\tsort.Strings(out)\\n+\\treturn out\\n+}\\n+\\n // proposedPlan is the PlanProposed payload: the decision plus who authored it.\\n //\\n // The source lives on the record and not on architectureDecision itself, so a\\n@@ -1248,6 +1330,16 @@ func (e *Engine) runCandidate(ctx context.Context, sc *sensei.Client, start cert\\n \\t\\t\\t\\t\\\"the plan was read-only and the candidate changed %d file(s): %s\\\",\\n \\t\\t\\t\\tlen(changedPaths(diff)), strings.Join(changedPaths(diff), \\\", \\\"))\\n \\t\\t}\\n+\\t\\t// What this candidate changed, established from Git and held to the\\n+\\t\\t// plan, BEFORE anything else is allowed to read it -- before\\n+\\t\\t// validation, before the prospective inspection, before the test-edit\\n+\\t\\t// inspection, before the audit, before the Level-1 classification,\\n+\\t\\t// before the review. Each of those consumes the candidate as if it were\\n+\\t\\t// in scope; a file outside the plan that reaches any of them has\\n+\\t\\t// already been treated as part of the work.\\n+\\t\\tif err := e.confineCandidate(ctx, candidate, tc.Identity.BaseSHA, diff, tc.Files); err != nil {\\n+\\t\\t\\treturn false, plan, lastReview, lastAudit, err\\n+\\t\\t}\\n \\t\\te.emit(event.New(e.SessionID, taskID, event.SourceGit, event.CandidateChanged, fmt.Sprintf(\\\"candidate diff %d bytes · cycle %d\\\", len(diff), cycle), map[string]int{\\\"cycle\\\": cycle, \\\"review_attempt\\\": e.reviewAttempt(taskID) + 1}))\\n \\n \\t\\t// The missing edge: worker → change → validation → typed evidence →\\n@@ -1263,6 +1355,14 @@ func (e *Engine) runCandidate(ctx context.Context, sc *sensei.Client, start cert\\n \\t\\tif err != nil {\\n \\t\\t\\treturn false, plan, lastReview, lastAudit, err\\n \\t\\t}\\n+\\t\\t// Again, over the re-read. Validation runs formatters, and a formatter\\n+\\t\\t// is a process that edits the worktree: it can widen the candidate onto\\n+\\t\\t// a file the plan never named, and the diff everything downstream reads\\n+\\t\\t// is the one produced AFTER it ran. Binding only before validation would\\n+\\t\\t// confine a candidate that no longer exists.\\n+\\t\\tif err := e.confineCandidate(ctx, candidate, tc.Identity.BaseSHA, diff, tc.Files); err != nil {\\n+\\t\\t\\treturn false, plan, lastReview, lastAudit, err\\n+\\t\\t}\\n \\t\\te.emit(event.New(e.SessionID, taskID, event.SourceSystem, event.ValidationRun, evidence.Render(), evidence))\\n \\n \\t\\t// Post-creation inspection of every declared prospective surface\\n@@ -1504,6 +1604,22 @@ func (e *Engine) runCandidate(ctx context.Context, sc *sensei.Client, start cert\\n \\t\\t\\t\\tfeedback = reviseInstruction(judged)\\n \\t\\t\\t\\tcontinue\\n \\t\\t\\t}\\n+\\t\\t\\t// The review has resolved and Sensei has not refused, so this is\\n+\\t\\t\\t// the terminal completion path. A run that PRODUCED a candidate\\n+\\t\\t\\t// does not reach it while that candidate is only working-tree\\n+\\t\\t\\t// state: completing here reports the candidate ready for governed\\n+\\t\\t\\t// admission, and the branch it names holds none of the work. A run\\n+\\t\\t\\t// that produced no candidate at all never gets here -- the empty\\n+\\t\\t\\t// diff returned or went down the read-only path far above.\\n+\\t\\t\\tuncommitted, err := candidate.ChangeSet(ctx, \\\"HEAD\\\")\\n+\\t\\t\\tif err != nil {\\n+\\t\\t\\t\\treturn false, plan, lastReview, lastAudit, fmt.Errorf(\\\"establish whether the candidate is committed: %w\\\", err)\\n+\\t\\t\\t}\\n+\\t\\t\\tif len(uncommitted.Files) != 0 {\\n+\\t\\t\\t\\treturn false, plan, lastReview, lastAudit, fmt.Errorf(\\n+\\t\\t\\t\\t\\t\\\"the candidate was accepted but is not committed, so the run does not complete: %s left uncommitted in %s\\\",\\n+\\t\\t\\t\\t\\tstrings.Join(quoteAll(uncommitted.Paths()), \\\", \\\"), workspace)\\n+\\t\\t\\t}\\n \\t\\t\\ttc.Report = e.emitChangeReport(ctx, sc, taskID, tc, diff, lastAudit)\\n \\t\\t\\t// The decision is recorded now rather than at approval. At approval\\n \\t\\t\\t// the architect can only name files it intends to create, and a\\ndiff --git a/internal/workflow/testedit.go b/internal/workflow/testedit.go\\nindex c88d106..a4f8a70 100644\\n--- a/internal/workflow/testedit.go\\n+++ b/internal/workflow/testedit.go\\n@@ -22,6 +22,7 @@ import (\\n \\t\\\"fmt\\\"\\n \\t\\\"path\\\"\\n \\t\\\"sort\\\"\\n+\\t\\\"strconv\\\"\\n \\t\\\"strings\\\"\\n \\n \\t\\\"github.com/globulario/sensei-code/internal/report\\\"\\n@@ -396,3 +397,73 @@ func joinGrants(prospective, edits string) string {\\n \\t}\\n \\treturn strings.Join(parts, \\\"\\\\n\\\\n\\\")\\n }\\n+\\n+// confineToPlan refuses a candidate that changed a file the plan does not name.\\n+//\\n+// changed are the paths GIT reported for this candidate -- gitx.ChangeSet.Paths,\\n+// so every side of every change, rename old paths included -- and they are\\n+// compared exactly as Git spelled them. Nothing here trims whitespace, folds\\n+// case, or rewrites separators. \\\" internal/workflow/engine.go\\\" and\\n+// \\\"internal/workflow/engine.go\\\" are two different files, and a candidate that\\n+// touched the first under a plan naming the second is out of plan; trimming\\n+// either side would admit it silently, which is the whole of the hole this\\n+// closes. A path that differs from a planned one only by whitespace is exactly\\n+// the case confinement must see.\\n+//\\n+// The plan's own spelling is canonicalised by path.Clean and by nothing else.\\n+// Clean collapses \\\"./\\\", doubled separators and \\\".\\\" elements -- different\\n+// spellings of one path -- and it never touches whitespace, so it cannot map\\n+// two distinct paths onto one. The candidate's side is not cleaned at all:\\n+// Git's answer is already the pathname, and normalising it would be this\\n+// function editing the evidence it is judging.\\n+//\\n+// It reads no test-edit grant. A grant says HOW a planned file may be edited;\\n+// it never adds a file to the plan, and letting an operational authority widen\\n+// confinement would turn it into scope.\\n+//\\n+// A plan that names no files confines nothing. That is a limitation stated\\n+// rather than hidden: this function refuses paths against a named plan, and it\\n+// is not the place to decide whether a fileless modify plan should exist.\\n+func confineToPlan(changed, planned []string) error {\\n+\\tinPlan := map[string]bool{}\\n+\\tfor _, p := range planned {\\n+\\t\\tif p == \\\"\\\" {\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\tinPlan[path.Clean(p)] = true\\n+\\t}\\n+\\tif len(inPlan) == 0 {\\n+\\t\\treturn nil\\n+\\t}\\n+\\tvar outside []string\\n+\\tseen := map[string]bool{}\\n+\\tfor _, p := range changed {\\n+\\t\\tif p == \\\"\\\" || seen[p] || inPlan[p] {\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\tseen[p] = true\\n+\\t\\toutside = append(outside, p)\\n+\\t}\\n+\\tif len(outside) == 0 {\\n+\\t\\treturn nil\\n+\\t}\\n+\\tsort.Strings(outside)\\n+\\tinside := make([]string, 0, len(inPlan))\\n+\\tfor p := range inPlan {\\n+\\t\\tinside = append(inside, p)\\n+\\t}\\n+\\tsort.Strings(inside)\\n+\\treturn fmt.Errorf(\\\"the candidate changed %d file(s) the plan does not name: %s (the plan names: %s)\\\",\\n+\\t\\tlen(outside), strings.Join(quoteAll(outside), \\\", \\\"), strings.Join(quoteAll(inside), \\\", \\\"))\\n+}\\n+\\n+// quoteAll renders paths so a difference of whitespace is visible in the\\n+// refusal. \\\" engine.go\\\" and \\\"engine.go\\\" are indistinguishable in a bare list,\\n+// and a reader who cannot see the difference cannot act on the refusal.\\n+func quoteAll(paths []string