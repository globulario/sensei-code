+// Status is what Git says happened to one path. The values are spelled exactly
+// as internal/report spells them, because the two accounts of the same
+// candidate are compared and a difference in vocabulary would read as a
+// disagreement about the change itself.
+type Status string
+
+const (
+	Added    Status = "added"
+	Modified Status = "modified"
+	Deleted  Status = "deleted"
+	Renamed  Status = "renamed"
+)
+
+// FileChange is one path the candidate changed, as Git names it.
+type FileChange struct {
+	Path string `json:"path"`
+	// OldPath is the path a renamed file had before the change.
+	OldPath string `json:"old_path,omitempty"`
+	Status  Status `json:"status"`
+}
+
+// ChangeSet is Git's own account of which paths a candidate changed.
+//
+// A unified diff header is a RENDERING. Git quotes any path it will not print
+// raw -- `diff --git "a/caf\303\251.md" "b/caf\303\251.md"` -- and a reader
+// that expects a bare `a/` prefix does not see that file at all. Anything that
+// decides authority from such a reading (what the candidate touched, whether it
+// stayed inside the plan) decides it from a set the quoted path silently left,
+// and a file invisible to confinement is confined by nothing.
+//
+// This is the machine-safe account instead: name-status with NUL terminators,
+// where no pathname is munged, split on a character a filename may contain, or
+// lost, whatever bytes it holds.
+type ChangeSet struct {
+	Files []FileChange `json:"files"`
+}
+
+// Paths returns every path the change set names, BOTH sides of a rename
+// included: a file moved out of a directory is a change to the path it left as
+// well as to the path it arrived at, and a caller confining a candidate must
+// see the departure.
+func (c ChangeSet) Paths() []string {
+	out := make([]string, 0, len(c.Files))
+	for _, f := range c.Files {
+		out = append(out, f.Path)
+		if f.OldPath != "" {
+			out = append(out, f.OldPath)
+		}
+	}
+	return out
+}
+
+// CandidateChanges is the authoritative changed-path set for a candidate,
+// against the base it was cut from.
+//
+// `-z` is the whole point: with it Git does not munge pathnames, so what comes
+// back are the bytes on disk rather than a quoted rendering of them, and the
+// record boundaries are NUL rather than a character a filename may contain.
+//
+// Call it AFTER CandidateCapture, so the set describes the candidate the
+// reviewer will actually see rather than one still holding excluded artifacts.
+func (r Repo) CandidateChanges(ctx context.Context, base string) (ChangeSet, error) {
+	args := []string{noOptionalLocks, "diff", "--no-ext-diff", "--name-status", "-z"}
+	if b := strings.TrimSpace(base); b != "" {
+		args = append(args, b)
+	}
+	out, err := r.raw(ctx, append(args, "--")...)
+	if err != nil {
+		return ChangeSet{}, err
+	}
+	return parseNameStatus(out)
+}
+
+// parseNameStatus reads `--name-status -z` output on NUL boundaries.
+//
+// Each record is a status field followed by one path, or by two paths for a
+// rename. A status letter this does not recognise is an ERROR rather than a
+// guess: the caller refuses a candidate whose changed files it cannot account
+// for, which is the only safe reading of a set that is about to authorise
+// something. Copy detection (C) is off in the diffs this program takes, and an
+// unmerged (U) or broken (B) pairing is not a candidate anyone may judge.
+func parseNameStatus(out string) (ChangeSet, error) {
+	fields := strings.Split(out, "\x00")
+	var cs ChangeSet
+	for i := 0; i < len(fields); {
+		code := fields[i]
+		if code == "" {
+			// The final NUL terminator leaves one empty field behind.
+			i++
+			continue
+		}
+		want := 1
+		if code[0] == 'R' {
+			want = 2
+		}
+		if i+want >= len(fields) {
+			return ChangeSet{}, fmt.Errorf("git diff --name-status -z ended mid-record at status %q", code)
+		}
+		paths := fields[i+1 : i+1+want]
+		for _, p := range paths {
+			if p == "" {
+				return ChangeSet{}, fmt.Errorf("git diff --name-status -z reported status %q with an empty path", code)
+			}
+		}
+		var ch FileChange
+		switch code[0] {
+		case 'A':
+			ch = FileChange{Path: paths[0], Status: Added}
+		case 'D':
+			ch = FileChange{Path: paths[0], Status: Deleted}
+		case 'M', 'T':
+			ch = FileChange{Path: paths[0], Status: Modified}
+		case 'R':
+			ch = FileChange{Path: paths[1], OldPath: paths[0], Status: Renamed}
+		default:
+			return ChangeSet{}, fmt.Errorf("git diff --name-status -z reported status %q, which this reader cannot account for", code)
+		}
+		cs.Files = append(cs.Files, ch)
+		i += 1 + want
+	}
+	// A deterministic order after parsing, so the set reads the same way to
+	// every consumer and a comparison between two of them is about the change
+	// rather than about Git's output order.
+	sort.Slice(cs.Files, func(i, j int) bool {
+		if cs.Files[i].Path != cs.Files[j].Path {
+			return cs.Files[i].Path < cs.Files[j].Path
+		}
+		return cs.Files[i].OldPath < cs.Files[j].OldPath
+	})
+	return cs, nil
+}
