+// The candidate's changed-path set is where confinement, inspection, the
+// audit, the classification, the review and admission all get their idea of
+// what the candidate touched. A path Git quotes was invisible in that set, so
+// a file outside the plan could be changed and no one downstream would know.
+// These tests pin the four shapes that were invisible and the two places the
+// authoritative set is now bound.
+
+func planned(files ...string) []string { return files }
+
+// A modification of a quoted path outside the plan is refused, by name.
+func TestAQuotedOutOfPlanModificationIsRefused(t *testing.T) {
+	changes := gitx.ChangeSet{Files: []gitx.FileChange{
+		{Path: "internal/workflow/engine.go", Status: gitx.Modified},
+		{Path: "docs/café.md", Status: gitx.Modified},
+	}}
+	err := confineToPlan(changes.Paths(), planned("internal/workflow/engine.go"))
+	if err == nil {
+		t.Fatal("a quoted path outside the plan was accepted; confinement cannot see what the plan does not name")
+	}
+	if !strings.Contains(err.Error(), "docs/café.md") {
+		t.Fatalf("the refusal does not name the path it refused: %v", err)
+	}
+}
