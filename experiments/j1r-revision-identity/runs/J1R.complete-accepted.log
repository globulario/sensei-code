ran and found nothing. It is deliberately not\\n575-// the zero value: absence of findings is only evidence when somebody looked.\\n576-func (e EditCheckResult) Clean() bool { return e.Answered \u0026\u0026 len(e.Reported) == 0 }\\n577-\\n578-// Diagnostic says why this result cannot clear an edit.\\n579-func (e EditCheckResult) Diagnostic() string {\\n580-\\tif !e.Answered {\\n581-\\t\\treturn \\\"the edit check did not run, so it proves nothing about this content\\\"\\n582-\\t}\\n583-\\tif len(e.Reported) == 0 {\\n584-\\t\\treturn \\\"the edit check ran and matched no advisory rule\\\"\\n585-\\t}\\n586-\\treturn \\\"the edit check matched: \\\" + strings.Join(e.Reported, \\\"; \\\")\\n587-}\\n588-\\n589-// editCheckTiming are keys that describe the call rather than the content.\\n590-var editCheckTiming = map[string]bool{\\\"generated_in_ms\\\": true, \\\"generated_at\\\": true, \\\"schema_version\\\": true}\\n591-\\n592-// DecodeEditCheck reads an edit-check result, failing closed.\\n593-//\\n594-// A clean result carries only timing, so there is no required field to demand\\n595-// and no way to tell a well-formed empty answer from a malformed one by shape\\n596-// alone. What is demanded instead is that the call did not error: refusal and\\n597-// transport failure arrive as IsError, and those produce an unanswered result\\n598-// rather than a clean one.\\n599-func DecodeEditCheck(r ToolResult) (EditCheckResult, error) {\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}","payload":{"stream":"stdout"}}
