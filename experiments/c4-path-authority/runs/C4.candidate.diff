+// authoritativeChanges is Git's own account of what the candidate changed,
+// having first proved that the diff everything downstream reads agrees with it.
+//
+// report.FromDiff renders a patch for an architect to read. It is not the
+// source of pathname authority and cannot be: a diff header is a rendering in
+// which Git quotes any path it will not print raw, so a file can be present in
+// the candidate and absent from that reading. Where the two accounts disagree
+// -- a path in one and not the other, a different status, a rename whose old
+// side differs -- the candidate is refused rather than judged on whichever
+// account the next consumer happens to consult.
+//
+// The refusal is deliberately not a repair. A disagreement means this program
+// cannot say what the candidate changed, and every decision below it (scope,
+// inspection, audit, classification, review, admission) is made from exactly
+// that set.
+func authoritativeChanges(ctx context.Context, candidate gitx.Repo, base, diff string) (gitx.ChangeSet, error) {
+	changes, err := candidate.CandidateChanges(ctx, base)
+	if err != nil {
+		return gitx.ChangeSet{}, err
+	}
+	if err := reconcileRenderedDiff(changes, diff); err != nil {
+		return gitx.ChangeSet{}, err
+	}
+	return changes, nil
+}
+
+// reconcileRenderedDiff compares the rendered diff against Git's own change
+// set and names every way they differ.
+func reconcileRenderedDiff(changes gitx.ChangeSet, diff string) error {
+	rendered := map[string]report.FileChange{}
+	for _, f := range report.FromDiff(diff).Files {
+		rendered[f.Path] = f
+	}
+	authoritative := map[string]bool{}
+	var disagreements []string
+	for _, f := range changes.Files {
+		authoritative[f.Path] = true
+		r, ok := rendered[f.Path]
+		switch {
+		case !ok:
+			disagreements = append(disagreements, fmt.Sprintf("git reports %q as %s and the rendered diff does not show it at all", f.Path, f.Status))
+		case string(r.Status) != string(f.Status):
+			disagreements = append(disagreements, fmt.Sprintf("git reports %q as %s and the rendered diff reads it as %s", f.Path, f.Status, r.Status))
+		case r.OldPath != f.OldPath:
+			disagreements = append(disagreements, fmt.Sprintf("git reports %q as renamed from %q and the rendered diff reads it as renamed from %q", f.Path, f.OldPath, r.OldPath))
+		}
+	}
+	for p, f := range rendered {
+		if !authoritative[p] {
+			disagreements = append(disagreements, fmt.Sprintf("the rendered diff shows %q as %s and git does not report it as changed", p, f.Status))
+		}
+	}
+	if len(disagreements) == 0 {
+		return nil
+	}
+	sort.Strings(disagreements)
+	return fmt.Errorf("the candidate's changed files cannot be established: %s", strings.Join(disagreements, "; "))
+}
