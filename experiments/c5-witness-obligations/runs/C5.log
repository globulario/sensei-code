3c cs.Files[j].OldPath\\n+\\t})\\n+\\treturn cs, nil\\n+}\\n+\\n+// nameStatus reads one status field. R and C carry a similarity score and two\\n+// paths; everything else carries one.\\n+func nameStatus(field string) (Status, bool, error) {\\n+\\tif field == \\\"\\\" {\\n+\\t\\treturn \\\"\\\", false, fmt.Errorf(\\\"git diff --name-status -z: empty status field\\\")\\n+\\t}\\n+\\tswitch field[0] {\\n+\\tcase 'A':\\n+\\t\\treturn Added, false, nil\\n+\\tcase 'M':\\n+\\t\\treturn Modified, false, nil\\n+\\tcase 'D':\\n+\\t\\treturn Deleted, false, nil\\n+\\tcase 'T':\\n+\\t\\treturn TypeChanged, false, nil\\n+\\tcase 'U':\\n+\\t\\treturn Unmerged, false, nil\\n+\\tcase 'R':\\n+\\t\\treturn Renamed, true, nil\\n+\\tcase 'C':\\n+\\t\\treturn Copied, true, nil\\n+\\t}\\n+\\treturn \\\"\\\", false, fmt.Errorf(\\\"git diff --name-status -z: unrecognised status %q\\\", field)\\n+}\\n+\\n // RevList returns commit ids in a range, newest first, bounded by limit.\\n //\\n // Used only by the counterfactual scanner, which replays history through the\\ndiff --git a/internal/report/report.go b/internal/report/report.go\\nindex 70096af..cce34d4 100644\\n--- a/internal/report/report.go\\n+++ b/internal/report/report.go\\n@@ -86,14 +86,16 @@ func FromDiff(diff string) Change {\\n \\t\\tcase strings.HasPrefix(line, \\\"deleted file mode\\\"):\\n \\t\\t\\tstatus = Deleted\\n \\t\\tcase strings.HasPrefix(line, \\\"rename from \\\"):\\n-\\t\\t\\told = strings.TrimPrefix(line, \\\"rename from \\\")\\n+\\t\\t\\told = unquotePath(strings.TrimPrefix(line, \\\"rename from \\\"))\\n \\t\\t\\tstatus = Renamed\\n \\t\\tcase strings.HasPrefix(line, \\\"rename to \\\"):\\n \\t\\t\\t// The rename lines carry both paths whole, however many spaces\\n \\t\\t\\t// they hold; they outrank the header's guess.\\n-\\t\\t\\tcurrent = strings.TrimPrefix(line, \\\"rename to \\\")\\n-\\t\\tcase strings.HasPrefix(line, \\\"+++ b/\\\") \u0026\u0026 current == \\\"\\\":\\n-\\t\\t\\tcurrent = strings.TrimSuffix(strings.TrimPrefix(line, \\\"+++ b/\\\"), \\\"\\\\t\\\")\\n+\\t\\t\\tcurrent = unquotePath(strings.TrimPrefix(line, \\\"rename to \\\"))\\n+\\t\\tcase strings.HasPrefix(line, \\\"+++ \\\") \u0026\u0026 current == \\\"\\\":\\n+\\t\\t\\t// Git appends a TAB to this line when the name contains a space,\\n+\\t\\t\\t// so the tab is stripped before the path is read.\\n+\\t\\t\\tcurrent = sidePath(strings.TrimSuffix(strings.TrimPrefix(line, \\\"+++ \\\"), \\\"\\\\t\\\"), \\\"b/\\\")\\n \\t\\tcase strings.HasPrefix(line, \\\"+\\\") \u0026\u0026 !strings.HasPrefix(line, \\\"+++\\\"):\\n \\t\\t\\tif kind := awarenessKind(current); kind != \\\"\\\" \u0026\u0026 isEntryStart(line) {\\n \\t\\t\\t\\tchange.Awareness[kind]++\\n@@ -115,6 +117,28 @@ func FromDiff(diff string) Change {\\n // \\\"\\\" here and is completed by the `rename to` line that follows it.\\n func diffPath(line string) string {\\n \\trest := strings.TrimPrefix(line, \\\"diff --git \\\")\\n+\\t// Git quotes a header side whenever the pathname holds a control character\\n+\\t// or a byte over 0x7f, and it quotes each side independently -- so an\\n+\\t// unrenamed file arrives with both sides quoted, and the shape argument\\n+\\t// above still decides it, once the C-style escapes are undone. A quoted\\n+\\t// path that never reached FromDiff read as untouched, which is how a\\n+\\t// candidate that changed it was reported as having changed nothing.\\n+\\tif strings.HasPrefix(rest, `\\\"`) {\\n+\\t\\tleft, after, ok := scanQuoted(rest)\\n+\\t\\tif !ok || !strings.HasPrefix(after, ` \\\"`) {\\n+\\t\\t\\treturn \\\"\\\"\\n+\\t\\t}\\n+\\t\\tright, tail, ok := scanQuoted(after[1:])\\n+\\t\\tif !ok || tail != \\\"\\\" {\\n+\\t\\t\\treturn \\\"\\\"\\n+\\t\\t}\\n+\\t\\ta, aok := strings.CutPrefix(left, \\\"a/\\\")\\n+\\t\\tb, bok := strings.CutPrefix(right, \\\"b/\\\")\\n+\\t\\tif !aok || !bok || a != b {\\n+\\t\\t\\treturn \\\"\\\"\\n+\\t\\t}\\n+\\t\\treturn b\\n+\\t}\\n \\tif !strings.HasPrefix(rest, \\\"a/\\\") {\\n \\t\\treturn \\\"\\\"\\n \\t}\\n@@ -130,6 +154,114 @@ func diffPath(line string) string {\\n \\treturn \\\"\\\"\\n }\\n \\n+// sidePath reads a `--- a/P` or `+++ b/P` operand, quoted or not. It returns \\\"\\\"\\n+// for anything that is not a path on that side, which is how /dev/null is\\n+// declined.\\n+func sidePath(operand, prefix string) string {\\n+\\tif strings.HasPrefix(operand, `\\\"`) {\\n+\\t\\tvalue, tail, ok := scanQuoted(operand)\\n+\\t\\tif !ok || tail != \\\"\\\" {\\n+\\t\\t\\treturn \\\"\\\"\\n+\\t\\t}\\n+\\t\\toperand = value\\n+\\t}\\n+\\tp, ok := strings.CutPrefix(operand, prefix)\\n+\\tif !ok {\\n+\\t\\treturn \\\"\\\"\\n+\\t}\\n+\\treturn p\\n+}\\n+\\n+// unquotePath undoes Git's quoting of a whole line operand that carries one\\n+// pathname, such as `rename from`. An operand Git did not quote is its own\\n+// pathname and is returned untouched.\\n+func unquotePath(operand string) string {\\n+\\tif value, tail, ok := scanQuoted(operand); ok \u0026\u0026 tail == \\\"\\\" {\\n+\\t\\treturn value\\n+\\t}\\n+\\treturn operand\\n+}\\n+\\n+// scanQuoted reads one C-quoted string from the front of s and returns its\\n+// value, the rest of s, and whether s began with a well-formed one.\\n+func scanQuoted(s string) (value, rest string, ok bool) {\\n+\\tif !strings.HasPrefix(s, `\\\"`) {\\n+\\t\\treturn \\\"\\\", s, false\\n+\\t}\\n+\\tfor i := 1; i \u003c len(s); i++ {\\n+\\t\\tswitch s[i] {\\n+\\t\\tcase '\\\\\\\\':\\n+\\t\\t\\t// Skip the escaped byte so an escaped quote does not end the string.\\n+\\t\\t\\ti++\\n+\\t\\tcase '\\\"':\\n+\\t\\t\\tv, ok := unquoteC(s[1:i])\\n+\\t\\t\\tif !ok {\\n+\\t\\t\\t\\treturn \\\"\\\", s, false\\n+\\t\\t\\t}\\n+\\t\\t\\treturn v, s[i+1:], true\\n+\\t\\t}\\n+\\t}\\n+\\treturn \\\"\\\", s, false\\n+}\\n+\\n+// unquoteC undoes the escaping Git applies inside a quoted pathname: the\\n+// C escapes it names, and a three-digit octal escape for every other byte.\\n+//\\n+// It works in bytes, not runes. A non-ASCII path arrives here as octal escapes\\n+// of its UTF-8 bytes, and reassembling them as runes would corrupt any pathname\\n+// that is not valid UTF-8 -- which a pathname is under no obligation to be.\\n+func unquoteC(s string) (string, bool) {\\n+\\tvar b strings.Builder\\n+\\tfor i := 0; i \u003c len(s); i++ {\\n+\\t\\tif s[i] != '\\\\\\\\' {\\n+\\t\\t\\tb.WriteByte(s[i])\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\ti++\\n+\\t\\tif i \u003e= len(s) {\\n+\\t\\t\\treturn \\\"\\\", false\\n+\\t\\t}\\n+\\t\\tswitch s[i] {\\n+\\t\\tcase 'a':\\n+\\t\\t\\tb.WriteByte(0x07)\\n+\\t\\tcase 'b':\\n+\\t\\t\\tb.WriteByte(0x08)\\n+\\t\\tcase 't':\\n+\\t\\t\\tb.WriteByte('\\\\t')\\n+\\t\\tcase 'n':\\n+\\t\\t\\tb.WriteByte('\\\\n')\\n+\\t\\tcase 'v':\\n+\\t\\t\\tb.WriteByte(0x0b)\\n+\\t\\tcase 'f':\\n+\\t\\t\\tb.WriteByte(0x0c)\\n+\\t\\tcase 'r':\\n+\\t\\t\\tb.WriteByte('\\\\r')\\n+\\t\\tcase '\\\"':\\n+\\t\\t\\tb.WriteByte('\\\"')\\n+\\t\\tcase '\\\\\\\\':\\n+\\t\\t\\tb.WriteByte('\\\\\\\\')\\n+\\t\\tdefault:\\n+\\t\\t\\tif i+2 \u003e= len(s) {\\n+\\t\\t\\t\\treturn \\\"\\\", false\\n+\\t\\t\\t}\\n+\\t\\t\\tv := 0\\n+\\t\\t\\tfor k := 0; k \u003c 3; k++ {\\n+\\t\\t\\t\\td := s[i+k]\\n+\\t\\t\\t\\tif d \u003c '0' || d \u003e '7' {\\n+\\t\\t\\t\\t\\treturn \\\"\\\", false\\n+\\t\\t\\t\\t}\\n+\\t\\t\\t\\tv = v*8 + int(d-'0')\\n+\\t\\t\\t}\\n+\\t\\t\\tif v \u003e 0xff {\\n+\\t\\t\\t\\treturn \\\"\\\", false\\n+\\t\\t\\t}\\n+\\t\\t\\tb.WriteByte(byte(v))\\n+\\t\\t\\ti += 2\\n+\\t\\t}\\n+\\t}\\n+\\treturn b.String(), true\\n+}\\n+\\n func awarenessKind(file string) string {\\n \\tif !strings.Contains(file, \\\"docs/awareness/\\\") {\\n \\t\\treturn \\\"\\\"\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}","payload":{"stream":"stdout"}}
