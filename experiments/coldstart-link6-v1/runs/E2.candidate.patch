+// tryAcquireLocked reports whether a request of weight n may proceed
+// immediately, and records the acquisition if so. It must be called with
+// s.mu held. A request proceeds only if enough capacity is available and no
+// waiters are queued, so that queued waiters are never starved.
+func (s *Weighted) tryAcquireLocked(n int64) bool {
+	if s.size-s.cur < n || s.waiters.Len() != 0 {
+		return false
+	}
+	s.cur += n
+	return true
+}
