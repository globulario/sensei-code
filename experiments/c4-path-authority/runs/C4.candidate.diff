+// Where the rendered diff and Git disagree, this program cannot say what the
+// candidate changed -- and every decision below is made from exactly that set.
+// It refuses rather than picking whichever account the next consumer reads.
+func TestADisagreementWithGitRefusesTheCandidate(t *testing.T) {
+	authoritative := gitx.ChangeSet{Files: []gitx.FileChange{
+		{Path: "internal/x.go", Status: gitx.Modified},
+		{Path: "docs/café.md", Status: gitx.Modified},
+	}}
+	// What a renderer that cannot read a quoted header produces: the ASCII
+	// file only, with the quoted one silently absent.
+	dropped := "diff --git a/internal/x.go b/internal/x.go\nindex 1..2 100644\n--- a/internal/x.go\n+++ b/internal/x.go\n@@ -1 +1 @@\n-x\n+y\n"
+	err := reconcileRenderedDiff(authoritative, dropped)
+	if err == nil {
+		t.Fatal("a rendered diff missing a file git reports was accepted as an account of the candidate")
+	}
+	if !strings.Contains(err.Error(), "docs/café.md") || !strings.Contains(err.Error(), "does not show it") {
+		t.Fatalf("the refusal does not name the disagreement: %v", err)
+	}
+
+	for _, tc := range []struct {
+		name     string
+		changes  gitx.ChangeSet
+		diff     string
+		disagree string
+	}{
+		{
+			name:    "a status the two accounts read differently",
+			changes: gitx.ChangeSet{Files: []gitx.FileChange{{Path: "internal/x.go", Status: gitx.Deleted}}},
+			diff: "diff --git a/internal/x.go b/internal/x.go\nnew file mode 100644\n--- /dev/null\n" +
+				"+++ b/internal/x.go\n@@ -0,0 +1 @@\n+x\n",
+			disagree: "reads it as added",
+		},
+		{
+			name:    "a rename whose old side differs",
+			changes: gitx.ChangeSet{Files: []gitx.FileChange{{Path: "internal/x.go", OldPath: "internal/was.go", Status: gitx.Renamed}}},
+			diff: "diff --git a/internal/other.go b/internal/x.go\nsimilarity index 100%\n" +
+				"rename from internal/other.go\nrename to internal/x.go\n",
+			disagree: "renamed from",
+		},
+		{
+			name:     "a file the rendered diff shows and git does not report",
+			changes:  gitx.ChangeSet{},
+			diff:     "diff --git a/internal/x.go b/internal/x.go\nindex 1..2 100644\n@@ -1 +1 @@\n-x\n+y\n",
+			disagree: "git does not report it as changed",
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := reconcileRenderedDiff(tc.changes, tc.diff)
+			if err == nil {
+				t.Fatal("the candidate was accepted with its changed files unestablished")
+			}
+			if !strings.Contains(err.Error(), tc.disagree) {
+				t.Fatalf("the refusal does not name the disagreement %q: %v", tc.disagree, err)
+			}
+		})
+	}
