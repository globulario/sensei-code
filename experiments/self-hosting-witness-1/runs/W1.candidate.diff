+	d := classifyRoutine(scoped, []string{"internal/tui/new_file.go"}, nil, cleanEditCheck(), planned, modifying(planned...))
+	if d.Routine {
+		t.Fatalf("a plan holding a file the graph never examined must not be routine")
+	}
+	if !strings.Contains(d.Blocking, "never examined") || !strings.Contains(d.Blocking, "internal/tui/new_file.go") {
+		t.Fatalf("blocked by %q, want the unexamined file named", d.Blocking)
+	}
+
+	if d := classifyRoutine(scoped, nil, nil, cleanEditCheck(), planned, modifying(planned...)); !d.Routine {
+		t.Fatalf("with no unexamined file the same preflight should classify as before; blocked by %q", d.Blocking)
