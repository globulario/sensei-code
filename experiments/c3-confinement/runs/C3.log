te that will actually reach judgement. The\\n+\\t\\t// diff checked above is not the diff anyone downstream reads:\\n+\\t\\t// validation's formatters may have rewritten the worktree, and a\\n+\\t\\t// formatter reaching a file the plan never named would otherwise\\n+\\t\\t// arrive at the audit, the classification and the review as part of\\n+\\t\\t// the candidate, already past the only place scope was checked.\\n+\\t\\tif err := confineToPlan(diff, tc.Files); err != nil {\\n+\\t\\t\\treturn false, plan, lastReview, lastAudit, err\\n+\\t\\t}\\n \\t\\te.emit(event.New(e.SessionID, taskID, event.SourceSystem, event.ValidationRun, evidence.Render(), evidence))\\n \\n \\t\\t// Post-creation inspection of every declared prospective surface\\ndiff --git a/internal/workflow/testedit.go b/internal/workflow/testedit.go\\nindex c88d106..47d568f 100644\\n--- a/internal/workflow/testedit.go\\n+++ b/internal/workflow/testedit.go\\n@@ -396,3 +396,63 @@ func joinGrants(prospective, edits string) string {\\n \\t}\\n \\treturn strings.Join(parts, \\\"\\\\n\\\\n\\\")\\n }\\n+\\n+// confineToPlan refuses a candidate that changed a file the plan does not\\n+// name.\\n+//\\n+// The bound is the plan's named files and nothing else. It is deliberately\\n+// NOT given the test-edit grants: a grant is operational authority to edit a\\n+// file the plan already names, and handing one to this check would let a\\n+// grant enlarge the set the plan bounds.\\n+//\\n+// Every path the diff carries counts, whatever its status. A deletion outside\\n+// the plan removes something the plan did not authorise removing, and a\\n+// rename is two paths -- reading only the surviving one would let a candidate\\n+// move a file out of the plan's set unremarked.\\n+func confineToPlan(diff string, planned []string) error {\\n+\\t// Canonicalised exactly as architecturalFiles does, because the plan's\\n+\\t// spelling is whatever the architect wrote (\\\"./internal/x.go\\\" included)\\n+\\t// and Git's is always clean: compared raw, a named file would read as an\\n+\\t// unnamed one and a confined candidate would be refused.\\n+\\tnamed := map[string]bool{}\\n+\\tvar names []string\\n+\\tfor _, f := range planned {\\n+\\t\\tif strings.TrimSpace(f) == \\\"\\\" {\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\tc := path.Clean(strings.TrimSpace(f))\\n+\\t\\tif named[c] {\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\tnamed[c] = true\\n+\\t\\tnames = append(names, c)\\n+\\t}\\n+\\tvar outside []string\\n+\\tseen := map[string]bool{}\\n+\\tfor _, f := range report.FromDiff(diff).Files {\\n+\\t\\tfor _, p := range []string{f.Path, f.OldPath} {\\n+\\t\\t\\tif strings.TrimSpace(p) == \\\"\\\" {\\n+\\t\\t\\t\\tcontinue\\n+\\t\\t\\t}\\n+\\t\\t\\tc := path.Clean(strings.TrimSpace(p))\\n+\\t\\t\\tif named[c] || seen[c] {\\n+\\t\\t\\t\\tcontinue\\n+\\t\\t\\t}\\n+\\t\\t\\tseen[c] = true\\n+\\t\\t\\toutside = append(outside, c)\\n+\\t\\t}\\n+\\t}\\n+\\tif len(outside) == 0 {\\n+\\t\\treturn nil\\n+\\t}\\n+\\tsort.Strings(outside)\\n+\\treturn fmt.Errorf(\\\"the candidate changed %d file(s) the plan does not name: %s; the plan names: %s\\\",\\n+\\t\\tlen(outside), strings.Join(outside, \\\", \\\"), plannedOrNone(names))\\n+}\\n+\\n+func plannedOrNone(files []string) string {\\n+\\tif len(files) == 0 {\\n+\\t\\treturn \\\"(no files)\\\"\\n+\\t}\\n+\\treturn strings.Join(files, \\\", \\\")\\n+}\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"ce908977-0f54-4f48-af44-0b16fb55e88c\",\"uuid\":\"a9b8a3e9-2b54-4a78-9e0c-4f29edb1ae24\",\"timestamp\":\"2026-08-29T13:55:27.141Z\",\"tool_use_result\":{\"stdout\":\"diff --git a/internal/workflow/engine.go b/internal/workflow/engine.go\\nindex 2ba26ec..098cdaa 100644\\n--- a/internal/workflow/engine.go\\n+++ b/internal/workflow/engine.go\\n@@ -1248,6 +1248,15 @@ func (e *Engine) runCandidate(ctx context.Context, sc *sensei.Client, start cert\\n \\t\\t\\t\\t\\\"the plan was read-only and the candidate changed %d file(s): %s\\\",\\n \\t\\t\\