+
+// modifiedDiff, addedDiff and deletedDiff build the unified diff Git writes
+// for one file, so a scope test states its candidate in exactly the text the
+// repository's one diff parser reads.
+func modifiedDiff(p string) string {
+	return fmt.Sprintf("diff --git a/%s b/%s\nindex 1111111..2222222 100644\n--- a/%s\n+++ b/%s\n@@ -1,1 +1,2 @@\n line\n+added line\n", p, p, p, p)
+}
+
+func addedDiff(p string) string {
+	return fmt.Sprintf("diff --git a/%s b/%s\nnew file mode 100644\nindex 0000000..2222222\n--- /dev/null\n+++ b/%s\n@@ -0,0 +1 @@\n+added line\n", p, p, p)
+}
+
+func renamedDiff(from, to string) string {
+	return fmt.Sprintf("diff --git a/%s b/%s\nsimilarity index 96%%\nrename from %s\nrename to %s\n", from, to, from, to)
+}
+
+func deletedDiff(p string) string {
+	return fmt.Sprintf("diff --git a/%s b/%s\ndeleted file mode 100644\nindex 1111111..0000000\n--- a/%s\n+++ /dev/null\n@@ -1 +0,0 @@\n-line\n", p, p, p)
+}
+
+// A candidate is confined to the files its plan names. Everything downstream
+// -- the audit, the classification, the review, the admission -- is about the
+// plan that was routed and authorized, so a candidate that reached past it is
+// judged on a question nobody asked. It is refused before the review, with
+// every path outside the plan named.
+func TestCandidateWiderThanPlanIsRefusedBeforeReview(t *testing.T) {
+	// The plan's own spelling, "./" and all, is the spelling the architect
+	// wrote; the diff's is always clean.
+	planned := []string{"internal/workflow/engine.go", "./internal/workflow/testedit.go"}
+
+	wider := modifiedDiff("internal/workflow/engine.go") + modifiedDiff("internal/tui/model.go")
+	err := confineToPlan(wider, planned)
+	if err == nil {
+		t.Fatal("a candidate that changed a file the plan does not name was accepted")
+	}
+	if !strings.Contains(err.Error(), "internal/tui/model.go") {
+		t.Fatalf("the refusal does not name the path outside the plan: %v", err)
+	}
+	if !strings.Contains(err.Error(), "internal/workflow/engine.go") {
+		t.Fatalf("the refusal does not state what the plan named: %v", err)
+	}
+
+	inside := modifiedDiff("internal/workflow/engine.go") + addedDiff("internal/workflow/testedit.go")
+	if err := confineToPlan(inside, planned); err != nil {
+		t.Fatalf("a candidate inside its plan was refused: %v", err)
+	}
+
+	// A deletion is a change to a file the plan did not authorise removing,
+	// and it is the one status a surviving-paths list cannot express.
+	outsideDeletion := modifiedDiff("internal/workflow/engine.go") + deletedDiff("internal/workflow/routine.go")
+	err = confineToPlan(outsideDeletion, planned)
+	if err == nil {
+		t.Fatal("a candidate that deleted a file outside its plan was accepted")
+	}
+	if !strings.Contains(err.Error(), "internal/workflow/routine.go") {
+		t.Fatalf("the refusal does not name the deleted path: %v", err)
+	}
+
+	// The first check sits before the candidate is announced as changed, so a
+	// candidate nobody may judge is never published as one.
+	body := funcBody(t, "internal/workflow/engine.go", "runCandidate")
+	check := strings.Index(body, "confineToPlan ")
+	changed := strings.Index(body, "event.CandidateChanged(")
+	if check < 0 || changed < 0 {
+		t.Fatal("runCandidate no longer confines the candidate or no longer announces it")
+	}
+	if check > changed {
+		t.Fatal("the candidate is announced as changed before its scope is checked")
+	}
+}
+
+// Validation's formatters rewrite the worktree, and the diff is re-read
+// afterwards precisely because what the worker wrote is not what the reviewer
+// sees. The confinement is therefore re-bound to the re-read diff: otherwise
+// a formatter touching a file the plan never named would arrive at the audit
+// and the review already past the only place scope was checked.
+func TestAFormatterCannotWidenTheCandidateAfterValidation(t *testing.T) {
+	planned := []string{"internal/workflow/engine.go"}
+
+	asWritten := modifiedDiff("internal/workflow/engine.go")
+	if err := confineToPlan(asWritten, planned); err != nil {
+		t.Fatalf("the candidate was inside its plan when written: %v", err)
+	}
+	afterValidation := asWritten + modifiedDiff("internal/tui/model.go")
+	err := confineToPlan(afterValidation, planned)
+	if err == nil {
+		t.Fatal("a candidate widened by validation was accepted")
+	}
+	if !strings.Contains(err.Error(), "internal/tui/model.go") {
+		t.Fatalf("the refusal does not name what validation added: %v", err)
+	}
+
+	body := funcBody(t, "internal/workflow/engine.go", "runCandidate")
+	validate := strings.Index(body, "e.validate(")
+	if validate < 0 {
+		t.Fatal("runCandidate no longer validates the candidate")
+	}
+	// Everything below is read after validation returns, so the read-only
+	// branch's own review earlier in the function is not mistaken for this
+	// candidate's.
+	after := body[validate:]
+	rebound := strings.Index(after, "confineToPlan ")
+	if rebound < 0 {
+		t.Fatal("the confinement is never re-checked against the diff validation re-read")
+	}
+	// Nothing that judges the candidate may run before the re-bound check.
+	for name, at := range map[string]int{
+		"the prospective inspection": strings.Index(after, "inspectProspectiveSurfaces "),
+		"the test-edit inspection":   strings.Index(after, "inspectTestEdits "),
+		"the Sensei audit":           strings.Index(after, "sc.CallTool("),
+		"the review":                 strings.Index(after, "e.resolveReview("),
+	} {
+		if at >= 0 && at < rebound {
+			t.Fatalf("%s reads the candidate before its scope is re-checked", name)
+		}
+	}
+}
+
+// An existing-test edit grant is operational authority to edit a file the
+// plan ALREADY names. If the confinement could see grants, a grant would
+// enlarge the set the plan bounds -- so the check is not given them, and a
+// test file that would otherwise be grantable is refused when the plan does
+// not name it.
+func TestOperationalTestGrantDoesNotExpandPlanScope(t *testing.T) {
+	sig := reflect.TypeOf(confineToPlan)
+	if sig.NumIn() != 2 || sig.In(0).Kind() != reflect.String || sig.In(1) != reflect.TypeOf([]string(nil)) {
+		t.Fatalf("the confinement takes something other than the diff and the plan's files: %v", sig)
+	}
+
+	planned := []string{"internal/workflow/testedit.go"}
+	grant := testEditGrant{
+		Path:     "internal/workflow/testedit_test.go",
+		Covering: "internal/workflow/testedit.go",
+		World:    "w",
+		Facts:    testEditFacts{Package: "workflow", Imports: map[string]bool{}},
+	}
+	diff := modifiedDiff(grant.Covering) + modifiedDiff(grant.Path)
+
+	// The grant's own inspection is satisfied -- this is exactly the edit it
+	// authorizes -- and the plan still does not name the file.
+	if err := inspectTestEdits(diff, []testEditGrant{grant}, func(string) ([]byte, error) {
+		return []byte("package workflow\n"), nil
+	}); err != nil {
+		t.Fatalf("the grant's own inspection refused its own edit: %v", err)
+	}
+	err := confineToPlan(diff, planned)
+	if err == nil {
+		t.Fatal("a grant enlarged the set the plan bounds")
+	}
+	if !strings.Contains(err.Error(), grant.Path) {
+		t.Fatalf("the refusal does not name the granted file the plan omits: %v", err)
+	}
+}
+
+// A supplied plan is a bound the human handed in, identified by the digest of
+// its exact bytes. A candidate wider than it is refused like any other, and
+// the plan it was checked against is not touched: a bound that the work it
+// bounds could edit is not a bound.
+func TestASuppliedPlanIsNotWidenedByTheCandidate(t *testing.T) {
+	p, err := ParseSuppliedPlan([]byte(goodPlan))
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := p.Digest
+	files := append([]string(nil), p.decision.Files...)
+
+	diff := modifiedDiff("gosumcheck/main_test.go") + addedDiff("gosumcheck/extra.go")
+	err = confineToPlan(diff, p.decision.Files)
+	if err == nil {
+		t.Fatal("a candidate wider than the supplied plan was accepted")
+	}
+	if !strings.Contains(err.Error(), "gosumcheck/extra.go") {
+		t.Fatalf("the refusal does not name the path the supplied plan omits: %v", err)
+	}
+	if p.Digest != digest || !reflect.DeepEqual(p.decision.Files, files) {
+		t.Fatalf("the supplied plan changed while confining the candidate: %s/%v", p.Digest, p.decision.Files)
+	}
+}
