_test.go\\n+++ b/internal/workflow/engine_test.go\\n@@ -1321,3 +1321,149 @@ func TestAReadOnlyWorkerIsToldToReconcileItsOwnFindings(t *testing.T) {\\n \\t\\t}\\n \\t}\\n }\\n+\\n+// unifiedModify, unifiedDelete and unifiedRename build the diff shapes the\\n+// confinement check reads, in the exact spelling Git writes.\\n+func unifiedModify(path string) string {\\n+\\treturn \\\"diff --git a/\\\" + path + \\\" b/\\\" + path + \\\"\\\\nindex 1111111..2222222 100644\\\\n--- a/\\\" + path + \\\"\\\\n+++ b/\\\" + path + \\\"\\\\n@@ -1 +1 @@\\\\n-before\\\\n+after\\\\n\\\"\\n+}\\n+\\n+func unifiedDelete(path string) string {\\n+\\treturn \\\"diff --git a/\\\" + path + \\\" b/\\\" + path + \\\"\\\\ndeleted file mode 100644\\\\nindex 1111111..0000000\\\\n--- a/\\\" + path + \\\"\\\\n+++ /dev/null\\\\n@@ -1 +0,0 @@\\\\n-gone\\\\n\\\"\\n+}\\n+\\n+func unifiedRename(from, to string) string {\\n+\\treturn \\\"diff --git a/\\\" + from + \\\" b/\\\" + to + \\\"\\\\nsimilarity index 100%\\\\nrename from \\\" + from + \\\"\\\\nrename to \\\" + to + \\\"\\\\n\\\"\\n+}\\n+\\n+// A candidate is confined to the files its plan names.\\n+//\\n+// The plan's file list bounded what the worker was ASKED to change, and after\\n+// the worker ran nothing read it again: a candidate that also edited a file\\n+// outside the plan reached validation, the audit, the classification, the\\n+// reviewer and admission as though the plan had named it. The reviewer might\\n+// notice; noticing is not a boundary.\\n+func TestCandidateWiderThanPlanIsRefusedBeforeReview(t *testing.T) {\\n+\\tplanned := []string{\\\"internal/workflow/engine.go\\\", \\\"./internal/workflow/testedit.go\\\"}\\n+\\n+\\t// One path outside the plan refuses the candidate, and the refusal names\\n+\\t// both that path and what the plan actually authorised.\\n+\\terr := confineToPlannedFiles(unifiedModify(\\\"internal/workflow/engine.go\\\")+unifiedModify(\\\"internal/broker/guard.go\\\"), planned)\\n+\\tif err == nil {\\n+\\t\\tt.