+
+// quotedPrefix returns the C-quoted token at the head of s, and what follows
+// it. The closing quote is the first unescaped one.
+func quotedPrefix(s string) (token, rest string, ok bool) {
+	for i := 1; i < len(s); i++ {
+		switch s[i] {
+		case '\\':
+			i++
+		case '"':
+			return s[:i+1], s[i+1:], true
+		}
+	}
+	return "", "", false
