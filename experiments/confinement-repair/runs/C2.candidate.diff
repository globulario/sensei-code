+// A supplied plan is a bound authored outside the run, byte for byte. The
+// candidate is judged against it and never edits it: refusing a wider
+// candidate must leave the supplied plan's identity and file list exactly as
+// they were handed in.
+func TestASuppliedPlanIsNotWidenedByTheCandidate(t *testing.T) {
+	tc := testContext()
+	tc.PlanSource = PlanSupplied
+	tc.PlanDigest = "3a5f1c0e2b7d4a9f8c6b5e4d3c2b1a09f8e7d6c5b4a39281706f5e4d3c2b1a09"
+	tc.Files = []string{"cmd/sensei-code/main.go", "internal/workflow/gate.go"}
+	digest := tc.PlanDigest
+	files := strings.Join(tc.Files, "\x00")
+
+	err := confineToPlannedFiles(unifiedModify("cmd/sensei-code/main.go")+unifiedModify("internal/authority/router.go"), tc.Files)
+	if err == nil || !strings.Contains(err.Error(), "internal/authority/router.go") {
+		t.Fatalf("a candidate wider than the supplied plan was accepted: %v", err)
+	}
+	if tc.PlanDigest != digest {
+		t.Fatalf("the supplied plan's digest changed: %q -> %q", digest, tc.PlanDigest)
+	}
+	if got := strings.Join(tc.Files, "\x00"); got != files {
+		t.Fatalf("the supplied plan's files changed: %q -> %q", files, got)
+	}
+	if tc.PlanSource != PlanSupplied {
+		t.Fatalf("the plan stopped being supplied: %q", tc.PlanSource)
+	}
+}
