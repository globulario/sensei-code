+// confineToPlan refuses a candidate that changed a file the plan does not name.
+//
+// changed are the paths from the authoritative Git change set, both sides of a
+// rename included. A rename is two facts about scope: the file arrived at one
+// path and LEFT another, and a confinement that reads only the arrival lets a
+// candidate move a file out of the plan's scope unnoticed.
+//
+// It takes no grant of any kind. A test-edit grant is operational authority to
+// edit a file the plan ALREADY names -- matchTestEditGrants refuses any grant
+// naming a file the plan does not -- so reading grants here could only ever
+// re-authorise a path the plan already holds, while making the scope look as
+// though it came from somewhere other than the plan. Scope is the architect's
+// to state and this function's only job is to hold the candidate to it.
+//
+// A plan that names no file confines nothing. The empty set is not a refusal
+// of everything: the architect may bound a task without listing paths (see
+// renderScope), and turning silence into a universal refusal would decide the
+// plan's scope here rather than read it.
+func confineToPlan(changed, planned []string) error {
+	if len(planned) == 0 {
+		return nil
+	}
+	// Canonicalised exactly as architecturalFiles does, so "./internal/x.go",
+	// "internal//x.go" and "internal/x.go" are one path in both the plan and
+	// the candidate rather than three.
+	allowed := map[string]bool{}
+	for _, f := range planned {
+		allowed[path.Clean(strings.TrimSpace(f))] = true
+	}
+	var outside []string
+	seen := map[string]bool{}
+	for _, c := range changed {
+		p := path.Clean(strings.TrimSpace(c))
+		if p == "" || p == "." || allowed[p] || seen[p] {
+			continue
+		}
+		seen[p] = true
+		outside = append(outside, p)
+	}
+	if len(outside) == 0 {
+		return nil
+	}
+	sort.Strings(outside)
+	return fmt.Errorf("the candidate changed %d file(s) the plan does not name: %s", len(outside), strings.Join(outside, ", "))
+}
