 same way (#89).\\n3811-\\t\\t\\tstate.OpenFindings(openFindings(review, audit, err))\\n3812-\\t\\t\\t_ = state.Save(e.Repo.Root)\\n3813-\\t\\t\\tfail(err)\\n3814-\\t\\t\\treturn\\n3815-\\t\\t}\\n3816-\\t\\tif err != nil {\\n3817-\\t\\t\\t// A prospective grant authorizes one exact creation shape. Once its\\n3818-\\t\\t\\t// post-creation inspection refutes that shape, the run is terminal:\\n3819-\\t\\t\\t// a later implementor has no authority to reinterpret or retry it.\\n3820-\\t\\t\\t// All other candidate failures retain the ordinary handoff path.\\n3821-\\t\\t\\tif isProspectiveSurfaceRefutation(err) {\\n3822-\\t\\t\\t\\tfail(err)\\n3823-\\t\\t\\t\\treturn\\n3824-\\t\\t\\t}\\n3825-\\t\\t\\tfailures = append(failures, worker.Name+\\\": \\\"+err.Error())\\n3826-\\t\\t\\t// The candidate stays: it holds real work, and the reviewer's\\n3827-\\t\\t\\t// unresolved findings travel with it to whoever picks it up next.\\n3828-\\t\\t\\tstate.Phase = taskstate.Revising\\n3829-\\t\\t\\tstate.Evidence = tc.EvidenceSnapshot\\n3830-\\t\\t\\tstate.OpenFindings(openFindings(review, audit, err))\\n3831-\\t\\t\\t_ = state.Save(e.Repo.Root)\\n3832-\\t\\t\\thandoff := handoffPacket(state, roles.Binding{TaskID: taskID, BaseSHA: identity.BaseSHA},\\n3833-\\t\\t\\t\\tconfig.DisplayName(worker.Name), start.GraphBuildCommit(), e.Config.Workflow.ReviewCycles, e.Config.Workflow.ReviewCycles)\\n3834-\\t\\t\\tif err := handoff.Continuity(roles.Binding{TaskID: taskID, BaseSHA: identity.BaseSHA}); err != nil {\\n3835-\\t\\t\\t\\t// A handoff that does not continue this task would start the\\n3836-\\t\\t\\t\\t// next worker over on the same branch, which looks like progress\\n3837-\\t\\t\\t\\t// and is not.\\n3838-\\t\\t\\t\\tfail(fmt.Errorf(\\\"the candidate could not be handed on: %w\\\", err))\\n3839-\\t\\t\\t\\treturn\\n3840-\\t\\t\\t}\\n3841-\\t\\t\\tcarried = handoff.Render()\\n3842-\\t\\t\\te.emit(event.New(e.SessionID, taskID, event.SourceSystem, event.HandoffCreated,\\n3843-\\t\\t\\