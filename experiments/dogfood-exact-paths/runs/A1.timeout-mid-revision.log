{"id":"20260830T054341.113658417Z-24f4e07d","time":"2026-08-30T05:43:41.113658417Z","session_id":"session-20260830T052251.276503861Z","task_id":"task-1788067371276752033","source":"claude","kind":"output","summary":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01VSgPjv1oLMioGZpLJPnALg\",\"type\":\"tool_result\",\"content\":\"// Package report summarises what a candidate actually changed, for an\\n// architect rather than for a reviewer of diffs.\\n//\\n// Every number here is counted from the candidate diff or quoted from Sensei.\\n// Nothing is a model's description of its own work: an agent summarising what\\n// it believes it did is the least reliable witness available, and this report\\n// exists precisely so the architect does not have to take that summary on\\n// trust. What the report cannot establish is stated as such.\\npackage report\\n\\nimport (\\n\\t\\\"fmt\\\"\\n\\t\\\"path\\\"\\n\\t\\\"sort\\\"\\n\\t\\\"strings\\\"\\n)\\n\\n// Status is how a file was affected by the candidate.\\ntype Status string\\n\\nconst (\\n\\tAdded    Status = \\\"added\\\"\\n\\tModified Status = \\\"modified\\\"\\n\\tDeleted  Status = \\\"deleted\\\"\\n\\tRenamed  Status = \\\"renamed\\\"\\n)\\n\\n// FileChange is one file the candidate touched.\\ntype FileChange struct {\\n\\tPath   string `json:\\\"path\\\"`\\n\\tStatus Status `json:\\\"status\\\"`\\n\\t// OldPath is the path a renamed file had before the change.\\n\\tOldPath string `json:\\\"old_path,omitempty\\\"`\\n}\\n\\n// Change is the architectural shape of a candidate.\\ntype Change struct {\\n\\tFiles []FileChange `json:\\\"files\\\"`\\n\\t// Awareness counts governance entries the candidate added, keyed by the\\n\\t// kind Sensei calls them.\\n\\tAwareness map[string]int `json:\\\"awareness,omitempty\\\"`\\n\\t// Audit is Sensei's own verdict on the diff, quoted.\\n\\tAudit string `json:\\\"audit,omitempty\\\"`\\n\\t// Risk is the preflight risk class for the files actually touched.\\n\\tRisk string `json:\\\"risk,omitempty\\\"`\\n\\t// Governing lists invariants Sensei reports over the touched files.\\n\\tGoverning []string `json:\\\"governing,omitempty\\\"`\\n}\\n\\n// awarenessKinds maps an awareness source file to the entry kind it holds.\\nvar awarenessKinds = map[string]string{\\n\\t\\\"invariants.yaml\\\":        \\\"invariants\\\",\\n\\t\\\"failure_modes.yaml\\\":     \\\"failure modes\\\",\\n\\t\\\"forbidden_fixes.yaml\\\":   \\\"forbidden fixes\\\",\\n\\t\\\"incident_patterns.yaml\\\": \\\"incident patterns\\\",\\n\\t\\\"decisions.yaml\\\":         \\\"decisions\\\",\\n\\t\\\"contracts.yaml\\\":         \\\"contracts\\\",\\n\\t\\\"high_risk_files.yaml\\\":   \\\"high-risk file entries\\\",\\n\\t\\\"activation_rules.yaml\\\":  \\\"activation rules\\\",\\n\\t// The meta-principle pack is installed by `sensei init`, not authored for\\n\\t// this change. Counting it as governance the candidate added would overstate\\n\\t// the work by more than a hundred entries.\\n\\t\\\"meta_principles.yaml\\\": \\\"meta principles (installed pack, not authored here)\\\",\\n}\\n\\n// FromDiff derives the change shape from a unified diff. It reads the diff\\n// itself rather than asking the worker what it did.\\n//\\n// The pathnames are the ones the diff text spells, which is Git's presentation\\n// form: a pathname holding a tab, a newline, a quote or a non-UTF-8 byte\\n// arrives quoted and escaped, and is misread or missed here. A caller holding\\n// the capture's measured path set must use FromCapture instead.\\nfunc FromDiff(diff string) Change {\\n\\tchange := Change{Awareness: map[string]int{}}\\n\\tfor _, e := range scanDiff(diff) {\\n\\t\\tpath := e.parsedPath()\\n\\t\\tif path == \\\"\\\" {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tchange.Files = append(change.Files, FileChange{Path: path, Status: e.status, OldPath: e.renameFrom})\\n\\t\\tif kind := awarenessKind(path); kind != \\\"\\\" \u0026\u0026 e.awareness != 0 {\\n\\t\\t\\tchange.Awareness[kind] += e.awareness\\n\\t\\t}\\n\\t}\\n\\treturn change\\n}\\n\\n// FromCapture derives the change shape from a candidate diff and the exact path\\n// set the capture measured.\\n//\\n// The diff supplies the presentation -- which files were added, deleted or\\n// renamed, and what governance their added lines hold -- and gitx.Capture.Paths\\n// supplies the pathnames, because the diff spells them in Git's quoted form and\\n// the capture took them from `--name-status -z` on NUL boundaries. That is the\\n// whole difference: a pathname holding a tab, a newline, a quote or a non-UTF-8\\n// byte is data here rather than something to be parsed back out of text.\\n//\\n// It FAILS CLOSED. A diff entry naming a path the capture did not measure, or a\\n// measured path no diff entry claims, is two readings of one candidate\\n// disagreeing; a report that quietly picked either would be exact about the\\n// wrong change.\\n//\\n// Rename detection is on in the diff and off in the path set, so a rename is\\n// ONE Renamed FileChange that consumes BOTH of its exact paths.\\nfunc FromCapture(diff string, paths []string) (Change, error) {\\n\\tchange := Change{Awareness: map[string]int{}}\\n\\tunclaimed := make(map[string]int, len(paths))\\n\\tfor _, p := range paths {\\n\\t\\tunclaimed[p]++\\n\\t}\\n\\tclaim := func(p string) error {\\n\\t\\tif unclaimed[p] == 0 {\\n\\t\\t\\treturn fmt.Errorf(\\\"the diff names %q, which the capture did not measure\\\", p)\\n\\t\\t}\\n\\t\\tunclaimed[p]--\\n\\t\\treturn nil\\n\\t}\\n\\tfor _, e := range scanDiff(diff) {\\n\\t\\tpath, err := e.exactPath()\\n\\t\\tif err != nil {\\n\\t\\t\\treturn Change{}, err\\n\\t\\t}\\n\\t\\tif err := claim(path); err != nil {\\n\\t\\t\\treturn Change{}, err\\n\\t\\t}\\n\\t\\tfile := FileChange{Path: path, Status: e.status}\\n\\t\\tif e.status == Renamed {\\n\\t\\t\\told, err := unquotePath(e.renameFrom)\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\treturn Change{}, fmt.Errorf(\\\"rename source: %w\\\", err)\\n\\t\\t\\t}\\n\\t\\t\\tif err := claim(old); err != nil {\\n\\t\\t\\t\\treturn Change{}, err\\n\\t\\t\\t}\\n\\t\\t\\tfile.OldPath = old\\n\\t\\t}\\n\\t\\tchange.Files = append(change.Files, file)\\n\\t\\tif kind := awarenessKind(path); kind != \\\"\\\" \u0026\u0026 e.awareness != 0 {\\n\\t\\t\\tchange.Awareness[kind] += e.awareness\\n\\t\\t}\\n\\t}\\n\\tif left := remaining(unclaimed); len(left) != 0 {\\n\\t\\treturn Change{}, fmt.Errorf(\\\"the capture measured %d path(s) no diff entry claims: %q\\\", len(left), left)\\n\\t}\\n\\treturn change, nil\\n}\\n\\n// remaining is the paths still unclaimed, in order, so a mismatch names them.\\nfunc remaining(unclaimed map[string]int) []string {\\n\\tvar left []string\\n\\tfor p, n := range unclaimed {\\n\\t\\tif n \u003e 0 {\\n\\t\\t\\tleft = append(left, p)\\n\\t\\t}\\n\\t}\\n\\tsort.Strings(left)\\n\\treturn left\\n}\\n\\n// diffEntry is one logical change as the diff presents it, with its pathnames\\n// left in the text's own form. Resolving them is the caller's business:\\n// FromDiff takes the presentation form, FromCapture takes the measured bytes.\\ntype diffEntry struct {\\n\\theader     string\\n\\trenameFrom string\\n\\trenameTo   string\\n\\t// plus is the rest of the `+++ ` line, which is a pathname only for a\\n\\t// fragment carrying no `diff --git` header at all.\\n\\tplus   string\\n\\tstatus Status\\n\\t// awareness is how many governance entries the added lines start, counted\\n\\t// before anything knows which file they belong to.\\n\\tawareness int\\n}\\n\\n// scanDiff walks a unified diff once and records what each entry says about\\n// itself.\\nfunc scanDiff(diff string) []diffEntry {\\n\\tvar entries []diffEntry\\n\\tcurrent := diffEntry{status: Modified}\\n\\tstarted := false\\n\\tflush := func() {\\n\\t\\tif started {\\n\\t\\t\\tentries = append(entries, current)\\n\\t\\t}\\n\\t\\tcurrent, started = diffEntry{status: Modified}, false\\n\\t}\\n\\tfor _, line := range strings.Split(diff, \\\"\\\\n\\\") {\\n\\t\\tswitch {\\n\\t\\tcase strings.HasPrefix(line, \\\"diff --git \\\"):\\n\\t\\t\\tflush()\\n\\t\\t\\tcurrent.header, started = line, true\\n\\t\\tcase strings.HasPrefix(line, \\\"new file mode\\\"):\\n\\t\\t\\tcurrent.status = Added\\n\\t\\tcase strings.HasPrefix(line, \\\"deleted file mode\\\"):\\n\\t\\t\\tcurrent.status = Deleted\\n\\t\\tcase strings.HasPrefix(line, \\\"rename from \\\"):\\n\\t\\t\\tcurrent.renameFrom = strings.TrimPrefix(line, \\\"rename from \\\")\\n\\t\\t\\tcurrent.status = Renamed\\n\\t\\tcase strings.HasPrefix(line, \\\"rename to \\\"):\\n\\t\\t\\t// The rename lines carry both paths whole, however many spaces\\n\\t\\t\\t// they hold; they outrank the header's guess.\\n\\t\\t\\tcurrent.renameTo = strings.TrimPrefix(line, \\\"rename to \\\")\\n\\t\\tcase strings.HasPrefix(line, \\\"+++ \\\"):\\n\\t\\t\\tif current.plus == \\\"\\\" {\\n\\t\\t\\t\\tcurrent.plus = strings.TrimPrefix(line, \\\"+++ \\\")\\n\\t\\t\\t}\\n\\t\\t\\tstarted = true\\n\\t\\tcase strings.HasPrefix(line, \\\"+\\\"):\\n\\t\\t\\tif isEntryStart(line) {\\n\\t\\t\\t\\tcurrent.awareness++\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tflush()\\n\\treturn entries\\n}\\n\\n// parsedPath is the pathname the diff text spells for this entry.\\nfunc (e diffEntry) parsedPath() string {\\n\\tif e.renameTo != \\\"\\\" {\\n\\t\\treturn e.renameTo\\n\\t}\\n\\tif p := diffPath(e.header); p != \\\"\\\" {\\n\\t\\treturn p\\n\\t}\\n\\tif rest, ok := strings.CutPrefix(e.plus, \\\"b/\\\"); ok {\\n\\t\\treturn strings.TrimSuffix(rest, \\\"\\\\t\\\")\\n\\t}\\n\\treturn \\\"\\\"\\n}\\n\\n// exactPath is the pathname bytes this entry names on the b side, with Git's\\n// quoting undone so the result can be compared with a measured path.\\n//\\n// Every entry Git emits carries a `diff --git` header, and a rename carries the\\n// whole destination on its own line, so these two sources are exhaustive for a\\n// real diff. Anything else is reported rather than guessed at.\\nfunc (e diffEntry) exactPath() (string, error) {\\n\\tif e.renameTo != \\\"\\\" {\\n\\t\\treturn unquotePath(e.renameTo)\\n\\t}\\n\\treturn headerBSide(e.header)\\n}\\n\\n// headerBSide reads the b-side pathname out of a `diff --git a/P b/P` header.\\n//\\n// Git quotes each side independently, and an UNQUOTED pathname can never hold a\\n// quote character -- Git would have quoted it -- so the first ` \\\"` in a header\\n// whose a side is bare can only open the b side. When neither side is quoted\\n// the two paths are told apart by shape, as diffPath explains.\\nfunc headerBSide(line string) (string, error) {\\n\\trest, ok := strings.CutPrefix(line, \\\"diff --git \\\")\\n\\tif !ok {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"a diff entry carries no `diff --git` header: %q\\\", line)\\n\\t}\\n\\tvar token string\\n\\tswitch {\\n\\tcase strings.HasPrefix(rest, `\\\"`):\\n\\t\\t_, after, ok := splitQuoted(rest)\\n\\t\\tif !ok {\\n\\t\\t\\treturn \\\"\\\", fmt.Errorf(\\\"unterminated quoted pathname in %q\\\", line)\\n\\t\\t}\\n\\t\\ttoken = strings.TrimPrefix(after, \\\" \\\")\\n\\tcase strings.Contains(rest, ` \\\"`):\\n\\t\\ttoken = rest[strings.Index(rest, ` \\\"`)+1:]\\n\\tdefault:\\n\\t\\tif p := diffPath(line); p != \\\"\\\" {\\n\\t\\t\\treturn p, nil\\n\\t\\t}\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"no pathname could be read from %q\\\", line)\\n\\t}\\n\\tname, err := unquotePath(token)\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", err\\n\\t}\\n\\tb, ok := strings.CutPrefix(name, \\\"b/\\\")\\n\\tif !ok {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"the b side of %q is not a b/ path\\\", line)\\n\\t}\\n\\treturn b, nil\\n}\\n\\n// unquotePath undoes Git's C-style quoting, and leaves an unquoted name alone.\\n//\\n// Git quotes a pathname holding a control character, a quote or a backslash,\\n// and -- with core.quotePath at its default -- every byte above ASCII, as\\n// three-digit octal. This decodes to BYTES rather than through a Go string\\n// literal: the pathname this exists for may not be valid UTF-8, and\\n// strconv.Unquote would replace such a byte with U+FFFD.\\nfunc unquotePath(s string) (string, error) {\\n\\tif !strings.HasPrefix(s, `\\\"`) {\\n\\t\\treturn s, nil\\n\\t}\\n\\tname, rest, ok := splitQuoted(s)\\n\\tif !ok || rest != \\\"\\\" {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"cannot read the quoted pathname %s\\\", s)\\n\\t}\\n\\treturn name, nil\\n}\\n\\n// cEscapes are the single-character escapes Git emits; anything else it escapes\\n// in octal.\\nvar cEscapes = map[byte]byte{'a': 0x07, 'b': 0x08, 't': 0x09, 'n': 0x0a, 'v': 0x0b, 'f': 0x0c, 'r': 0x0d, '\\\"': '\\\"', '\\\\\\\\': '\\\\\\\\'}\\n\\n// splitQuoted decodes the C-quoted token at the start of s, returning the bytes\\n// it names and whatever follows its closing quote.\\nfunc splitQuoted(s string) (string, string, bool) {\\n\\tif !strings.HasPrefix(s, `\\\"`) {\\n\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t}\\n\\tvar out []byte\\n\\tfor i := 1; i \u003c len(s); {\\n\\t\\tc := s[i]\\n\\t\\tif c == '\\\"' {\\n\\t\\t\\treturn string(out), s[i+1:], true\\n\\t\\t}\\n\\t\\tif c != '\\\\\\\\' {\\n\\t\\t\\tout = append(out, c)\\n\\t\\t\\ti++\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif i+1 \u003e= len(s) {\\n\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t}\\n\\t\\tif e := s[i+1]; e \u003e= '0' \u0026\u0026 e \u003c= '7' {\\n\\t\\t\\t// Git writes exactly three octal digits.\\n\\t\\t\\tif i+4 \u003e len(s) {\\n\\t\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t\\t}\\n\\t\\t\\tvalue := 0\\n\\t\\t\\tfor _, d := range []byte(s[i+1 : i+4]) {\\n\\t\\t\\t\\tif d \u003c '0' || d \u003e '7' {\\n\\t\\t\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tvalue = value\u003c\u003c3 | int(d-'0')\\n\\t\\t\\t}\\n\\t\\t\\tif value \u003e 0xff {\\n\\t\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t\\t}\\n\\t\\t\\tout = append(out, byte(value))\\n\\t\\t\\ti += 4\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tb, ok := cEscapes[s[i+1]]\\n\\t\\tif !ok {\\n\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t}\\n\\t\\tout = append(out, b)\\n\\t\\ti += 2\\n\\t}\\n\\treturn \\\"\\\", \\\"\\\", false\\n}\\n\\n// diffPath takes the b-side path from a `diff --git a/P b/P` header.\\n//\\n// It used to split the line on whitespace, which lost every path containing\\n// a space -- and a granted test file at such a path then read as untouched\\n// and skipped inspection (sensei-code#101 review). Git does not quote spaces\\n// in this header, so the line is parsed by its shape instead: for an\\n// unrenamed file both halves are the same path, and the one split that makes\\n// them equal is the answer. A header whose halves differ (a rename) yields\\n// \\\"\\\" here and is completed by the `rename to` line that follows it.\\nfunc diffPath(line string) string {\\n\\trest := strings.TrimPrefix(line, \\\"diff --git \\\")\\n\\tif !strings.HasPrefix(rest, \\\"a/\\\") {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tfor i := len(rest) - 1; i \u003e 0; i-- {\\n\\t\\tif !strings.HasPrefix(rest[i:], \\\" b/\\\") {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tleft, right := strings.TrimPrefix(rest[:i], \\\"a/\\\"), strings.TrimPrefix(rest[i+1:], \\\"b/\\\")\\n\\t\\tif left == right {\\n\\t\\t\\treturn right\\n\\t\\t}\\n\\t}\\n\\treturn \\\"\\\"\\n}\\n\\nfunc awarenessKind(file string) string {\\n\\tif !strings.Contains(file, \\\"docs/awareness/\\\") {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tif kind, ok := awarenessKinds[path.Base(file)]; ok {\\n\\t\\treturn kind\\n\\t}\\n\\treturn \\\"awareness entries\\\"\\n}\\n\\n// isEntryStart matches the start of a YAML list entry carrying an id, which is\\n// how every Sensei awareness entry begins.\\nfunc isEntryStart(line string) bool {\\n\\treturn strings.HasPrefix(strings.TrimSpace(strings.TrimPrefix(line, \\\"+\\\")), \\\"- id:\\\")\\n}\\n\\n// Counts returns how many files were added, modified and deleted.\\nfunc (c Change) Counts() (added, modified, deleted int) {\\n\\tfor _, f := range c.Files {\\n\\t\\tswitch f.Status {\\n\\t\\tcase Added:\\n\\t\\t\\tadded++\\n\\t\\tcase Deleted:\\n\\t\\t\\tdeleted++\\n\\t\\tdefault:\\n\\t\\t\\tmodified++\\n\\t\\t}\\n\\t}\\n\\treturn\\n}\\n\\n// GoFiles counts non-test Go files, and the test files separately, because\\n// \\\"five new files, none of them tests\\\" is the kind of thing an architect wants\\n// to notice without reading the diff.\\nfunc (c Change) GoFiles() (source, tests int) {\\n\\tfor _, f := range c.Files {\\n\\t\\tif !strings.HasSuffix(f.Path, \\\".go\\\") {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif strings.HasSuffix(f.Path, \\\"_test.go\\\") {\\n\\t\\t\\ttests++\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tsource++\\n\\t}\\n\\treturn\\n}\\n\\n// Render writes the report an architect reads. It always ends with what the\\n// report does not establish, because a change summary that reads as a\\n// completion claim is exactly the false green Sensei exists to prevent.\\nfunc (c Change) Render(task string) string {\\n\\tvar b strings.Builder\\n\\tb.WriteString(\\\"Architectural change report\\\\n\\\")\\n\\tif t := strings.TrimSpace(task); t != \\\"\\\" {\\n\\t\\tb.WriteString(\\\"  for: \\\" + t + \\\"\\\\n\\\")\\n\\t}\\n\\n\\tadded, modified, deleted := c.Counts()\\n\\tb.WriteString(fmt.Sprintf(\\\"\\\\n  files: %d added, %d modified, %d deleted\\\\n\\\", added, modified, deleted))\\n\\tif source, tests := c.GoFiles(); source+tests \u003e 0 {\\n\\t\\tb.WriteString(fmt.Sprintf(\\\"  go: %d source, %d test\\\\n\\\", source, tests))\\n\\t}\\n\\n\\tif len(c.Awareness) != 0 {\\n\\t\\tb.WriteString(\\\"\\\\n  governance added:\\\\n\\\")\\n\\t\\tfor _, kind := range sortedKeys(c.Awareness) {\\n\\t\\t\\tb.WriteString(fmt.Sprintf(\\\"    %d %s\\\\n\\\", c.Awareness[kind], kind))\\n\\t\\t}\\n\\t}\\n\\n\\tif len(c.Governing) != 0 {\\n\\t\\tb.WriteString(\\\"\\\\n  governed by:\\\\n\\\")\\n\\t\\tfor _, id := range c.Governing {\\n\\t\\t\\tb.WriteString(\\\"    \\\" + id + \\\"\\\\n\\\")\\n\\t\\t}\\n\\t}\\n\\n\\tif r := strings.TrimSpace(c.Risk); r != \\\"\\\" {\\n\\t\\tb.WriteString(\\\"\\\\n  Sensei risk class: \\\" + r + \\\"\\\\n\\\")\\n\\t}\\n\\tif a := strings.TrimSpace(c.Audit); a != \\\"\\\" {\\n\\t\\tb.WriteString(\\\"\\\\n  Sensei diff audit:\\\\n    \\\" + strings.ReplaceAll(a, \\\"\\\\n\\\", \\\"\\\\n    \\\") + \\\"\\\\n\\\")\\n\\t}\\n\\n\\tb.WriteString(\\\"\\\\n  not established by this report:\\\\n\\\")\\n\\tfor _, line := range c.NotEstablished() {\\n\\t\\tb.WriteString(\\\"    - \\\" + line + \\\"\\\\n\\\")\\n\\t}\\n\\treturn strings.TrimRight(b.String(), \\\"\\\\n\\\")\\n}\\n\\n// NotEstablished names the claims this report is not entitled to make. It is\\n// not boilerplate: each line corresponds to a step that genuinely has not run.\\nfunc (c Change) NotEstablished() []string {\\n\\tout := []string{\\n\\t\\t\\\"admission: not requested, so this candidate is not admitted\\\",\\n\\t\\t\\\"correctness: reviewer acceptance is not proof, and passing tests are not proof\\\",\\n\\t}\\n\\tif strings.TrimSpace(c.Audit) == \\\"\\\" {\\n\\t\\tout = append(out, \\\"Sensei did not audit this diff\\\")\\n\\t}\\n\\tif len(c.Governing) == 0 {\\n\\t\\tout = append(out, \\\"no invariant was found governing the touched files, which may mean the area is ungoverned rather than safe\\\")\\n\\t}\\n\\tif _, tests := c.GoFiles(); tests == 0 {\\n\\t\\tif source, _ := c.GoFiles(); source \u003e 0 {\\n\\t\\t\\tout = append(out, \\\"no test file was added or changed alongside the Go sources\\\")\\n\\t\\t}\\n\\t}\\n\\treturn out\\n}\\n\\nfunc sortedKeys(m map[string]int) []string {\\n\\tkeys := make([]string, 0, len(m))\\n\\tfor k := range m {\\n\\t\\tkeys = append(keys, k)\\n\\t}\\n\\tsort.Strings(keys)\\n\\treturn keys\\n}\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"c0b87186-dc2c-4d3b-96a6-66957bfcb02f\",\"uuid\":\"8545ac53-9835-4080-8249-ffe3d2ebc266\",\"timestamp\":\"2026-08-30T05:43:41.112Z\",\"tool_use_result\":{\"stdout\":\"// Package report summarises what a candidate actually changed, for an\\n// architect rather than for a reviewer of diffs.\\n//\\n// Every number here is counted from the candidate diff or quoted from Sensei.\\n// Nothing is a model's description of its own work: an agent summarising what\\n// it believes it did is the least reliable witness available, and this report\\n// exists precisely so the architect does not have to take that summary on\\n// trust. What the report cannot establish is stated as such.\\npackage report\\n\\nimport (\\n\\t\\\"fmt\\\"\\n\\t\\\"path\\\"\\n\\t\\\"sort\\\"\\n\\t\\\"strings\\\"\\n)\\n\\n// Status is how a file was affected by the candidate.\\ntype Status string\\n\\nconst (\\n\\tAdded    Status = \\\"added\\\"\\n\\tModified Status = \\\"modified\\\"\\n\\tDeleted  Status = \\\"deleted\\\"\\n\\tRenamed  Status = \\\"renamed\\\"\\n)\\n\\n// FileChange is one file the candidate touched.\\ntype FileChange struct {\\n\\tPath   string `json:\\\"path\\\"`\\n\\tStatus Status `json:\\\"status\\\"`\\n\\t// OldPath is the path a renamed file had before the change.\\n\\tOldPath string `json:\\\"old_path,omitempty\\\"`\\n}\\n\\n// Change is the architectural shape of a candidate.\\ntype Change struct {\\n\\tFiles []FileChange `json:\\\"files\\\"`\\n\\t// Awareness counts governance entries the candidate added, keyed by the\\n\\t// kind Sensei calls them.\\n\\tAwareness map[string]int `json:\\\"awareness,omitempty\\\"`\\n\\t// Audit is Sensei's own verdict on the diff, quoted.\\n\\tAudit string `json:\\\"audit,omitempty\\\"`\\n\\t// Risk is the preflight risk class for the files actually touched.\\n\\tRisk string `json:\\\"risk,omitempty\\\"`\\n\\t// Governing lists invariants Sensei reports over the touched files.\\n\\tGoverning []string `json:\\\"governing,omitempty\\\"`\\n}\\n\\n// awarenessKinds maps an awareness source file to the entry kind it holds.\\nvar awarenessKinds = map[string]string{\\n\\t\\\"invariants.yaml\\\":        \\\"invariants\\\",\\n\\t\\\"failure_modes.yaml\\\":     \\\"failure modes\\\",\\n\\t\\\"forbidden_fixes.yaml\\\":   \\\"forbidden fixes\\\",\\n\\t\\\"incident_patterns.yaml\\\": \\\"incident patterns\\\",\\n\\t\\\"decisions.yaml\\\":         \\\"decisions\\\",\\n\\t\\\"contracts.yaml\\\":         \\\"contracts\\\",\\n\\t\\\"high_risk_files.yaml\\\":   \\\"high-risk file entries\\\",\\n\\t\\\"activation_rules.yaml\\\":  \\\"activation rules\\\",\\n\\t// The meta-principle pack is installed by `sensei init`, not authored for\\n\\t// this change. Counting it as governance the candidate added would overstate\\n\\t// the work by more than a hundred entries.\\n\\t\\\"meta_principles.yaml\\\": \\\"meta principles (installed pack, not authored here)\\\",\\n}\\n\\n// FromDiff derives the change shape from a unified diff. It reads the diff\\n// itself rather than asking the worker what it did.\\n//\\n// The pathnames are the ones the diff text spells, which is Git's presentation\\n// form: a pathname holding a tab, a newline, a quote or a non-UTF-8 byte\\n// arrives quoted and escaped, and is misread or missed here. A caller holding\\n// the capture's measured path set must use FromCapture instead.\\nfunc FromDiff(diff string) Change {\\n\\tchange := Change{Awareness: map[string]int{}}\\n\\tfor _, e := range scanDiff(diff) {\\n\\t\\tpath := e.parsedPath()\\n\\t\\tif path == \\\"\\\" {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tchange.Files = append(change.Files, FileChange{Path: path, Status: e.status, OldPath: e.renameFrom})\\n\\t\\tif kind := awarenessKind(path); kind != \\\"\\\" \u0026\u0026 e.awareness != 0 {\\n\\t\\t\\tchange.Awareness[kind] += e.awareness\\n\\t\\t}\\n\\t}\\n\\treturn change\\n}\\n\\n// FromCapture derives the change shape from a candidate diff and the exact path\\n// set the capture measured.\\n//\\n// The diff supplies the presentation -- which files were added, deleted or\\n// renamed, and what governance their added lines hold -- and gitx.Capture.Paths\\n// supplies the pathnames, because the diff spells them in Git's quoted form and\\n// the capture took them from `--name-status -z` on NUL boundaries. That is the\\n// whole difference: a pathname holding a tab, a newline, a quote or a non-UTF-8\\n// byte is data here rather than something to be parsed back out of text.\\n//\\n// It FAILS CLOSED. A diff entry naming a path the capture did not measure, or a\\n// measured path no diff entry claims, is two readings of one candidate\\n// disagreeing; a report that quietly picked either would be exact about the\\n// wrong change.\\n//\\n// Rename detection is on in the diff and off in the path set, so a rename is\\n// ONE Renamed FileChange that consumes BOTH of its exact paths.\\nfunc FromCapture(diff string, paths []string) (Change, error) {\\n\\tchange := Change{Awareness: map[string]int{}}\\n\\tunclaimed := make(map[string]int, len(paths))\\n\\tfor _, p := range paths {\\n\\t\\tunclaimed[p]++\\n\\t}\\n\\tclaim := func(p string) error {\\n\\t\\tif unclaimed[p] == 0 {\\n\\t\\t\\treturn fmt.Errorf(\\\"the diff names %q, which the capture did not measure\\\", p)\\n\\t\\t}\\n\\t\\tunclaimed[p]--\\n\\t\\treturn nil\\n\\t}\\n\\tfor _, e := range scanDiff(diff) {\\n\\t\\tpath, err := e.exactPath()\\n\\t\\tif err != nil {\\n\\t\\t\\treturn Change{}, err\\n\\t\\t}\\n\\t\\tif err := claim(path); err != nil {\\n\\t\\t\\treturn Change{}, err\\n\\t\\t}\\n\\t\\tfile := FileChange{Path: path, Status: e.status}\\n\\t\\tif e.status == Renamed {\\n\\t\\t\\told, err := unquotePath(e.renameFrom)\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\treturn Change{}, fmt.Errorf(\\\"rename source: %w\\\", err)\\n\\t\\t\\t}\\n\\t\\t\\tif err := claim(old); err != nil {\\n\\t\\t\\t\\treturn Change{}, err\\n\\t\\t\\t}\\n\\t\\t\\tfile.OldPath = old\\n\\t\\t}\\n\\t\\tchange.Files = append(change.Files, file)\\n\\t\\tif kind := awarenessKind(path); kind != \\\"\\\" \u0026\u0026 e.awareness != 0 {\\n\\t\\t\\tchange.Awareness[kind] += e.awareness\\n\\t\\t}\\n\\t}\\n\\tif left := remaining(unclaimed); len(left) != 0 {\\n\\t\\treturn Change{}, fmt.Errorf(\\\"the capture measured %d path(s) no diff entry claims: %q\\\", len(left), left)\\n\\t}\\n\\treturn change, nil\\n}\\n\\n// remaining is the paths still unclaimed, in order, so a mismatch names them.\\nfunc remaining(unclaimed map[string]int) []string {\\n\\tvar left []string\\n\\tfor p, n := range unclaimed {\\n\\t\\tif n \u003e 0 {\\n\\t\\t\\tleft = append(left, p)\\n\\t\\t}\\n\\t}\\n\\tsort.Strings(left)\\n\\treturn left\\n}\\n\\n// diffEntry is one logical change as the diff presents it, with its pathnames\\n// left in the text's own form. Resolving them is the caller's business:\\n// FromDiff takes the presentation form, FromCapture takes the measured bytes.\\ntype diffEntry struct {\\n\\theader     string\\n\\trenameFrom string\\n\\trenameTo   string\\n\\t// plus is the rest of the `+++ ` line, which is a pathname only for a\\n\\t// fragment carrying no `diff --git` header at all.\\n\\tplus   string\\n\\tstatus Status\\n\\t// awareness is how many governance entries the added lines start, counted\\n\\t// before anything knows which file they belong to.\\n\\tawareness int\\n}\\n\\n// scanDiff walks a unified diff once and records what each entry says about\\n// itself.\\nfunc scanDiff(diff string) []diffEntry {\\n\\tvar entries []diffEntry\\n\\tcurrent := diffEntry{status: Modified}\\n\\tstarted := false\\n\\tflush := func() {\\n\\t\\tif started {\\n\\t\\t\\tentries = append(entries, current)\\n\\t\\t}\\n\\t\\tcurrent, started = diffEntry{status: Modified}, false\\n\\t}\\n\\tfor _, line := range strings.Split(diff, \\\"\\\\n\\\") {\\n\\t\\tswitch {\\n\\t\\tcase strings.HasPrefix(line, \\\"diff --git \\\"):\\n\\t\\t\\tflush()\\n\\t\\t\\tcurrent.header, started = line, true\\n\\t\\tcase strings.HasPrefix(line, \\\"new file mode\\\"):\\n\\t\\t\\tcurrent.status = Added\\n\\t\\tcase strings.HasPrefix(line, \\\"deleted file mode\\\"):\\n\\t\\t\\tcurrent.status = Deleted\\n\\t\\tcase strings.HasPrefix(line, \\\"rename from \\\"):\\n\\t\\t\\tcurrent.renameFrom = strings.TrimPrefix(line, \\\"rename from \\\")\\n\\t\\t\\tcurrent.status = Renamed\\n\\t\\tcase strings.HasPrefix(line, \\\"rename to \\\"):\\n\\t\\t\\t// The rename lines carry both paths whole, however many spaces\\n\\t\\t\\t// they hold; they outrank the header's guess.\\n\\t\\t\\tcurrent.renameTo = strings.TrimPrefix(line, \\\"rename to \\\")\\n\\t\\tcase strings.HasPrefix(line, \\\"+++ \\\"):\\n\\t\\t\\tif current.plus == \\\"\\\" {\\n\\t\\t\\t\\tcurrent.plus = strings.TrimPrefix(line, \\\"+++ \\\")\\n\\t\\t\\t}\\n\\t\\t\\tstarted = true\\n\\t\\tcase strings.HasPrefix(line, \\\"+\\\"):\\n\\t\\t\\tif isEntryStart(line) {\\n\\t\\t\\t\\tcurrent.awareness++\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tflush()\\n\\treturn entries\\n}\\n\\n// parsedPath is the pathname the diff text spells for this entry.\\nfunc (e diffEntry) parsedPath() string {\\n\\tif e.renameTo != \\\"\\\" {\\n\\t\\treturn e.renameTo\\n\\t}\\n\\tif p := diffPath(e.header); p != \\\"\\\" {\\n\\t\\treturn p\\n\\t}\\n\\tif rest, ok := strings.CutPrefix(e.plus, \\\"b/\\\"); ok {\\n\\t\\treturn strings.TrimSuffix(rest, \\\"\\\\t\\\")\\n\\t}\\n\\treturn \\\"\\\"\\n}\\n\\n// exactPath is the pathname bytes this entry names on the b side, with Git's\\n// quoting undone so the result can be compared with a measured path.\\n//\\n// Every entry Git emits carries a `diff --git` header, and a rename carries the\\n// whole destination on its own line, so these two sources are exhaustive for a\\n// real diff. Anything else is reported rather than guessed at.\\nfunc (e diffEntry) exactPath() (string, error) {\\n\\tif e.renameTo != \\\"\\\" {\\n\\t\\treturn unquotePath(e.renameTo)\\n\\t}\\n\\treturn headerBSide(e.header)\\n}\\n\\n// headerBSide reads the b-side pathname out of a `diff --git a/P b/P` header.\\n//\\n// Git quotes each side independently, and an UNQUOTED pathname can never hold a\\n// quote character -- Git would have quoted it -- so the first ` \\\"` in a header\\n// whose a side is bare can only open the b side. When neither side is quoted\\n// the two paths are told apart by shape, as diffPath explains.\\nfunc headerBSide(line string) (string, error) {\\n\\trest, ok := strings.CutPrefix(line, \\\"diff --git \\\")\\n\\tif !ok {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"a diff entry carries no `diff --git` header: %q\\\", line)\\n\\t}\\n\\tvar token string\\n\\tswitch {\\n\\tcase strings.HasPrefix(rest, `\\\"`):\\n\\t\\t_, after, ok := splitQuoted(rest)\\n\\t\\tif !ok {\\n\\t\\t\\treturn \\\"\\\", fmt.Errorf(\\\"unterminated quoted pathname in %q\\\", line)\\n\\t\\t}\\n\\t\\ttoken = strings.TrimPrefix(after, \\\" \\\")\\n\\tcase strings.Contains(rest, ` \\\"`):\\n\\t\\ttoken = rest[strings.Index(rest, ` \\\"`)+1:]\\n\\tdefault:\\n\\t\\tif p := diffPath(line); p != \\\"\\\" {\\n\\t\\t\\treturn p, nil\\n\\t\\t}\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"no pathname could be read from %q\\\", line)\\n\\t}\\n\\tname, err := unquotePath(token)\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", err\\n\\t}\\n\\tb, ok := strings.CutPrefix(name, \\\"b/\\\")\\n\\tif !ok {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"the b side of %q is not a b/ path\\\", line)\\n\\t}\\n\\treturn b, nil\\n}\\n\\n// unquotePath undoes Git's C-style quoting, and leaves an unquoted name alone.\\n//\\n// Git quotes a pathname holding a control character, a quote or a backslash,\\n// and -- with core.quotePath at its default -- every byte above ASCII, as\\n// three-digit octal. This decodes to BYTES rather than through a Go string\\n// literal: the pathname this exists for may not be valid UTF-8, and\\n// strconv.Unquote would replace such a byte with U+FFFD.\\nfunc unquotePath(s string) (string, error) {\\n\\tif !strings.HasPrefix(s, `\\\"`) {\\n\\t\\treturn s, nil\\n\\t}\\n\\tname, rest, ok := splitQuoted(s)\\n\\tif !ok || rest != \\\"\\\" {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"cannot read the quoted pathname %s\\\", s)\\n\\t}\\n\\treturn name, nil\\n}\\n\\n// cEscapes are the single-character escapes Git emits; anything else it escapes\\n// in octal.\\nvar cEscapes = map[byte]byte{'a': 0x07, 'b': 0x08, 't': 0x09, 'n': 0x0a, 'v': 0x0b, 'f': 0x0c, 'r': 0x0d, '\\\"': '\\\"', '\\\\\\\\': '\\\\\\\\'}\\n\\n// splitQuoted decodes the C-quoted token at the start of s, returning the bytes\\n// it names and whatever follows its closing quote.\\nfunc splitQuoted(s string) (string, string, bool) {\\n\\tif !strings.HasPrefix(s, `\\\"`) {\\n\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t}\\n\\tvar out []byte\\n\\tfor i := 1; i \u003c len(s); {\\n\\t\\tc := s[i]\\n\\t\\tif c == '\\\"' {\\n\\t\\t\\treturn string(out), s[i+1:], true\\n\\t\\t}\\n\\t\\tif c != '\\\\\\\\' {\\n\\t\\t\\tout = append(out, c)\\n\\t\\t\\ti++\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif i+1 \u003e= len(s) {\\n\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t}\\n\\t\\tif e := s[i+1]; e \u003e= '0' \u0026\u0026 e \u003c= '7' {\\n\\t\\t\\t// Git writes exactly three octal digits.\\n\\t\\t\\tif i+4 \u003e len(s) {\\n\\t\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t\\t}\\n\\t\\t\\tvalue := 0\\n\\t\\t\\tfor _, d := range []byte(s[i+1 : i+4]) {\\n\\t\\t\\t\\tif d \u003c '0' || d \u003e '7' {\\n\\t\\t\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tvalue = value\u003c\u003c3 | int(d-'0')\\n\\t\\t\\t}\\n\\t\\t\\tif value \u003e 0xff {\\n\\t\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t\\t}\\n\\t\\t\\tout = append(out, byte(value))\\n\\t\\t\\ti += 4\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tb, ok := cEscapes[s[i+1]]\\n\\t\\tif !ok {\\n\\t\\t\\treturn \\\"\\\", \\\"\\\", false\\n\\t\\t}\\n\\t\\tout = append(out, b)\\n\\t\\ti += 2\\n\\t}\\n\\treturn \\\"\\\", \\\"\\\", false\\n}\\n\\n// diffPath takes the b-side path from a `diff --git a/P b/P` header.\\n//\\n// It used to split the line on whitespace, which lost every path containing\\n// a space -- and a granted test file at such a path then read as untouched\\n// and skipped inspection (sensei-code#101 review). Git does not quote spaces\\n// in this header, so the line is parsed by its shape instead: for an\\n// unrenamed file both halves are the same path, and the one split that makes\\n// them equal is the answer. A header whose halves differ (a rename) yields\\n// \\\"\\\" here and is completed by the `rename to` line that follows it.\\nfunc diffPath(line string) string {\\n\\trest := strings.TrimPrefix(line, \\\"diff --git \\\")\\n\\tif !strings.HasPrefix(rest, \\\"a/\\\") {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tfor i := len(rest) - 1; i \u003e 0; i-- {\\n\\t\\tif !strings.HasPrefix(rest[i:], \\\" b/\\\") {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tleft, right := strings.TrimPrefix(rest[:i], \\\"a/\\\"), strings.TrimPrefix(rest[i+1:], \\\"b/\\\")\\n\\t\\tif left == right {\\n\\t\\t\\treturn right\\n\\t\\t}\\n\\t}\\n\\treturn \\\"\\\"\\n}\\n\\nfunc awarenessKind(file string) string {\\n\\tif !strings.Contains(file, \\\"docs/awareness/\\\") {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tif kind, ok := awarenessKinds[path.Base(file)]; ok {\\n\\t\\treturn kind\\n\\t}\\n\\treturn \\\"awareness entries\\\"\\n}\\n\\n// isEntryStart matches the start of a YAML list entry carrying an id, which is\\n// how every Sensei awareness entry begins.\\nfunc isEntryStart(line string) bool {\\n\\treturn strings.HasPrefix(strings.TrimSpace(strings.TrimPrefix(line, \\\"+\\\")), \\\"- id:\\\")\\n}\\n\\n// Counts returns how many files were added, modified and deleted.\\nfunc (c Change) Counts() (added, modified, deleted int) {\\n\\tfor _, f := range c.Files {\\n\\t\\tswitch f.Status {\\n\\t\\tcase Added:\\n\\t\\t\\tadded++\\n\\t\\tcase Deleted:\\n\\t\\t\\tdeleted++\\n\\t\\tdefault:\\n\\t\\t\\tmodified++\\n\\t\\t}\\n\\t}\\n\\treturn\\n}\\n\\n// GoFiles counts non-test Go files, and the test files separately, because\\n// \\\"five new files, none of them tests\\\" is the kind of thing an architect wants\\n// to notice without reading the diff.\\nfunc (c Change) GoFiles() (source, tests int) {\\n\\tfor _, f := range c.Files {\\n\\t\\tif !strings.HasSuffix(f.Path, \\\".go\\\") {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif strings.HasSuffix(f.Path, \\\"_test.go\\\") {\\n\\t\\t\\ttests++\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tsource++\\n\\t}\\n\\treturn\\n}\\n\\n// Render writes the report an architect reads. It always ends with what the\\n// report does not establish, because a change summary that reads as a\\n// completion claim is exactly the false green Sensei exists to prevent.\\nfunc (c Change) Render(task string) string {\\n\\tvar b strings.Builder\\n\\tb.WriteString(\\\"Architectural change report\\\\n\\\")\\n\\tif t := strings.TrimSpace(task); t != \\\"\\\" {\\n\\t\\tb.WriteString(\\\"  for: \\\" + t + \\\"\\\\n\\\")\\n\\t}\\n\\n\\tadded, modified, deleted := c.Counts()\\n\\tb.WriteString(fmt.Sprintf(\\\"\\\\n  files: %d added, %d modified, %d deleted\\\\n\\\", added, modified, deleted))\\n\\tif source, tests := c.GoFiles(); source+tests \u003e 0 {\\n\\t\\tb.WriteString(fmt.Sprintf(\\\"  go: %d source, %d test\\\\n\\\", source, tests))\\n\\t}\\n\\n\\tif len(c.Awareness) != 0 {\\n\\t\\tb.WriteString(\\\"\\\\n  governance added:\\\\n\\\")\\n\\t\\tfor _, kind := range sortedKeys(c.Awareness) {\\n\\t\\t\\tb.WriteString(fmt.Sprintf(\\\"    %d %s\\\\n\\\", c.Awareness[kind], kind))\\n\\t\\t}\\n\\t}\\n\\n\\tif len(c.Governing) != 0 {\\n\\t\\tb.WriteString(\\\"\\\\n  governed by:\\\\n\\\")\\n\\t\\tfor _, id := range c.Governing {\\n\\t\\t\\tb.WriteString(\\\"    \\\" + id + \\\"\\\\n\\\")\\n\\t\\t}\\n\\t}\\n\\n\\tif r := strings.TrimSpace(c.Risk); r != \\\"\\\" {\\n\\t\\tb.WriteString(\\\"\\\\n  Sensei risk class: \\\" + r + \\\"\\\\n\\\")\\n\\t}\\n\\tif a := strings.TrimSpace(c.Audit); a != \\\"\\\" {\\n\\t\\tb.WriteString(\\\"\\\\n  Sensei diff audit:\\\\n    \\\" + strings.ReplaceAll(a, \\\"\\\\n\\\", \\\"\\\\n    \\\") + \\\"\\\\n\\\")\\n\\t}\\n\\n\\tb.WriteString(\\\"\\\\n  not established by this report:\\\\n\\\")\\n\\tfor _, line := range c.NotEstablished() {\\n\\t\\tb.WriteString(\\\"    - \\\" + line + \\\"\\\\n\\\")\\n\\t}\\n\\treturn strings.TrimRight(b.String(), \\\"\\\\n\\\")\\n}\\n\\n// NotEstablished names the claims this report is not entitled to make. It is\\n// not boilerplate: each line corresponds to a step that genuinely has not run.\\nfunc (c Change) NotEstablished() []string {\\n\\tout := []string{\\n\\t\\t\\\"admission: not requested, so this candidate is not admitted\\\",\\n\\t\\t\\\"correctness: reviewer acceptance is not proof, and passing tests are not proof\\\",\\n\\t}\\n\\tif strings.TrimSpace(c.Audit) == \\\"\\\" {\\n\\t\\tout = append(out, \\\"Sensei did not audit this diff\\\")\\n\\t}\\n\\tif len(c.Governing) == 0 {\\n\\t\\tout = append(out, \\\"no invariant was found governing the touched files, which may mean the area is ungoverned rather than safe\\\")\\n\\t}\\n\\tif _, tests := c.GoFiles(); tests == 0 {\\n\\t\\tif source, _ := c.GoFiles(); source \u003e 0 {\\n\\t\\t\\tout = append(out, \\\"no test file was added or changed alongside the Go sources\\\")\\n\\t\\t}\\n\\t}\\n\\treturn out\\n}\\n\\nfunc sortedKeys(m map[string]int) []string {\\n\\tkeys := make([]string, 0, len(m))\\n\\tfor k := range m {\\n\\t\\tkeys = append(keys, k)\\n\\t}\\n\\tsort.Strings(keys)\\n\\treturn keys\\n}\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}","payload":{"stream":"stdout"}}
