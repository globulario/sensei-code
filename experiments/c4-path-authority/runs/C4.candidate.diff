+// The reconciliation is only worth anything if the two accounts agree on an
+// ordinary candidate: a refusal that fires on every run is a broken gate, not
+// a safe one. This runs both Git invocations over a real change holding the
+// paths that used to be invisible, and requires them to agree.
+func TestTheTwoAccountsOfARealCandidateAgree(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	run := func(args ...string) {
+		t.Helper()
+		cmd := exec.Command("git", append([]string{"-C", root}, args...)...)
+		cmd.Env = append(os.Environ(), "GIT_AUTHOR_NAME=t", "GIT_AUTHOR_EMAIL=t@t", "GIT_COMMITTER_NAME=t", "GIT_COMMITTER_EMAIL=t@t")
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v\n%s", args, err, out)
+		}
+	}
+	write := func(name, body string) {
+		t.Helper()
+		p := filepath.Join(root, name)
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	run("init", "-q", "-b", "main")
+	write("docs/café.md", "a\n")
+	write("naïve.go", "package p\n")
+	write("plain.go", "package p\n\nfunc Gone() {}\n")
+	run("add", "-A")
+	run("commit", "-q", "-m", "base")
+
+	repo := gitx.Repo{Root: root}
+	base, err := repo.Head(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	write("docs/café.md", "a2\n")
+	write("weird/ta\tb.go", "package p\n\nfunc Added() {}\n")
+	run("mv", "naïve.go", "renommé.go")
+	run("rm", "-q", "plain.go")
+
+	capture, err := repo.CandidateCapture(ctx, base, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	changes, err := repo.CandidateChanges(ctx, base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(changes.Files) != 4 {
+		t.Fatalf("git reports %d changed file(s), want 4: %+q", len(changes.Files), changes.Files)
+	}
+	if err := reconcileRenderedDiff(changes, capture.Diff); err != nil {
+		t.Fatalf("the rendered diff and git disagree about an ordinary candidate, so every run would be refused: %v\n%s", err, capture.Diff)
+	}
+	if err := confineToPlan(changes.Paths(), planned("docs/café.md", "weird/ta\tb.go", "naïve.go", "renommé.go", "plain.go")); err != nil {
+		t.Fatalf("an in-plan candidate holding quoted paths was refused: %v", err)
+	}
+}
