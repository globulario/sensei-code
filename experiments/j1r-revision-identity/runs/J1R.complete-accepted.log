{"id":"20260830T080046.884704540Z-eedfd2d1","time":"2026-08-30T08:00:46.88470454Z","session_id":"session-20260830T072521.605271812Z","task_id":"task-1788074721605515483","source":"claude","kind":"output","summary":"{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5\",\"id\":\"msg_011CeYaexxdozTx4BAZnuyM4\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now I'll write the engine-loop regression.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":3806,\"cache_read_input_tokens\":161764,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":3806},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"47ddc484-692a-4f5a-bbc9-2959e876fb15\",\"uuid\":\"9d753266-ddc4-497c-8f49-fd983428265b\",\"timestamp\":\"2026-08-30T08:00:46.884Z\",\"request_id\":\"req_011CeYaewnhEJGDgXyFWrpUt\"}","payload":{"stream":"stdout"}}
{"id":"20260830T080201.828500186Z-e5cc86fa","time":"2026-08-30T08:02:01.828500186Z","session_id":"session-20260830T072521.605271812Z","task_id":"task-1788074721605515483","source":"claude","kind":"output","summary":"{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5\",\"id\":\"msg_011CeYaexxdozTx4BAZnuyM4\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_019v2e5UnkvMpXFennCoPGKr\",\"name\":\"Write\",\"input\":{\"file_path\":\"/tmp/claude-1000/-home-dave-Documents-github-com-globulario-sensei-code/0c05292b-ad66-420a-9985-54db3e81471f/scratchpad/j1r/.subject-worktrees/task-1788074721605515483/internal/workflow/postvalidation_test.go\",\"content\":\"package workflow\\n\\n// Validation can rewrite the candidate.\\n//\\n// A configured formatter is not an observer: it edits the worktree, and every\\n// measurement taken before it describes bytes that no longer exist. The run\\n// used to freeze its content identity BEFORE validation and re-read only the\\n// diff afterwards, so the reviewer read post-format text while the tree bound\\n// to the verdict was the pre-format one. The mint re-measured the worktree,\\n// found the post-format tree, and refused an accepted candidate that had not\\n// moved since its verdict -- naming candidate movement as the cause of a\\n// disagreement the run had created itself.\\n//\\n// The first test here drives the real loop -- runCandidate, its audit call, its\\n// review packet, its verdict binding -- with a formatter that actually rewrites\\n// the candidate, because that is the only place the production binding exists.\\n// A test that assembled validate → capture → noteReviewDelivered → mint by hand\\n// would stay green with the loop's binding removed, which is exactly the defect\\n// under repair. The rest hold the two ends: a candidate that moves after the\\n// state bound to the verdict is still refused, and evidence about other bytes\\n// is refused rather than reconciled.\\n\\nimport (\\n\\t\\\"bufio\\\"\\n\\t\\\"context\\\"\\n\\t\\\"encoding/json\\\"\\n\\t\\\"flag\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io\\\"\\n\\t\\\"os\\\"\\n\\t\\\"os/exec\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"strconv\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/globulario/sensei-code/internal/broker\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/config\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/gitx\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/sensei\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/validation\\\"\\n)\\n\\n// unformatted is Go that compiles and that gofmt WILL rewrite, so the formatter\\n// step is a real mutation rather than a no-op that would pass either way.\\nconst unformatted = \\\"package main\\\\n\\\\nfunc main() {\\\\nprintln( 1 )\\\\n}\\\\n\\\"\\n\\n// The same statement before and after gofmt. Every question of the form \\\"which\\n// bytes did this role actually receive\\\" is answered with these two, because\\n// they survive into a diff and into a prompt where a tree digest does not.\\nconst (\\n\\tunformattedMark = \\\"println( 1 )\\\"\\n\\tformattedMark   = \\\"println(1)\\\"\\n)\\n\\n// formattingEngine is the governed loop's validation configuration, reduced to\\n// the one check that mutates and the one that certifies the result.\\nfunc formattingEngine(t *testing.T, repo gitx.Repo) *Engine {\\n\\tt.Helper()\\n\\trequireGofmt(t)\\n\\te := \u0026Engine{Repo: repo}\\n\\te.Config.Permissions.RunFormatters = true\\n\\te.Config.Permissions.LocalCommit = true\\n\\te.Config.Validation = formattingValidation()\\n\\treturn e\\n}\\n\\nfunc formattingValidation() config.Validation {\\n\\treturn config.Validation{\\n\\t\\tFormat:       []config.Command{{Command: \\\"gofmt\\\", Args: []string{\\\"-w\\\", \\\"main.go\\\"}}},\\n\\t\\tFormatVerify: []config.Command{{Command: \\\"gofmt\\\", Args: []string{\\\"-l\\\", \\\"main.go\\\"}, FailIfOutput: true}},\\n\\t}\\n}\\n\\nfunc requireGofmt(t *testing.T) {\\n\\tt.Helper()\\n\\tif _, err := exec.LookPath(\\\"gofmt\\\"); err != nil {\\n\\t\\tt.Skip(\\\"gofmt is not on PATH, so no formatter can rewrite the candidate here\\\")\\n\\t}\\n}\\n\\n// The payoff, in the loop that actually runs: a worker writes unformatted Go,\\n// validation rewrites it, and every downstream identity -- the audited diff,\\n// the review packet, the verdict's tree and digest, the recorded path set, the\\n// minted commit -- is the state the formatter produced. Then the other end: a\\n// worktree that moves after that verdict is refused rather than rebound.\\n//\\n// This fails if runCandidate stops re-capturing after validation, or stops\\n// assigning that capture over the pre-validation one: the verdict would carry\\n// the tree of bytes nobody reviewed, and the mint would refuse a candidate that\\n// never moved.\\nfunc TestTheGovernedLoopBindsTheCandidateTheFormatterProduced(t *testing.T) {\\n\\tctx := context.Background()\\n\\trequireGofmt(t)\\n\\n\\trepo, base := mintRepo(t)\\n\\tworkspace, err := repo.CreateWorktreeAt(ctx, \\\"task-1\\\", base)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"create the candidate worktree: %v\\\", err)\\n\\t}\\n\\n\\t// What each stub was handed, written down so the test reads the bytes the\\n\\t// role received rather than the bytes the engine says it sent.\\n\\trecord := t.TempDir()\\n\\treviewerSaw := filepath.Join(record, \\\"review-prompt.txt\\\")\\n\\tauditSaw := filepath.Join(record, \\\"audited-diff.txt\\\")\\n\\n\\timplCommand, implArgs := stubProcess(t, \\\"implementor\\\", \\\"\\\")\\n\\treviewCommand, reviewArgs := stubProcess(t, \\\"reviewer\\\", reviewerSaw)\\n\\tsenseiCommand, senseiArgs := stubProcess(t, \\\"sensei\\\", auditSaw)\\n\\n\\tsc, err := sensei.Start(ctx, repo.Root, senseiCommand, senseiArgs)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"start the stub Sensei MCP: %v\\\", err)\\n\\t}\\n\\tdefer sc.Close()\\n\\n\\tworker := config.Agent{Name: \\\"claude\\\", Command: implCommand, Args: implArgs, Graph: \\\"none\\\"}\\n\\te := \u0026Engine{Repo: repo, SessionID: \\\"session-1\\\"}\\n\\te.Config.Permissions = config.Permissions{\\n\\t\\tReadRepository: true, WriteCandidates: true, CreateWorktrees: true,\\n\\t\\tRunFormatters: true, LocalCommit: true,\\n\\t}\\n\\te.Config.Workflow.ReviewCycles = 1\\n\\te.Config.Validation = formattingValidation()\\n\\te.Config.Implementors = []config.Agent{worker}\\n\\te.Config.Reviewer = config.Agent{Name: \\\"codex\\\", Command: reviewCommand, Args: reviewArgs, Graph: \\\"none\\\"}\\n\\te.beginReceipt(\\\"task-1\\\")\\n\\n\\ttc := \u0026taskContext{\\n\\t\\tTask:     \\\"print a number from main\\\",\\n\\t\\tMode:     ModeModify,\\n\\t\\tFiles:    []string{\\\"main.go\\\"},\\n\\t\\tIdentity: candidateIdentityWithBase(base),\\n\\t}\\n\\taccepted, _, _, _, err := e.runCandidate(ctx, sc, certifiedStart{}, \\\"task-1\\\", tc,\\n\\t\\t\\\"Rewrite main.go so it prints a number.\\\", worker, workspace, \\\"\\\")\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"the governed candidate loop failed: %v\\\", err)\\n\\t}\\n\\tif !accepted {\\n\\t\\tt.Fatal(\\\"the loop did not accept the candidate, so nothing was bound to a verdict\\\")\\n\\t}\\n\\n\\t// The state the formatter left behind, measured the way the mint measures.\\n\\tcandidate := gitx.Repo{Root: workspace}\\n\\treviewed, err := candidate.CandidateCapture(ctx, base, tc.Files)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\t// Without a real rewrite the pre- and post-validation captures are the same\\n\\t// object and this test cannot tell them apart.\\n\\tif !strings.Contains(reviewed.Diff, formattedMark) || strings.Contains(reviewed.Diff, unformattedMark) {\\n\\t\\tt.Fatalf(\\\"validation did not rewrite the worker's bytes, so this test distinguishes nothing:\\\\n%s\\\", reviewed.Diff)\\n\\t}\\n\\n\\t// What Sensei was asked to audit.\\n\\tif audited := readRecord(t, auditSaw); audited != reviewed.Diff {\\n\\t\\tt.Errorf(\\\"the audit judged bytes that are not the post-validation candidate:\\\\n%s\\\", audited)\\n\\t}\\n\\n\\t// What the reviewer read, and the revision the packet bound it to.\\n\\tprompt := readRecord(t, reviewerSaw)\\n\\tif strings.Contains(prompt, unformattedMark) {\\n\\t\\tt.Error(\\\"the reviewer was handed the pre-validation bytes\\\")\\n\\t}\\n\\tif !strings.Contains(prompt, formattedMark) {\\n\\t\\tt.Error(\\\"the reviewer was not handed the post-validation candidate\\\")\\n\\t}\\n\\tif revision := candidateRevision(reviewed.Diff); !strings.Contains(prompt, revision) {\\n\\t\\tt.Errorf(\\\"the review packet does not name the post-validation revision %s\\\", shortDigest(revision))\\n\\t}\\n\\n\\t// The content identity the delivered verdict is bound to.\\n\\ttree, ok := e.reviewedTreeFor(\\\"task-1\\\")\\n\\tif !ok {\\n\\t\\tt.Fatal(\\\"the loop recorded no reviewed tree, so no verdict bound a content identity\\\")\\n\\t}\\n\\tif tree != reviewed.Tree {\\n\\t\\tt.Fatalf(\\\"the verdict is bound to tree %s and the reviewed state is %s\\\",\\n\\t\\t\\tshortDigest(tree), shortDigest(reviewed.Tree))\\n\\t}\\n\\tif digest := e.reviewedDigestFor(\\\"task-1\\\"); digest != candidateRevision(reviewed.Diff) {\\n\\t\\tt.Errorf(\\\"the verdict names revision %s, not the post-validation candidate's %s\\\",\\n\\t\\t\\tshortDigest(digest), shortDigest(candidateRevision(reviewed.Diff)))\\n\\t}\\n\\t// The exact path set travels with it: the capture's, not a re-parse of an\\n\\t// older diff.\\n\\tif got, want := tc.EvidenceSnapshot.ChangedPaths, reviewed.Paths; !samePaths(got, want) {\\n\\t\\tt.Errorf(\\\"the recorded path set is %v, and the post-validation capture holds %v\\\", got, want)\\n\\t}\\n\\n\\t// That exact state mints, and the identity reconstructs from (base, tree).\\n\\tif err := e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, workspace, repo.WorktreeBranch(\\\"task-1\\\")); err != nil {\\n\\t\\tt.Fatalf(\\\"the accepted post-validation state could not be minted: %v\\\", err)\\n\\t}\\n\\tif err := candidate.VerifyCanonicalCommit(ctx, base, reviewed.Tree, e.candidateCommitFor(\\\"task-1\\\")); err != nil {\\n\\t\\tt.Fatalf(\\\"the minted identity does not reconstruct from the reviewed state: %v\\\", err)\\n\\t}\\n\\n\\t// And a candidate that moves AFTER the state bound to the verdict is still\\n\\t// refused rather than silently rebound to wherever the worktree went.\\n\\tif err := os.WriteFile(filepath.Join(workspace, \\\"main.go\\\"),\\n\\t\\t[]byte(\\\"package main\\\\n\\\\nfunc main() { println(2) }\\\\n\\\"), 0o644); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\terr = e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, workspace, repo.WorktreeBranch(\\\"task-1\\\"))\\n\\tif err == nil {\\n\\t\\tt.Fatal(\\\"a candidate that moved after its verdict was minted anyway\\\")\\n\\t}\\n\\tif !strings.Contains(err.Error(), \\\"moved after it was reviewed\\\") {\\n\\t\\tt.Errorf(\\\"the refusal must name the movement, got %v\\\", err)\\n\\t}\\n}\\n\\n// The failure this replaces: binding the verdict to the PRE-validation capture\\n// refuses the accepted candidate at the mint, blaming movement that never\\n// happened. Pinned so a future re-ordering that reintroduces it is visible as\\n// this behaviour rather than as a mysterious refusal in a real run.\\nfunc TestThePreValidationCaptureIsNotTheReviewedState(t *testing.T) {\\n\\tctx := context.Background()\\n\\trepo, base := mintRepo(t)\\n\\tif err := os.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(unformatted), 0o644); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\n\\te := formattingEngine(t, repo)\\n\\te.beginReceipt(\\\"task-1\\\")\\n\\ttc := \u0026taskContext{Identity: candidateIdentityWithBase(base)}\\n\\n\\tbefore, err := repo.CandidateCapture(ctx, base, tc.Files)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif _, _, err := e.validate(ctx, \\\"task-1\\\", base, broker.New(e.Config.Permissions), repo, before.Diff, tc.Files); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\n\\te.noteReviewDelivered(\\\"task-1\\\", \\\"codex\\\", \\\"accept\\\", \\\"d1\\\", before.Tree)\\n\\terr = e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, repo.Root, \\\"\\\")\\n\\tif err == nil {\\n\\t\\tt.Fatal(\\\"the pre-validation tree minted, so the two captures are indistinguishable here\\\")\\n\\t}\\n\\tif !strings.Contains(err.Error(), \\\"moved after it was reviewed\\\") {\\n\\t\\tt.Fatalf(\\\"unexpected refusal: %v\\\", err)\\n\\t}\\n}\\n\\n// Fail closed on evidence about other bytes: the proof, the reviewed text and\\n// the content identity must be one claim, and a run that cannot show they are\\n// has no honest way to choose between them.\\nfunc TestValidationEvidenceAboutOtherBytesIsRefused(t *testing.T) {\\n\\trendered := \\\"diff --git a/x b/x\\\\n\\\"\\n\\tdigest := validation.Digest(rendered)\\n\\tcertifying := validation.Evidence{CandidateID: \\\"task-1\\\", DiffDigest: digest, Outcome: validation.Passed}\\n\\n\\tif err := certifiedAgainstCapture(validation.Bundle{\\n\\t\\tCandidateID: \\\"task-1\\\", DiffDigest: digest, Checks: []validation.Evidence{certifying},\\n\\t}, \\\"task-1\\\", rendered, rendered); err != nil {\\n\\t\\tt.Fatalf(\\\"evidence bound to exactly this rendering was refused: %v\\\", err)\\n\\t}\\n\\n\\tcases := map[string]struct {\\n\\t\\tbundle   validation.Bundle\\n\\t\\treturned string\\n\\t}{\\n\\t\\t\\\"the returned diff is not the canonical rendering\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: digest},\\n\\t\\t\\treturned: rendered + \\\"extra\\\\n\\\",\\n\\t\\t},\\n\\t\\t\\\"the bundle is bound to other content\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: validation.Digest(\\\"other\\\")},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t\\t\\\"the bundle is bound to another candidate\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-2\\\", DiffDigest: digest},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t\\t\\\"one check inside a well-bound bundle is stale\\\": {\\n\\t\\t\\tbundle: validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: digest, Checks: []validation.Evidence{\\n\\t\\t\\t\\tcertifying,\\n\\t\\t\\t\\t{CandidateID: \\\"task-1\\\", DiffDigest: validation.Digest(\\\"other\\\"), Outcome: validation.Passed, Kind: validation.Vet, Command: \\\"go\\\"},\\n\\t\\t\\t}},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t}\\n\\tfor name, tc := range cases {\\n\\t\\tt.Run(name, func(t *testing.T) {\\n\\t\\t\\tif err := certifiedAgainstCapture(tc.bundle, \\\"task-1\\\", rendered, tc.returned); err == nil {\\n\\t\\t\\t\\tt.Fatal(\\\"accepted validation evidence that does not speak about the reviewed bytes\\\")\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\\nfunc samePaths(got, want []string) bool {\\n\\tif len(got) != len(want) {\\n\\t\\treturn false\\n\\t}\\n\\tfor i := range got {\\n\\t\\tif got[i] != want[i] {\\n\\t\\t\\treturn false\\n\\t\\t}\\n\\t}\\n\\treturn true\\n}\\n\\nfunc readRecord(t *testing.T, path string) string {\\n\\tt.Helper()\\n\\tbody, err := os.ReadFile(path)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"the stub recorded nothing at %s: %v\\\", filepath.Base(path), err)\\n\\t}\\n\\treturn string(body)\\n}\\n\\n// stubMarker identifies a re-entry of this test binary as one of the\\n// deterministic processes the governed loop needs.\\nconst stubMarker = \\\"postvalidation-stub\\\"\\n\\n// stubProcess is the argv that re-enters this test binary in one stub role.\\n//\\n// The loop needs three real processes -- a worker, an independent reviewer and\\n// Sensei's MCP -- and cannot be driven without them. Re-entering the test\\n// binary keeps them deterministic and in this file, where what each one returns\\n// is visible beside the behaviour it is supposed to expose; building separate\\n// stub commands would put the interesting half somewhere else.\\nfunc stubProcess(t *testing.T, role, record string) (string, []string) {\\n\\tt.Helper()\\n\\texe, err := os.Executable()\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"locate this test binary to re-enter it as the %s stub: %v\\\", role, err)\\n\\t}\\n\\treturn exe, []string{\\\"-test.run=^TestPostValidationStubProcess$\\\", stubMarker, role, record}\\n}\\n\\n// TestPostValidationStubProcess is those processes. It is a subprocess entry\\n// point rather than a test: without the marker it skips, and with one it does\\n// its job and exits before the testing framework can write anything of its own\\n// onto a stream a caller is parsing.\\nfunc TestPostValidationStubProcess(t *testing.T) {\\n\\targs := flag.Args()\\n\\tif len(args) \u003c 3 || args[0] != stubMarker {\\n\\t\\tt.Skip(\\\"not a stub re-entry: this test is the subprocess entry point for the governed-loop regression\\\")\\n\\t}\\n\\trole, record := args[1], args[2]\\n\\tswitch role {\\n\\tcase \\\"implementor\\\":\\n\\t\\t// The prompt is read and discarded: a stub that varied with it would be\\n\\t\\t// a very small language model, and then a failure would be ambiguous.\\n\\t\\t// It must be drained, though -- a worker that exits without reading its\\n\\t\\t// prompt fails the parent's write, not its own exit status.\\n\\t\\t_, _ = io.Copy(io.Discard, os.Stdin)\\n\\t\\twd, err := os.Getwd()\\n\\t\\tif err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t\\t// Unformatted on purpose. This is the whole premise: the bytes the\\n\\t\\t// worker produces are not the bytes anyone will review.\\n\\t\\tif err := os.WriteFile(filepath.Join(wd, \\\"main.go\\\"), []byte(unformatted), 0o644); err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t\\tfmt.Println(\\\"wrote main.go and did not format it\\\")\\n\\tcase \\\"reviewer\\\":\\n\\t\\tprompt, err := io.ReadAll(os.Stdin)\\n\\t\\tif err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t\\t// What the reviewer received, kept so the test can read the bytes\\n\\t\\t// rather than the engine's claim about them.\\n\\t\\tif err := os.WriteFile(record, prompt, 0o644); err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t\\tfmt.Println(`{\\\"decision\\\":\\\"accept\\\",\\\"summary\\\":\\\"the candidate prints a number and touches nothing else\\\"}`)\\n\\tcase \\\"sensei\\\":\\n\\t\\tserveStubSensei(os.Stdin, os.Stdout, record)\\n\\tdefault:\\n\\t\\texitStub(fmt.Errorf(\\\"unknown stub role %q\\\", role))\\n\\t}\\n\\tos.Exit(0)\\n}\\n\\nfunc exitStub(err error) {\\n\\tfmt.Fprintln(os.Stderr, \\\"postvalidation stub:\\\", err)\\n\\tos.Exit(1)\\n}\\n\\n// serveStubSensei answers the MCP calls the candidate loop makes, in the\\n// Content-Length framing internal/sensei speaks.\\nfunc serveStubSensei(in io.Reader, out io.Writer, record string) {\\n\\tr := bufio.NewReader(in)\\n\\tfor {\\n\\t\\tbody, err := readStubFrame(r)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn\\n\\t\\t}\\n\\t\\tvar req struct {\\n\\t\\t\\tID     *int64 `json:\\\"id\\\"`\\n\\t\\t\\tMethod string `json:\\\"method\\\"`\\n\\t\\t\\tParams struct {\\n\\t\\t\\t\\tName      string         `json:\\\"name\\\"`\\n\\t\\t\\t\\tArguments map[string]any `json:\\\"arguments\\\"`\\n\\t\\t\\t} `json:\\\"params\\\"`\\n\\t\\t}\\n\\t\\tif json.Unmarshal(body, \u0026req) != nil || req.ID == nil {\\n\\t\\t\\t// A notification expects no reply, and an unparseable frame is not\\n\\t\\t\\t// one this stub can answer.\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tvar result any = map[string]any{}\\n\\t\\tswitch req.Method {\\n\\t\\tcase \\\"initialize\\\":\\n\\t\\t\\tresult = map[string]any{\\n\\t\\t\\t\\t\\\"protocolVersion\\\": \\\"2025-06-18\\\",\\n\\t\\t\\t\\t\\\"capabilities\\\":    map[string]any{},\\n\\t\\t\\t\\t\\\"serverInfo\\\":      map[string]any{\\\"name\\\": stubMarker, \\\"version\\\": \\\"0\\\"},\\n\\t\\t\\t}\\n\\t\\tcase \\\"tools/call\\\":\\n\\t\\t\\tresult = stubTool(req.Params.Name, req.Params.Arguments, record)\\n\\t\\t}\\n\\t\\tif err := writeStubFrame(out, map[string]any{\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": *req.ID, \\\"result\\\": result}); err != nil {\\n\\t\\t\\treturn\\n\\t\\t}\\n\\t}\\n}\\n\\n// stubTool passes every candidate and records the diff the audit was given.\\n// Passing is what makes the identity question the only one this test asks.\\nfunc stubTool(name string, args map[string]any, record string) map[string]any {\\n\\tif name != \\\"awareness_audit_diff\\\" {\\n\\t\\treturn map[string]any{\\n\\t\\t\\t\\\"content\\\":           []map[string]string{{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"the stub graph holds nothing about this\\\"}},\\n\\t\\t\\t\\\"structuredContent\\\": map[string]any{},\\n\\t\\t}\\n\\t}\\n\\tdiff, _ := args[\\\"diff\\\"].(string)\\n\\tif record != \\\"\\\" {\\n\\t\\tif err := os.WriteFile(record, []byte(diff), 0o644); err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t}\\n\\treturn map[string]any{\\n\\t\\t\\\"content\\\": []map[string]string{{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"audit: pass\\\"}},\\n\\t\\t\\\"structuredContent\\\": map[string]any{\\n\\t\\t\\t\\\"schema\\\":            \\\"sensei.audit.diff.v1\\\",\\n\\t\\t\\t\\\"decision\\\":          \\\"pass\\\",\\n\\t\\t\\t\\\"availability\\\":      \\\"available\\\",\\n\\t\\t\\t\\\"input_diff_digest\\\": validation.Digest(diff),\\n\\t\\t},\\n\\t}\\n}\\n\\nfunc readStubFrame(r *bufio.Reader) ([]byte, error) {\\n\\tlength := -1\\n\\tfor {\\n\\t\\tline, err := r.ReadString('\\\\n')\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t\\tline = strings.TrimRight(line, \\\"\\\\r\\\\n\\\")\\n\\t\\tif line == \\\"\\\" {\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t\\tif parts := strings.SplitN(line, \\\":\\\", 2); len(parts) == 2 \u0026\u0026\\n\\t\\t\\tstrings.EqualFold(strings.TrimSpace(parts[0]), \\\"Content-Length\\\") {\\n\\t\\t\\tif length, err = strconv.Atoi(strings.TrimSpace(parts[1])); err != nil {\\n\\t\\t\\t\\treturn nil, err\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tif length \u003c 0 {\\n\\t\\treturn nil, fmt.Errorf(\\\"frame without a Content-Length\\\")\\n\\t}\\n\\tbody := make([]byte, length)\\n\\t_, err := io.ReadFull(r, body)\\n\\treturn body, err\\n}\\n\\nfunc writeStubFrame(w io.Writer, v any) error {\\n\\tbody, err := json.Marshal(v)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif _, err := fmt.Fprintf(w, \\\"Content-Length: %d\\\\r\\\\n\\\\r\\\\n\\\", len(body)); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\t_, err = w.Write(body)\\n\\treturn err\\n}\\n\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":3806,\"cache_read_input_tokens\":161764,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":3806},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"47ddc484-692a-4f5a-bbc9-2959e876fb15\",\"uuid\":\"a567ab85-4b64-4c12-a1ca-785a396719b2\",\"timestamp\":\"2026-08-30T08:02:01.826Z\",\"request_id\":\"req_011CeYaewnhEJGDgXyFWrpUt\"}","payload":{"stream":"stdout"}}
{"id":"20260830T080201.912575568Z-6e4fd4ea","time":"2026-08-30T08:02:01.912575568Z","session_id":"session-20260830T072521.605271812Z","task_id":"task-1788074721605515483","source":"claude","kind":"output","summary":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_019v2e5UnkvMpXFennCoPGKr\",\"type\":\"tool_result\",\"content\":\"The file /tmp/claude-1000/-home-dave-Documents-github-com-globulario-sensei-code/0c05292b-ad66-420a-9985-54db3e81471f/scratchpad/j1r/.subject-worktrees/task-1788074721605515483/internal/workflow/postvalidation_test.go has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"47ddc484-692a-4f5a-bbc9-2959e876fb15\",\"uuid\":\"4daa7ccd-2637-413f-9bec-041e4f1861a1\",\"timestamp\":\"2026-08-30T08:02:01.910Z\",\"tool_use_result\":{\"type\":\"update\",\"filePath\":\"/tmp/claude-1000/-home-dave-Documents-github-com-globulario-sensei-code/0c05292b-ad66-420a-9985-54db3e81471f/scratchpad/j1r/.subject-worktrees/task-1788074721605515483/internal/workflow/postvalidation_test.go\",\"content\":\"package workflow\\n\\n// Validation can rewrite the candidate.\\n//\\n// A configured formatter is not an observer: it edits the worktree, and every\\n// measurement taken before it describes bytes that no longer exist. The run\\n// used to freeze its content identity BEFORE validation and re-read only the\\n// diff afterwards, so the reviewer read post-format text while the tree bound\\n// to the verdict was the pre-format one. The mint re-measured the worktree,\\n// found the post-format tree, and refused an accepted candidate that had not\\n// moved since its verdict -- naming candidate movement as the cause of a\\n// disagreement the run had created itself.\\n//\\n// The first test here drives the real loop -- runCandidate, its audit call, its\\n// review packet, its verdict binding -- with a formatter that actually rewrites\\n// the candidate, because that is the only place the production binding exists.\\n// A test that assembled validate → capture → noteReviewDelivered → mint by hand\\n// would stay green with the loop's binding removed, which is exactly the defect\\n// under repair. The rest hold the two ends: a candidate that moves after the\\n// state bound to the verdict is still refused, and evidence about other bytes\\n// is refused rather than reconciled.\\n\\nimport (\\n\\t\\\"bufio\\\"\\n\\t\\\"context\\\"\\n\\t\\\"encoding/json\\\"\\n\\t\\\"flag\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io\\\"\\n\\t\\\"os\\\"\\n\\t\\\"os/exec\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"strconv\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/globulario/sensei-code/internal/broker\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/config\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/gitx\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/sensei\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/validation\\\"\\n)\\n\\n// unformatted is Go that compiles and that gofmt WILL rewrite, so the formatter\\n// step is a real mutation rather than a no-op that would pass either way.\\nconst unformatted = \\\"package main\\\\n\\\\nfunc main() {\\\\nprintln( 1 )\\\\n}\\\\n\\\"\\n\\n// The same statement before and after gofmt. Every question of the form \\\"which\\n// bytes did this role actually receive\\\" is answered with these two, because\\n// they survive into a diff and into a prompt where a tree digest does not.\\nconst (\\n\\tunformattedMark = \\\"println( 1 )\\\"\\n\\tformattedMark   = \\\"println(1)\\\"\\n)\\n\\n// formattingEngine is the governed loop's validation configuration, reduced to\\n// the one check that mutates and the one that certifies the result.\\nfunc formattingEngine(t *testing.T, repo gitx.Repo) *Engine {\\n\\tt.Helper()\\n\\trequireGofmt(t)\\n\\te := \u0026Engine{Repo: repo}\\n\\te.Config.Permissions.RunFormatters = true\\n\\te.Config.Permissions.LocalCommit = true\\n\\te.Config.Validation = formattingValidation()\\n\\treturn e\\n}\\n\\nfunc formattingValidation() config.Validation {\\n\\treturn config.Validation{\\n\\t\\tFormat:       []config.Command{{Command: \\\"gofmt\\\", Args: []string{\\\"-w\\\", \\\"main.go\\\"}}},\\n\\t\\tFormatVerify: []config.Command{{Command: \\\"gofmt\\\", Args: []string{\\\"-l\\\", \\\"main.go\\\"}, FailIfOutput: true}},\\n\\t}\\n}\\n\\nfunc requireGofmt(t *testing.T) {\\n\\tt.Helper()\\n\\tif _, err := exec.LookPath(\\\"gofmt\\\"); err != nil {\\n\\t\\tt.Skip(\\\"gofmt is not on PATH, so no formatter can rewrite the candidate here\\\")\\n\\t}\\n}\\n\\n// The payoff, in the loop that actually runs: a worker writes unformatted Go,\\n// validation rewrites it, and every downstream identity -- the audited diff,\\n// the review packet, the verdict's tree and digest, the recorded path set, the\\n// minted commit -- is the state the formatter produced. Then the other end: a\\n// worktree that moves after that verdict is refused rather than rebound.\\n//\\n// This fails if runCandidate stops re-capturing after validation, or stops\\n// assigning that capture over the pre-validation one: the verdict would carry\\n// the tree of bytes nobody reviewed, and the mint would refuse a candidate that\\n// never moved.\\nfunc TestTheGovernedLoopBindsTheCandidateTheFormatterProduced(t *testing.T) {\\n\\tctx := context.Background()\\n\\trequireGofmt(t)\\n\\n\\trepo, base := mintRepo(t)\\n\\tworkspace, err := repo.CreateWorktreeAt(ctx, \\\"task-1\\\", base)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"create the candidate worktree: %v\\\", err)\\n\\t}\\n\\n\\t// What each stub was handed, written down so the test reads the bytes the\\n\\t// role received rather than the bytes the engine says it sent.\\n\\trecord := t.TempDir()\\n\\treviewerSaw := filepath.Join(record, \\\"review-prompt.txt\\\")\\n\\tauditSaw := filepath.Join(record, \\\"audited-diff.txt\\\")\\n\\n\\timplCommand, implArgs := stubProcess(t, \\\"implementor\\\", \\\"\\\")\\n\\treviewCommand, reviewArgs := stubProcess(t, \\\"reviewer\\\", reviewerSaw)\\n\\tsenseiCommand, senseiArgs := stubProcess(t, \\\"sensei\\\", auditSaw)\\n\\n\\tsc, err := sensei.Start(ctx, repo.Root, senseiCommand, senseiArgs)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"start the stub Sensei MCP: %v\\\", err)\\n\\t}\\n\\tdefer sc.Close()\\n\\n\\tworker := config.Agent{Name: \\\"claude\\\", Command: implCommand, Args: implArgs, Graph: \\\"none\\\"}\\n\\te := \u0026Engine{Repo: repo, SessionID: \\\"session-1\\\"}\\n\\te.Config.Permissions = config.Permissions{\\n\\t\\tReadRepository: true, WriteCandidates: true, CreateWorktrees: true,\\n\\t\\tRunFormatters: true, LocalCommit: true,\\n\\t}\\n\\te.Config.Workflow.ReviewCycles = 1\\n\\te.Config.Validation = formattingValidation()\\n\\te.Config.Implementors = []config.Agent{worker}\\n\\te.Config.Reviewer = config.Agent{Name: \\\"codex\\\", Command: reviewCommand, Args: reviewArgs, Graph: \\\"none\\\"}\\n\\te.beginReceipt(\\\"task-1\\\")\\n\\n\\ttc := \u0026taskContext{\\n\\t\\tTask:     \\\"print a number from main\\\",\\n\\t\\tMode:     ModeModify,\\n\\t\\tFiles:    []string{\\\"main.go\\\"},\\n\\t\\tIdentity: candidateIdentityWithBase(base),\\n\\t}\\n\\taccepted, _, _, _, err := e.runCandidate(ctx, sc, certifiedStart{}, \\\"task-1\\\", tc,\\n\\t\\t\\\"Rewrite main.go so it prints a number.\\\", worker, workspace, \\\"\\\")\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"the governed candidate loop failed: %v\\\", err)\\n\\t}\\n\\tif !accepted {\\n\\t\\tt.Fatal(\\\"the loop did not accept the candidate, so nothing was bound to a verdict\\\")\\n\\t}\\n\\n\\t// The state the formatter left behind, measured the way the mint measures.\\n\\tcandidate := gitx.Repo{Root: workspace}\\n\\treviewed, err := candidate.CandidateCapture(ctx, base, tc.Files)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\t// Without a real rewrite the pre- and post-validation captures are the same\\n\\t// object and this test cannot tell them apart.\\n\\tif !strings.Contains(reviewed.Diff, formattedMark) || strings.Contains(reviewed.Diff, unformattedMark) {\\n\\t\\tt.Fatalf(\\\"validation did not rewrite the worker's bytes, so this test distinguishes nothing:\\\\n%s\\\", reviewed.Diff)\\n\\t}\\n\\n\\t// What Sensei was asked to audit.\\n\\tif audited := readRecord(t, auditSaw); audited != reviewed.Diff {\\n\\t\\tt.Errorf(\\\"the audit judged bytes that are not the post-validation candidate:\\\\n%s\\\", audited)\\n\\t}\\n\\n\\t// What the reviewer read, and the revision the packet bound it to.\\n\\tprompt := readRecord(t, reviewerSaw)\\n\\tif strings.Contains(prompt, unformattedMark) {\\n\\t\\tt.Error(\\\"the reviewer was handed the pre-validation bytes\\\")\\n\\t}\\n\\tif !strings.Contains(prompt, formattedMark) {\\n\\t\\tt.Error(\\\"the reviewer was not handed the post-validation candidate\\\")\\n\\t}\\n\\tif revision := candidateRevision(reviewed.Diff); !strings.Contains(prompt, revision) {\\n\\t\\tt.Errorf(\\\"the review packet does not name the post-validation revision %s\\\", shortDigest(revision))\\n\\t}\\n\\n\\t// The content identity the delivered verdict is bound to.\\n\\ttree, ok := e.reviewedTreeFor(\\\"task-1\\\")\\n\\tif !ok {\\n\\t\\tt.Fatal(\\\"the loop recorded no reviewed tree, so no verdict bound a content identity\\\")\\n\\t}\\n\\tif tree != reviewed.Tree {\\n\\t\\tt.Fatalf(\\\"the verdict is bound to tree %s and the reviewed state is %s\\\",\\n\\t\\t\\tshortDigest(tree), shortDigest(reviewed.Tree))\\n\\t}\\n\\tif digest := e.reviewedDigestFor(\\\"task-1\\\"); digest != candidateRevision(reviewed.Diff) {\\n\\t\\tt.Errorf(\\\"the verdict names revision %s, not the post-validation candidate's %s\\\",\\n\\t\\t\\tshortDigest(digest), shortDigest(candidateRevision(reviewed.Diff)))\\n\\t}\\n\\t// The exact path set travels with it: the capture's, not a re-parse of an\\n\\t// older diff.\\n\\tif got, want := tc.EvidenceSnapshot.ChangedPaths, reviewed.Paths; !samePaths(got, want) {\\n\\t\\tt.Errorf(\\\"the recorded path set is %v, and the post-validation capture holds %v\\\", got, want)\\n\\t}\\n\\n\\t// That exact state mints, and the identity reconstructs from (base, tree).\\n\\tif err := e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, workspace, repo.WorktreeBranch(\\\"task-1\\\")); err != nil {\\n\\t\\tt.Fatalf(\\\"the accepted post-validation state could not be minted: %v\\\", err)\\n\\t}\\n\\tif err := candidate.VerifyCanonicalCommit(ctx, base, reviewed.Tree, e.candidateCommitFor(\\\"task-1\\\")); err != nil {\\n\\t\\tt.Fatalf(\\\"the minted identity does not reconstruct from the reviewed state: %v\\\", err)\\n\\t}\\n\\n\\t// And a candidate that moves AFTER the state bound to the verdict is still\\n\\t// refused rather than silently rebound to wherever the worktree went.\\n\\tif err := os.WriteFile(filepath.Join(workspace, \\\"main.go\\\"),\\n\\t\\t[]byte(\\\"package main\\\\n\\\\nfunc main() { println(2) }\\\\n\\\"), 0o644); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\terr = e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, workspace, repo.WorktreeBranch(\\\"task-1\\\"))\\n\\tif err == nil {\\n\\t\\tt.Fatal(\\\"a candidate that moved after its verdict was minted anyway\\\")\\n\\t}\\n\\tif !strings.Contains(err.Error(), \\\"moved after it was reviewed\\\") {\\n\\t\\tt.Errorf(\\\"the refusal must name the movement, got %v\\\", err)\\n\\t}\\n}\\n\\n// The failure this replaces: binding the verdict to the PRE-validation capture\\n// refuses the accepted candidate at the mint, blaming movement that never\\n// happened. Pinned so a future re-ordering that reintroduces it is visible as\\n// this behaviour rather than as a mysterious refusal in a real run.\\nfunc TestThePreValidationCaptureIsNotTheReviewedState(t *testing.T) {\\n\\tctx := context.Background()\\n\\trepo, base := mintRepo(t)\\n\\tif err := os.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(unformatted), 0o644); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\n\\te := formattingEngine(t, repo)\\n\\te.beginReceipt(\\\"task-1\\\")\\n\\ttc := \u0026taskContext{Identity: candidateIdentityWithBase(base)}\\n\\n\\tbefore, err := repo.CandidateCapture(ctx, base, tc.Files)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif _, _, err := e.validate(ctx, \\\"task-1\\\", base, broker.New(e.Config.Permissions), repo, before.Diff, tc.Files); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\n\\te.noteReviewDelivered(\\\"task-1\\\", \\\"codex\\\", \\\"accept\\\", \\\"d1\\\", before.Tree)\\n\\terr = e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, repo.Root, \\\"\\\")\\n\\tif err == nil {\\n\\t\\tt.Fatal(\\\"the pre-validation tree minted, so the two captures are indistinguishable here\\\")\\n\\t}\\n\\tif !strings.Contains(err.Error(), \\\"moved after it was reviewed\\\") {\\n\\t\\tt.Fatalf(\\\"unexpected refusal: %v\\\", err)\\n\\t}\\n}\\n\\n// Fail closed on evidence about other bytes: the proof, the reviewed text and\\n// the content identity must be one claim, and a run that cannot show they are\\n// has no honest way to choose between them.\\nfunc TestValidationEvidenceAboutOtherBytesIsRefused(t *testing.T) {\\n\\trendered := \\\"diff --git a/x b/x\\\\n\\\"\\n\\tdigest := validation.Digest(rendered)\\n\\tcertifying := validation.Evidence{CandidateID: \\\"task-1\\\", DiffDigest: digest, Outcome: validation.Passed}\\n\\n\\tif err := certifiedAgainstCapture(validation.Bundle{\\n\\t\\tCandidateID: \\\"task-1\\\", DiffDigest: digest, Checks: []validation.Evidence{certifying},\\n\\t}, \\\"task-1\\\", rendered, rendered); err != nil {\\n\\t\\tt.Fatalf(\\\"evidence bound to exactly this rendering was refused: %v\\\", err)\\n\\t}\\n\\n\\tcases := map[string]struct {\\n\\t\\tbundle   validation.Bundle\\n\\t\\treturned string\\n\\t}{\\n\\t\\t\\\"the returned diff is not the canonical rendering\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: digest},\\n\\t\\t\\treturned: rendered + \\\"extra\\\\n\\\",\\n\\t\\t},\\n\\t\\t\\\"the bundle is bound to other content\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: validation.Digest(\\\"other\\\")},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t\\t\\\"the bundle is bound to another candidate\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-2\\\", DiffDigest: digest},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t\\t\\\"one check inside a well-bound bundle is stale\\\": {\\n\\t\\t\\tbundle: validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: digest, Checks: []validation.Evidence{\\n\\t\\t\\t\\tcertifying,\\n\\t\\t\\t\\t{CandidateID: \\\"task-1\\\", DiffDigest: validation.Digest(\\\"other\\\"), Outcome: validation.Passed, Kind: validation.Vet, Command: \\\"go\\\"},\\n\\t\\t\\t}},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t}\\n\\tfor name, tc := range cases {\\n\\t\\tt.Run(name, func(t *testing.T) {\\n\\t\\t\\tif err := certifiedAgainstCapture(tc.bundle, \\\"task-1\\\", rendered, tc.returned); err == nil {\\n\\t\\t\\t\\tt.Fatal(\\\"accepted validation evidence that does not speak about the reviewed bytes\\\")\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\\nfunc samePaths(got, want []string) bool {\\n\\tif len(got) != len(want) {\\n\\t\\treturn false\\n\\t}\\n\\tfor i := range got {\\n\\t\\tif got[i] != want[i] {\\n\\t\\t\\treturn false\\n\\t\\t}\\n\\t}\\n\\treturn true\\n}\\n\\nfunc readRecord(t *testing.T, path string) string {\\n\\tt.Helper()\\n\\tbody, err := os.ReadFile(path)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"the stub recorded nothing at %s: %v\\\", filepath.Base(path), err)\\n\\t}\\n\\treturn string(body)\\n}\\n\\n// stubMarker identifies a re-entry of this test binary as one of the\\n// deterministic processes the governed loop needs.\\nconst stubMarker = \\\"postvalidation-stub\\\"\\n\\n// stubProcess is the argv that re-enters this test binary in one stub role.\\n//\\n// The loop needs three real processes -- a worker, an independent reviewer and\\n// Sensei's MCP -- and cannot be driven without them. Re-entering the test\\n// binary keeps them deterministic and in this file, where what each one returns\\n// is visible beside the behaviour it is supposed to expose; building separate\\n// stub commands would put the interesting half somewhere else.\\nfunc stubProcess(t *testing.T, role, record string) (string, []string) {\\n\\tt.Helper()\\n\\texe, err := os.Executable()\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"locate this test binary to re-enter it as the %s stub: %v\\\", role, err)\\n\\t}\\n\\treturn exe, []string{\\\"-test.run=^TestPostValidationStubProcess$\\\", stubMarker, role, record}\\n}\\n\\n// TestPostValidationStubProcess is those processes. It is a subprocess entry\\n// point rather than a test: without the marker it skips, and with one it does\\n// its job and exits before the testing framework can write anything of its own\\n// onto a stream a caller is parsing.\\nfunc TestPostValidationStubProcess(t *testing.T) {\\n\\targs := flag.Args()\\n\\tif len(args) \u003c 3 || args[0] != stubMarker {\\n\\t\\tt.Skip(\\\"not a stub re-entry: this test is the subprocess entry point for the governed-loop regression\\\")\\n\\t}\\n\\trole, record := args[1], args[2]\\n\\tswitch role {\\n\\tcase \\\"implementor\\\":\\n\\t\\t// The prompt is read and discarded: a stub that varied with it would be\\n\\t\\t// a very small language model, and then a failure would be ambiguous.\\n\\t\\t// It must be drained, though -- a worker that exits without reading its\\n\\t\\t// prompt fails the parent's write, not its own exit status.\\n\\t\\t_, _ = io.Copy(io.Discard, os.Stdin)\\n\\t\\twd, err := os.Getwd()\\n\\t\\tif err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t\\t// Unformatted on purpose. This is the whole premise: the bytes the\\n\\t\\t// worker produces are not the bytes anyone will review.\\n\\t\\tif err := os.WriteFile(filepath.Join(wd, \\\"main.go\\\"), []byte(unformatted), 0o644); err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t\\tfmt.Println(\\\"wrote main.go and did not format it\\\")\\n\\tcase \\\"reviewer\\\":\\n\\t\\tprompt, err := io.ReadAll(os.Stdin)\\n\\t\\tif err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t\\t// What the reviewer received, kept so the test can read the bytes\\n\\t\\t// rather than the engine's claim about them.\\n\\t\\tif err := os.WriteFile(record, prompt, 0o644); err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t\\tfmt.Println(`{\\\"decision\\\":\\\"accept\\\",\\\"summary\\\":\\\"the candidate prints a number and touches nothing else\\\"}`)\\n\\tcase \\\"sensei\\\":\\n\\t\\tserveStubSensei(os.Stdin, os.Stdout, record)\\n\\tdefault:\\n\\t\\texitStub(fmt.Errorf(\\\"unknown stub role %q\\\", role))\\n\\t}\\n\\tos.Exit(0)\\n}\\n\\nfunc exitStub(err error) {\\n\\tfmt.Fprintln(os.Stderr, \\\"postvalidation stub:\\\", err)\\n\\tos.Exit(1)\\n}\\n\\n// serveStubSensei answers the MCP calls the candidate loop makes, in the\\n// Content-Length framing internal/sensei speaks.\\nfunc serveStubSensei(in io.Reader, out io.Writer, record string) {\\n\\tr := bufio.NewReader(in)\\n\\tfor {\\n\\t\\tbody, err := readStubFrame(r)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn\\n\\t\\t}\\n\\t\\tvar req struct {\\n\\t\\t\\tID     *int64 `json:\\\"id\\\"`\\n\\t\\t\\tMethod string `json:\\\"method\\\"`\\n\\t\\t\\tParams struct {\\n\\t\\t\\t\\tName      string         `json:\\\"name\\\"`\\n\\t\\t\\t\\tArguments map[string]any `json:\\\"arguments\\\"`\\n\\t\\t\\t} `json:\\\"params\\\"`\\n\\t\\t}\\n\\t\\tif json.Unmarshal(body, \u0026req) != nil || req.ID == nil {\\n\\t\\t\\t// A notification expects no reply, and an unparseable frame is not\\n\\t\\t\\t// one this stub can answer.\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tvar result any = map[string]any{}\\n\\t\\tswitch req.Method {\\n\\t\\tcase \\\"initialize\\\":\\n\\t\\t\\tresult = map[string]any{\\n\\t\\t\\t\\t\\\"protocolVersion\\\": \\\"2025-06-18\\\",\\n\\t\\t\\t\\t\\\"capabilities\\\":    map[string]any{},\\n\\t\\t\\t\\t\\\"serverInfo\\\":      map[string]any{\\\"name\\\": stubMarker, \\\"version\\\": \\\"0\\\"},\\n\\t\\t\\t}\\n\\t\\tcase \\\"tools/call\\\":\\n\\t\\t\\tresult = stubTool(req.Params.Name, req.Params.Arguments, record)\\n\\t\\t}\\n\\t\\tif err := writeStubFrame(out, map[string]any{\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": *req.ID, \\\"result\\\": result}); err != nil {\\n\\t\\t\\treturn\\n\\t\\t}\\n\\t}\\n}\\n\\n// stubTool passes every candidate and records the diff the audit was given.\\n// Passing is what makes the identity question the only one this test asks.\\nfunc stubTool(name string, args map[string]any, record string) map[string]any {\\n\\tif name != \\\"awareness_audit_diff\\\" {\\n\\t\\treturn map[string]any{\\n\\t\\t\\t\\\"content\\\":           []map[string]string{{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"the stub graph holds nothing about this\\\"}},\\n\\t\\t\\t\\\"structuredContent\\\": map[string]any{},\\n\\t\\t}\\n\\t}\\n\\tdiff, _ := args[\\\"diff\\\"].(string)\\n\\tif record != \\\"\\\" {\\n\\t\\tif err := os.WriteFile(record, []byte(diff), 0o644); err != nil {\\n\\t\\t\\texitStub(err)\\n\\t\\t}\\n\\t}\\n\\treturn map[string]any{\\n\\t\\t\\\"content\\\": []map[string]string{{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"audit: pass\\\"}},\\n\\t\\t\\\"structuredContent\\\": map[string]any{\\n\\t\\t\\t\\\"schema\\\":            \\\"sensei.audit.diff.v1\\\",\\n\\t\\t\\t\\\"decision\\\":          \\\"pass\\\",\\n\\t\\t\\t\\\"availability\\\":      \\\"available\\\",\\n\\t\\t\\t\\\"input_diff_digest\\\": validation.Digest(diff),\\n\\t\\t},\\n\\t}\\n}\\n\\nfunc readStubFrame(r *bufio.Reader) ([]byte, error) {\\n\\tlength := -1\\n\\tfor {\\n\\t\\tline, err := r.ReadString('\\\\n')\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t\\tline = strings.TrimRight(line, \\\"\\\\r\\\\n\\\")\\n\\t\\tif line == \\\"\\\" {\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t\\tif parts := strings.SplitN(line, \\\":\\\", 2); len(parts) == 2 \u0026\u0026\\n\\t\\t\\tstrings.EqualFold(strings.TrimSpace(parts[0]), \\\"Content-Length\\\") {\\n\\t\\t\\tif length, err = strconv.Atoi(strings.TrimSpace(parts[1])); err != nil {\\n\\t\\t\\t\\treturn nil, err\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tif length \u003c 0 {\\n\\t\\treturn nil, fmt.Errorf(\\\"frame without a Content-Length\\\")\\n\\t}\\n\\tbody := make([]byte, length)\\n\\t_, err := io.ReadFull(r, body)\\n\\treturn body, err\\n}\\n\\nfunc writeStubFrame(w io.Writer, v any) error {\\n\\tbody, err := json.Marshal(v)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif _, err := fmt.Fprintf(w, \\\"Content-Length: %d\\\\r\\\\n\\\\r\\\\n\\\", len(body)); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\t_, err = w.Write(body)\\n\\treturn err\\n}\\n\",\"structuredPatch\":[{\"oldStart\":11,\"oldLines\":21,\"newStart\":11,\"newLines\":33,\"lines\":[\" // moved since its verdict -- naming candidate movement as the cause of a\",\" // disagreement the run had created itself.\",\" //\",\"-// These tests hold both ends: the exact post-validation state the reviewer\",\"-// received mints canonically, and a candidate that moves after that state is\",\"-// still refused.\",\"+// The first test here drives the real loop -- runCandidate, its audit call, its\",\"+// review packet, its verdict binding -- with a formatter that actually rewrites\",\"+// the candidate, because that is the only place the production binding exists.\",\"+// A test that assembled validate → capture → noteReviewDelivered → mint by hand\",\"+// would stay green with the loop's binding removed, which is exactly the defect\",\"+// under repair. The rest hold the two ends: a candidate that moves after the\",\"+// state bound to the verdict is still refused, and evidence about other bytes\",\"+// is refused rather than reconciled.\",\" \",\" import (\",\"+  \\\"bufio\\\"\",\"   \\\"context\\\"\",\"+  \\\"encoding/json\\\"\",\"+  \\\"flag\\\"\",\"+  \\\"fmt\\\"\",\"+  \\\"io\\\"\",\"   \\\"os\\\"\",\"   \\\"os/exec\\\"\",\"   \\\"path/filepath\\\"\",\"+  \\\"strconv\\\"\",\"   \\\"strings\\\"\",\"   \\\"testing\\\"\",\" \",\"   \\\"github.com/globulario/sensei-code/internal/broker\\\"\",\"   \\\"github.com/globulario/sensei-code/internal/config\\\"\",\"   \\\"github.com/globulario/sensei-code/internal/gitx\\\"\",\"+  \\\"github.com/globulario/sensei-code/internal/sensei\\\"\",\"   \\\"github.com/globulario/sensei-code/internal/validation\\\"\",\" )\",\" \"]},{\"oldStart\":33,\"oldLines\":79,\"newStart\":45,\"newLines\":166,\"lines\":[\" // step is a real mutation rather than a no-op that would pass either way.\",\" const unformatted = \\\"package main\\\\n\\\\nfunc main() {\\\\nprintln( 1 )\\\\n}\\\\n\\\"\",\" \",\"+// The same statement before and after gofmt. Every question of the form \\\"which\",\"+// bytes did this role actually receive\\\" is answered with these two, because\",\"+// they survive into a diff and into a prompt where a tree digest does not.\",\"+const (\",\"+  unformattedMark = \\\"println( 1 )\\\"\",\"+  formattedMark   = \\\"println(1)\\\"\",\"+)\",\"+\",\" // formattingEngine is the governed loop's validation configuration, reduced to\",\" // the one check that mutates and the one that certifies the result.\",\" func formattingEngine(t *testing.T, repo gitx.Repo) *Engine {\",\"   t.Helper()\",\"-  if _, err := exec.LookPath(\\\"gofmt\\\"); err != nil {\",\"-    t.Skip(\\\"gofmt is not on PATH, so no formatter can rewrite the candidate here\\\")\",\"-  }\",\"+  requireGofmt(t)\",\"   e := \u0026Engine{Repo: repo}\",\"   e.Config.Permissions.RunFormatters = true\",\"   e.Config.Permissions.LocalCommit = true\",\"-  e.Config.Validation = config.Validation{\",\"+  e.Config.Validation = formattingValidation()\",\"+  return e\",\"+}\",\"+\",\"+func formattingValidation() config.Validation {\",\"+  return config.Validation{\",\"     Format:       []config.Command{{Command: \\\"gofmt\\\", Args: []string{\\\"-w\\\", \\\"main.go\\\"}}},\",\"     FormatVerify: []config.Command{{Command: \\\"gofmt\\\", Args: []string{\\\"-l\\\", \\\"main.go\\\"}, FailIfOutput: true}},\",\"   }\",\"-  return e\",\" }\",\" \",\"-// The payoff: the state the reviewer actually received is the state that mints.\",\"-func TestTheTreeAFormatterProducedIsTheTreeThatMints(t *testing.T) {\",\"+func requireGofmt(t *testing.T) {\",\"+  t.Helper()\",\"+  if _, err := exec.LookPath(\\\"gofmt\\\"); err != nil {\",\"+    t.Skip(\\\"gofmt is not on PATH, so no formatter can rewrite the candidate here\\\")\",\"+  }\",\"+}\",\"+\",\"+// The payoff, in the loop that actually runs: a worker writes unformatted Go,\",\"+// validation rewrites it, and every downstream identity -- the audited diff,\",\"+// the review packet, the verdict's tree and digest, the recorded path set, the\",\"+// minted commit -- is the state the formatter produced. Then the other end: a\",\"+// worktree that moves after that verdict is refused rather than rebound.\",\"+//\",\"+// This fails if runCandidate stops re-capturing after validation, or stops\",\"+// assigning that capture over the pre-validation one: the verdict would carry\",\"+// the tree of bytes nobody reviewed, and the mint would refuse a candidate that\",\"+// never moved.\",\"+func TestTheGovernedLoopBindsTheCandidateTheFormatterProduced(t *testing.T) {\",\"   ctx := context.Background()\",\"+  requireGofmt(t)\",\"+\",\"   repo, base := mintRepo(t)\",\"-  os.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(unformatted), 0o644)\",\"+  workspace, err := repo.CreateWorktreeAt(ctx, \\\"task-1\\\", base)\",\"+  if err != nil {\",\"+    t.Fatalf(\\\"create the candidate worktree: %v\\\", err)\",\"+  }\",\" \",\"-  e := formattingEngine(t, repo)\",\"-  e.beginReceipt(\\\"task-1\\\")\",\"-  tc := \u0026taskContext{Identity: candidateIdentityWithBase(base)}\",\"+  // What each stub was handed, written down so the test reads the bytes the\",\"+  // role received rather than the bytes the engine says it sent.\",\"+  record := t.TempDir()\",\"+  reviewerSaw := filepath.Join(record, \\\"review-prompt.txt\\\")\",\"+  auditSaw := filepath.Join(record, \\\"audited-diff.txt\\\")\",\" \",\"-  // What the loop captures before validation runs.\",\"-  before, err := repo.CandidateCapture(ctx, base, tc.Files)\",\"+  implCommand, implArgs := stubProcess(t, \\\"implementor\\\", \\\"\\\")\",\"+  reviewCommand, reviewArgs := stubProcess(t, \\\"reviewer\\\", reviewerSaw)\",\"+  senseiCommand, senseiArgs := stubProcess(t, \\\"sensei\\\", auditSaw)\",\"+\",\"+  sc, err := sensei.Start(ctx, repo.Root, senseiCommand, senseiArgs)\",\"   if err != nil {\",\"-    t.Fatal(err)\",\"+    t.Fatalf(\\\"start the stub Sensei MCP: %v\\\", err)\",\"   }\",\"-  evidence, diff, err := e.validate(ctx, \\\"task-1\\\", base, broker.New(e.Config.Permissions), repo, before.Diff, tc.Files)\",\"+  defer sc.Close()\",\"+\",\"+  worker := config.Agent{Name: \\\"claude\\\", Command: implCommand, Args: implArgs, Graph: \\\"none\\\"}\",\"+  e := \u0026Engine{Repo: repo, SessionID: \\\"session-1\\\"}\",\"+  e.Config.Permissions = config.Permissions{\",\"+    ReadRepository: true, WriteCandidates: true, CreateWorktrees: true,\",\"+    RunFormatters: true, LocalCommit: true,\",\"+  }\",\"+  e.Config.Workflow.ReviewCycles = 1\",\"+  e.Config.Validation = formattingValidation()\",\"+  e.Config.Implementors = []config.Agent{worker}\",\"+  e.Config.Reviewer = config.Agent{Name: \\\"codex\\\", Command: reviewCommand, Args: reviewArgs, Graph: \\\"none\\\"}\",\"+  e.beginReceipt(\\\"task-1\\\")\",\"+\",\"+  tc := \u0026taskContext{\",\"+    Task:     \\\"print a number from main\\\",\",\"+    Mode:     ModeModify,\",\"+    Files:    []string{\\\"main.go\\\"},\",\"+    Identity: candidateIdentityWithBase(base),\",\"+  }\",\"+  accepted, _, _, _, err := e.runCandidate(ctx, sc, certifiedStart{}, \\\"task-1\\\", tc,\",\"+    \\\"Rewrite main.go so it prints a number.\\\", worker, workspace, \\\"\\\")\",\"   if err != nil {\",\"-    t.Fatal(err)\",\"+    t.Fatalf(\\\"the governed candidate loop failed: %v\\\", err)\",\"   }\",\"-  if !evidence.Passed() {\",\"-    t.Fatalf(\\\"the certifying checks did not pass, so this test proves nothing about identity:\\\\n%s\\\", evidence.Render())\",\"+  if !accepted {\",\"+    t.Fatal(\\\"the loop did not accept the candidate, so nothing was bound to a verdict\\\")\",\"   }\",\" \",\"-  // The post-validation capture: what the reviewer will actually be given.\",\"-  after, err := repo.CandidateCapture(ctx, base, tc.Files)\",\"+  // The state the formatter left behind, measured the way the mint measures.\",\"+  candidate := gitx.Repo{Root: workspace}\",\"+  reviewed, err := candidate.CandidateCapture(ctx, base, tc.Files)\",\"   if err != nil {\",\"     t.Fatal(err)\",\"   }\",\"-  if after.Tree == before.Tree {\",\"-    t.Fatal(\\\"the formatter rewrote nothing, so this test cannot distinguish the two captures\\\")\",\"+  // Without a real rewrite the pre- and post-validation captures are the same\",\"+  // object and this test cannot tell them apart.\",\"+  if !strings.Contains(reviewed.Diff, formattedMark) || strings.Contains(reviewed.Diff, unformattedMark) {\",\"+    t.Fatalf(\\\"validation did not rewrite the worker's bytes, so this test distinguishes nothing:\\\\n%s\\\", reviewed.Diff)\",\"   }\",\"-  if err := certifiedAgainstCapture(evidence, \\\"task-1\\\", after.Diff, diff); err != nil {\",\"-    t.Fatalf(\\\"the validated candidate is not the capture the run would bind: %v\\\", err)\",\"+\",\"+  // What Sensei was asked to audit.\",\"+  if audited := readRecord(t, auditSaw); audited != reviewed.Diff {\",\"+    t.Errorf(\\\"the audit judged bytes that are not the post-validation candidate:\\\\n%s\\\", audited)\",\"   }\",\" \",\"-  // The verdict is bound to that exact state, and nothing moves afterwards.\",\"-  e.noteCapturedTree(\\\"task-1\\\", after.Tree)\",\"-  e.noteReviewDelivered(\\\"task-1\\\", \\\"codex\\\", \\\"accept\\\", candidateRevision(diff), after.Tree)\",\"-  if err := e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, repo.Root, \\\"\\\"); err != nil {\",\"-    t.Fatalf(\\\"the accepted post-validation state could not be minted: %v\\\", err)\",\"+  // What the reviewer read, and the revision the packet bound it to.\",\"+  prompt := readRecord(t, reviewerSaw)\",\"+  if strings.Contains(prompt, unformattedMark) {\",\"+    t.Error(\\\"the reviewer was handed the pre-validation bytes\\\")\",\"   }\",\"+  if !strings.Contains(prompt, formattedMark) {\",\"+    t.Error(\\\"the reviewer was not handed the post-validation candidate\\\")\",\"+  }\",\"+  if revision := candidateRevision(reviewed.Diff); !strings.Contains(prompt, revision) {\",\"+    t.Errorf(\\\"the review packet does not name the post-validation revision %s\\\", shortDigest(revision))\",\"+  }\",\" \",\"-  // And the identity is the canonical one for (base, reviewed tree).\",\"-  commit, err := repo.ExpectedCanonicalSHA(ctx, base, after.Tree)\",\"-  if err != nil {\",\"-    t.Fatal(err)\",\"+  // The content identity the delivered verdict is bound to.\",\"+  tree, ok := e.reviewedTreeFor(\\\"task-1\\\")\",\"+  if !ok {\",\"+    t.Fatal(\\\"the loop recorded no reviewed tree, so no verdict bound a content identity\\\")\",\"   }\",\"-  if err := repo.VerifyCanonicalCommit(ctx, base, after.Tree, commit); err != nil {\",\"-    t.Fatalf(\\\"the minted identity does not reconstruct: %v\\\", err)\",\"+  if tree != reviewed.Tree {\",\"+    t.Fatalf(\\\"the verdict is bound to tree %s and the reviewed state is %s\\\",\",\"+      shortDigest(tree), shortDigest(reviewed.Tree))\",\"   }\",\"+  if digest := e.reviewedDigestFor(\\\"task-1\\\"); digest != candidateRevision(reviewed.Diff) {\",\"+    t.Errorf(\\\"the verdict names revision %s, not the post-validation candidate's %s\\\",\",\"+      shortDigest(digest), shortDigest(candidateRevision(reviewed.Diff)))\",\"+  }\",\"+  // The exact path set travels with it: the capture's, not a re-parse of an\",\"+  // older diff.\",\"+  if got, want := tc.EvidenceSnapshot.ChangedPaths, reviewed.Paths; !samePaths(got, want) {\",\"+    t.Errorf(\\\"the recorded path set is %v, and the post-validation capture holds %v\\\", got, want)\",\"+  }\",\" \",\"-  // The other end: a candidate that moves AFTER the state bound to the\",\"-  // verdict is still refused rather than silently rebound to wherever the\",\"-  // worktree went.\",\"-  os.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(\\\"package main\\\\n\\\\nfunc main() { println(2) }\\\\n\\\"), 0o644)\",\"-  err = e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, repo.Root, \\\"\\\")\",\"+  // That exact state mints, and the identity reconstructs from (base, tree).\",\"+  if err := e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, workspace, repo.WorktreeBranch(\\\"task-1\\\")); err != nil {\",\"+    t.Fatalf(\\\"the accepted post-validation state could not be minted: %v\\\", err)\",\"+  }\",\"+  if err := candidate.VerifyCanonicalCommit(ctx, base, reviewed.Tree, e.candidateCommitFor(\\\"task-1\\\")); err != nil {\",\"+    t.Fatalf(\\\"the minted identity does not reconstruct from the reviewed state: %v\\\", err)\",\"+  }\",\"+\",\"+  // And a candidate that moves AFTER the state bound to the verdict is still\",\"+  // refused rather than silently rebound to wherever the worktree went.\",\"+  if err := os.WriteFile(filepath.Join(workspace, \\\"main.go\\\"),\",\"+    []byte(\\\"package main\\\\n\\\\nfunc main() { println(2) }\\\\n\\\"), 0o644); err != nil {\",\"+    t.Fatal(err)\",\"+  }\",\"+  err = e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, workspace, repo.WorktreeBranch(\\\"task-1\\\"))\",\"   if err == nil {\",\"     t.Fatal(\\\"a candidate that moved after its verdict was minted anyway\\\")\",\"   }\"]},{\"oldStart\":121,\"oldLines\":7,\"newStart\":220,\"newLines\":9,\"lines\":[\" func TestThePreValidationCaptureIsNotTheReviewedState(t *testing.T) {\",\"   ctx := context.Background()\",\"   repo, base := mintRepo(t)\",\"-  os.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(unformatted), 0o644)\",\"+  if err := os.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(unformatted), 0o644); err != nil {\",\"+    t.Fatal(err)\",\"+  }\",\" \",\"   e := formattingEngine(t, repo)\",\"   e.beginReceipt(\\\"task-1\\\")\"]},{\"oldStart\":191,\"oldLines\":3,\"newStart\":292,\"newLines\":198,\"lines\":[\"     })\",\"   }\",\" }\",\"+\",\"+func samePaths(got, want []string) bool {\",\"+  if len(got) != len(want) {\",\"+    return false\",\"+  }\",\"+  for i := range got {\",\"+    if got[i] != want[i] {\",\"+      return false\",\"+    }\",\"+  }\",\"+  return true\",\"+}\",\"+\",\"+func readRecord(t *testing.T, path string) string {\",\"+  t.Helper()\",\"+  body, err := os.ReadFile(path)\",\"+  if err != nil {\",\"+    t.Fatalf(\\\"the stub recorded nothing at %s: %v\\\", filepath.Base(path), err)\",\"+  }\",\"+  return string(body)\",\"+}\",\"+\",\"+// stubMarker identifies a re-entry of this test binary as one of the\",\"+// deterministic processes the governed loop needs.\",\"+const stubMarker = \\\"postvalidation-stub\\\"\",\"+\",\"+// stubProcess is the argv that re-enters this test binary in one stub role.\",\"+//\",\"+// The loop needs three real processes -- a worker, an independent reviewer and\",\"+// Sensei's MCP -- and cannot be driven without them. Re-entering the test\",\"+// binary keeps them deterministic and in this file, where what each one returns\",\"+// is visible beside the behaviour it is supposed to expose; building separate\",\"+// stub commands would put the interesting half somewhere else.\",\"+func stubProcess(t *testing.T, role, record string) (string, []string) {\",\"+  t.Helper()\",\"+  exe, err := os.Executable()\",\"+  if err != nil {\",\"+    t.Fatalf(\\\"locate this test binary to re-enter it as the %s stub: %v\\\", role, err)\",\"+  }\",\"+  return exe, []string{\\\"-test.run=^TestPostValidationStubProcess$\\\", stubMarker, role, record}\",\"+}\",\"+\",\"+// TestPostValidationStubProcess is those processes. It is a subprocess entry\",\"+// point rather than a test: without the marker it skips, and with one it does\",\"+// its job and exits before the testing framework can write anything of its own\",\"+// onto a stream a caller is parsing.\",\"+func TestPostValidationStubProcess(t *testing.T) {\",\"+  args := flag.Args()\",\"+  if len(args) \u003c 3 || args[0] != stubMarker {\",\"+    t.Skip(\\\"not a stub re-entry: this test is the subprocess entry point for the governed-loop regression\\\")\",\"+  }\",\"+  role, record := args[1], args[2]\",\"+  switch role {\",\"+  case \\\"implementor\\\":\",\"+    // The prompt is read and discarded: a stub that varied with it would be\",\"+    // a very small language model, and then a failure would be ambiguous.\",\"+    // It must be drained, though -- a worker that exits without reading its\",\"+    // prompt fails the parent's write, not its own exit status.\",\"+    _, _ = io.Copy(io.Discard, os.Stdin)\",\"+    wd, err := os.Getwd()\",\"+    if err != nil {\",\"+      exitStub(err)\",\"+    }\",\"+    // Unformatted on purpose. This is the whole premise: the bytes the\",\"+    // worker produces are not the bytes anyone will review.\",\"+    if err := os.WriteFile(filepath.Join(wd, \\\"main.go\\\"), []byte(unformatted), 0o644); err != nil {\",\"+      exitStub(err)\",\"+    }\",\"+    fmt.Println(\\\"wrote main.go and did not format it\\\")\",\"+  case \\\"reviewer\\\":\",\"+    prompt, err := io.ReadAll(os.Stdin)\",\"+    if err != nil {\",\"+      exitStub(err)\",\"+    }\",\"+    // What the reviewer received, kept so the test can read the bytes\",\"+    // rather than the engine's claim about them.\",\"+    if err := os.WriteFile(record, prompt, 0o644); err != nil {\",\"+      exitStub(err)\",\"+    }\",\"+    fmt.Println(`{\\\"decision\\\":\\\"accept\\\",\\\"summary\\\":\\\"the candidate prints a number and touches nothing else\\\"}`)\",\"+  case \\\"sensei\\\":\",\"+    serveStubSensei(os.Stdin, os.Stdout, record)\",\"+  default:\",\"+    exitStub(fmt.Errorf(\\\"unknown stub role %q\\\", role))\",\"+  }\",\"+  os.Exit(0)\",\"+}\",\"+\",\"+func exitStub(err error) {\",\"+  fmt.Fprintln(os.Stderr, \\\"postvalidation stub:\\\", err)\",\"+  os.Exit(1)\",\"+}\",\"+\",\"+// serveStubSensei answers the MCP calls the candidate loop makes, in the\",\"+// Content-Length framing internal/sensei speaks.\",\"+func serveStubSensei(in io.Reader, out io.Writer, record string) {\",\"+  r := bufio.NewReader(in)\",\"+  for {\",\"+    body, err := readStubFrame(r)\",\"+    if err != nil {\",\"+      return\",\"+    }\",\"+    var req struct {\",\"+      ID     *int64 `json:\\\"id\\\"`\",\"+      Method string `json:\\\"method\\\"`\",\"+      Params struct {\",\"+        Name      string         `json:\\\"name\\\"`\",\"+        Arguments map[string]any `json:\\\"arguments\\\"`\",\"+      } `json:\\\"params\\\"`\",\"+    }\",\"+    if json.Unmarshal(body, \u0026req) != nil || req.ID == nil {\",\"+      // A notification expects no reply, and an unparseable frame is not\",\"+      // one this stub can answer.\",\"+      continue\",\"+    }\",\"+    var result any = map[string]any{}\",\"+    switch req.Method {\",\"+    case \\\"initialize\\\":\",\"+      result = map[string]any{\",\"+        \\\"protocolVersion\\\": \\\"2025-06-18\\\",\",\"+        \\\"capabilities\\\":    map[string]any{},\",\"+        \\\"serverInfo\\\":      map[string]any{\\\"name\\\": stubMarker, \\\"version\\\": \\\"0\\\"},\",\"+      }\",\"+    case \\\"tools/call\\\":\",\"+      result = stubTool(req.Params.Name, req.Params.Arguments, record)\",\"+    }\",\"+    if err := writeStubFrame(out, map[string]any{\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": *req.ID, \\\"result\\\": result}); err != nil {\",\"+      return\",\"+    }\",\"+  }\",\"+}\",\"+\",\"+// stubTool passes every candidate and records the diff the audit was given.\",\"+// Passing is what makes the identity question the only one this test asks.\",\"+func stubTool(name string, args map[string]any, record string) map[string]any {\",\"+  if name != \\\"awareness_audit_diff\\\" {\",\"+    return map[string]any{\",\"+      \\\"content\\\":           []map[string]string{{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"the stub graph holds nothing about this\\\"}},\",\"+      \\\"structuredContent\\\": map[string]any{},\",\"+    }\",\"+  }\",\"+  diff, _ := args[\\\"diff\\\"].(string)\",\"+  if record != \\\"\\\" {\",\"+    if err := os.WriteFile(record, []byte(diff), 0o644); err != nil {\",\"+      exitStub(err)\",\"+    }\",\"+  }\",\"+  return map[string]any{\",\"+    \\\"content\\\": []map[string]string{{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"audit: pass\\\"}},\",\"+    \\\"structuredContent\\\": map[string]any{\",\"+      \\\"schema\\\":            \\\"sensei.audit.diff.v1\\\",\",\"+      \\\"decision\\\":          \\\"pass\\\",\",\"+      \\\"availability\\\":      \\\"available\\\",\",\"+      \\\"input_diff_digest\\\": validation.Digest(diff),\",\"+    },\",\"+  }\",\"+}\",\"+\",\"+func readStubFrame(r *bufio.Reader) ([]byte, error) {\",\"+  length := -1\",\"+  for {\",\"+    line, err := r.ReadString('\\\\n')\",\"+    if err != nil {\",\"+      return nil, err\",\"+    }\",\"+    line = strings.TrimRight(line, \\\"\\\\r\\\\n\\\")\",\"+    if line == \\\"\\\" {\",\"+      break\",\"+    }\",\"+    if parts := strings.SplitN(line, \\\":\\\", 2); len(parts) == 2 \u0026\u0026\",\"+      strings.EqualFold(strings.TrimSpace(parts[0]), \\\"Content-Length\\\") {\",\"+      if length, err = strconv.Atoi(strings.TrimSpace(parts[1])); err != nil {\",\"+        return nil, err\",\"+      }\",\"+    }\",\"+  }\",\"+  if length \u003c 0 {\",\"+    return nil, fmt.Errorf(\\\"frame without a Content-Length\\\")\",\"+  }\",\"+  body := make([]byte, length)\",\"+  _, err := io.ReadFull(r, body)\",\"+  return body, err\",\"+}\",\"+\",\"+func writeStubFrame(w io.Writer, v any) error {\",\"+  body, err := json.Marshal(v)\",\"+  if err != nil {\",\"+    return err\",\"+  }\",\"+  if _, err := fmt.Fprintf(w, \\\"Content-Length: %d\\\\r\\\\n\\\\r\\\\n\\\", len(body)); err != nil {\",\"+    return err\",\"+  }\",\"+  _, err = w.Write(body)\",\"+  return err\",\"+}\"]}],\"originalFile\":\"package workflow\\n\\n// Validation can rewrite the candidate.\\n//\\n// A configured formatter is not an observer: it edits the worktree, and every\\n// measurement taken before it describes bytes that no longer exist. The run\\n// used to freeze its content identity BEFORE validation and re-read only the\\n// diff afterwards, so the reviewer read post-format text while the tree bound\\n// to the verdict was the pre-format one. The mint re-measured the worktree,\\n// found the post-format tree, and refused an accepted candidate that had not\\n// moved since its verdict -- naming candidate movement as the cause of a\\n// disagreement the run had created itself.\\n//\\n// These tests hold both ends: the exact post-validation state the reviewer\\n// received mints canonically, and a candidate that moves after that state is\\n// still refused.\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"os\\\"\\n\\t\\\"os/exec\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/globulario/sensei-code/internal/broker\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/config\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/gitx\\\"\\n\\t\\\"github.com/globulario/sensei-code/internal/validation\\\"\\n)\\n\\n// unformatted is Go that compiles and that gofmt WILL rewrite, so the formatter\\n// step is a real mutation rather than a no-op that would pass either way.\\nconst unformatted = \\\"package main\\\\n\\\\nfunc main() {\\\\nprintln( 1 )\\\\n}\\\\n\\\"\\n\\n// formattingEngine is the governed loop's validation configuration, reduced to\\n// the one check that mutates and the one that certifies the result.\\nfunc formattingEngine(t *testing.T, repo gitx.Repo) *Engine {\\n\\tt.Helper()\\n\\tif _, err := exec.LookPath(\\\"gofmt\\\"); err != nil {\\n\\t\\tt.Skip(\\\"gofmt is not on PATH, so no formatter can rewrite the candidate here\\\")\\n\\t}\\n\\te := \u0026Engine{Repo: repo}\\n\\te.Config.Permissions.RunFormatters = true\\n\\te.Config.Permissions.LocalCommit = true\\n\\te.Config.Validation = config.Validation{\\n\\t\\tFormat:       []config.Command{{Command: \\\"gofmt\\\", Args: []string{\\\"-w\\\", \\\"main.go\\\"}}},\\n\\t\\tFormatVerify: []config.Command{{Command: \\\"gofmt\\\", Args: []string{\\\"-l\\\", \\\"main.go\\\"}, FailIfOutput: true}},\\n\\t}\\n\\treturn e\\n}\\n\\n// The payoff: the state the reviewer actually received is the state that mints.\\nfunc TestTheTreeAFormatterProducedIsTheTreeThatMints(t *testing.T) {\\n\\tctx := context.Background()\\n\\trepo, base := mintRepo(t)\\n\\tos.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(unformatted), 0o644)\\n\\n\\te := formattingEngine(t, repo)\\n\\te.beginReceipt(\\\"task-1\\\")\\n\\ttc := \u0026taskContext{Identity: candidateIdentityWithBase(base)}\\n\\n\\t// What the loop captures before validation runs.\\n\\tbefore, err := repo.CandidateCapture(ctx, base, tc.Files)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tevidence, diff, err := e.validate(ctx, \\\"task-1\\\", base, broker.New(e.Config.Permissions), repo, before.Diff, tc.Files)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif !evidence.Passed() {\\n\\t\\tt.Fatalf(\\\"the certifying checks did not pass, so this test proves nothing about identity:\\\\n%s\\\", evidence.Render())\\n\\t}\\n\\n\\t// The post-validation capture: what the reviewer will actually be given.\\n\\tafter, err := repo.CandidateCapture(ctx, base, tc.Files)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif after.Tree == before.Tree {\\n\\t\\tt.Fatal(\\\"the formatter rewrote nothing, so this test cannot distinguish the two captures\\\")\\n\\t}\\n\\tif err := certifiedAgainstCapture(evidence, \\\"task-1\\\", after.Diff, diff); err != nil {\\n\\t\\tt.Fatalf(\\\"the validated candidate is not the capture the run would bind: %v\\\", err)\\n\\t}\\n\\n\\t// The verdict is bound to that exact state, and nothing moves afterwards.\\n\\te.noteCapturedTree(\\\"task-1\\\", after.Tree)\\n\\te.noteReviewDelivered(\\\"task-1\\\", \\\"codex\\\", \\\"accept\\\", candidateRevision(diff), after.Tree)\\n\\tif err := e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, repo.Root, \\\"\\\"); err != nil {\\n\\t\\tt.Fatalf(\\\"the accepted post-validation state could not be minted: %v\\\", err)\\n\\t}\\n\\n\\t// And the identity is the canonical one for (base, reviewed tree).\\n\\tcommit, err := repo.ExpectedCanonicalSHA(ctx, base, after.Tree)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif err := repo.VerifyCanonicalCommit(ctx, base, after.Tree, commit); err != nil {\\n\\t\\tt.Fatalf(\\\"the minted identity does not reconstruct: %v\\\", err)\\n\\t}\\n\\n\\t// The other end: a candidate that moves AFTER the state bound to the\\n\\t// verdict is still refused rather than silently rebound to wherever the\\n\\t// worktree went.\\n\\tos.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(\\\"package main\\\\n\\\\nfunc main() { println(2) }\\\\n\\\"), 0o644)\\n\\terr = e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, repo.Root, \\\"\\\")\\n\\tif err == nil {\\n\\t\\tt.Fatal(\\\"a candidate that moved after its verdict was minted anyway\\\")\\n\\t}\\n\\tif !strings.Contains(err.Error(), \\\"moved after it was reviewed\\\") {\\n\\t\\tt.Errorf(\\\"the refusal must name the movement, got %v\\\", err)\\n\\t}\\n}\\n\\n// The failure this replaces: binding the verdict to the PRE-validation capture\\n// refuses the accepted candidate at the mint, blaming movement that never\\n// happened. Pinned so a future re-ordering that reintroduces it is visible as\\n// this behaviour rather than as a mysterious refusal in a real run.\\nfunc TestThePreValidationCaptureIsNotTheReviewedState(t *testing.T) {\\n\\tctx := context.Background()\\n\\trepo, base := mintRepo(t)\\n\\tos.WriteFile(filepath.Join(repo.Root, \\\"main.go\\\"), []byte(unformatted), 0o644)\\n\\n\\te := formattingEngine(t, repo)\\n\\te.beginReceipt(\\\"task-1\\\")\\n\\ttc := \u0026taskContext{Identity: candidateIdentityWithBase(base)}\\n\\n\\tbefore, err := repo.CandidateCapture(ctx, base, tc.Files)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif _, _, err := e.validate(ctx, \\\"task-1\\\", base, broker.New(e.Config.Permissions), repo, before.Diff, tc.Files); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\n\\te.noteReviewDelivered(\\\"task-1\\\", \\\"codex\\\", \\\"accept\\\", \\\"d1\\\", before.Tree)\\n\\terr = e.mintCandidateIdentity(ctx, \\\"task-1\\\", tc, repo.Root, \\\"\\\")\\n\\tif err == nil {\\n\\t\\tt.Fatal(\\\"the pre-validation tree minted, so the two captures are indistinguishable here\\\")\\n\\t}\\n\\tif !strings.Contains(err.Error(), \\\"moved after it was reviewed\\\") {\\n\\t\\tt.Fatalf(\\\"unexpected refusal: %v\\\", err)\\n\\t}\\n}\\n\\n// Fail closed on evidence about other bytes: the proof, the reviewed text and\\n// the content identity must be one claim, and a run that cannot show they are\\n// has no honest way to choose between them.\\nfunc TestValidationEvidenceAboutOtherBytesIsRefused(t *testing.T) {\\n\\trendered := \\\"diff --git a/x b/x\\\\n\\\"\\n\\tdigest := validation.Digest(rendered)\\n\\tcertifying := validation.Evidence{CandidateID: \\\"task-1\\\", DiffDigest: digest, Outcome: validation.Passed}\\n\\n\\tif err := certifiedAgainstCapture(validation.Bundle{\\n\\t\\tCandidateID: \\\"task-1\\\", DiffDigest: digest, Checks: []validation.Evidence{certifying},\\n\\t}, \\\"task-1\\\", rendered, rendered); err != nil {\\n\\t\\tt.Fatalf(\\\"evidence bound to exactly this rendering was refused: %v\\\", err)\\n\\t}\\n\\n\\tcases := map[string]struct {\\n\\t\\tbundle   validation.Bundle\\n\\t\\treturned string\\n\\t}{\\n\\t\\t\\\"the returned diff is not the canonical rendering\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: digest},\\n\\t\\t\\treturned: rendered + \\\"extra\\\\n\\\",\\n\\t\\t},\\n\\t\\t\\\"the bundle is bound to other content\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: validation.Digest(\\\"other\\\")},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t\\t\\\"the bundle is bound to another candidate\\\": {\\n\\t\\t\\tbundle:   validation.Bundle{CandidateID: \\\"task-2\\\", DiffDigest: digest},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t\\t\\\"one check inside a well-bound bundle is stale\\\": {\\n\\t\\t\\tbundle: validation.Bundle{CandidateID: \\\"task-1\\\", DiffDigest: digest, Checks: []validation.Evidence{\\n\\t\\t\\t\\tcertifying,\\n\\t\\t\\t\\t{CandidateID: \\\"task-1\\\", DiffDigest: validation.Digest(\\\"other\\\"), Outcome: validation.Passed, Kind: validation.Vet, Command: \\\"go\\\"},\\n\\t\\t\\t}},\\n\\t\\t\\treturned: rendered,\\n\\t\\t},\\n\\t}\\n\\tfor name, tc := range cases {\\n\\t\\tt.Run(name, func(t *testing.T) {\\n\\t\\t\\tif err := certifiedAgainstCapture(tc.bundle, \\\"task-1\\\", rendered, tc.returned); err == nil {\\n\\t\\t\\t\\tt.Fatal(\\\"accepted validation evidence that does not speak about the reviewed bytes\\\")\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\",\"userModified\":false}}","payload":{"stream":"stdout"}}
