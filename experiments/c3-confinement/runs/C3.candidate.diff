+// Level-1 classification and scope confinement answer different questions.
+// The classifier decides whether a change may skip escalation, and it blocks
+// a governance-path file categorically -- but a blocked classification is not
+// a scope check, and a candidate that qualified would still be confined. The
+// confinement therefore reads the plan and the diff alone, and refuses the
+// widening whatever the classifier said about the change.
+func TestGovernancePathClassificationCannotMaskScopeWidening(t *testing.T) {
+	planned := []string{"internal/workflow/routine.go"}
+	diff := modifiedDiff("internal/workflow/routine.go") + modifiedDiff("internal/tui/model.go")
+
+	// The classifier blocks this for its own reason -- routine.go governs --
+	// and its verdict says nothing about the unnamed path: the categorical
+	// exclusion returns long before its eighth condition ever looks at scope.
+	d := classifyRoutine(qualifyingPreflight(), nil, cleanEditCheck(), planned, shapeOf(diff))
+	if d.Routine {
+		t.Fatal("a candidate touching the governance path was classified routine")
+	}
+	if strings.Contains(d.Blocking, "internal/tui/model.go") {
+		t.Fatalf("this test no longer states the masking it guards: %q", d.Blocking)
+	}
+	err := confineToPlan(diff, planned)
+	if err == nil {
+		t.Fatal("a candidate wider than its plan was accepted because a classification already blocked it")
+	}
+	if !strings.Contains(err.Error(), "internal/tui/model.go") {
+		t.Fatalf("the refusal does not name the path outside the plan: %v", err)
+	}
+
+	// A widening with nothing governing in scope is refused identically, so
+	// the refusal owes nothing to any classification. This one is also the
+	// case the classifier's own scope condition cannot see at all: it
+	// compares the paths that survive, and a rename's source is not one.
+	ordinary := []string{"internal/tui/model.go"}
+	widened := renamedDiff("internal/tui/other.go", "internal/tui/model.go")
+	if got := notPlanned(ordinary, shapeOf(widened).Paths()); len(got) != 0 {
+		t.Fatalf("this test no longer states the case it guards: the classifier saw %v", got)
+	}
+	err = confineToPlan(widened, ordinary)
+	if err == nil {
+		t.Fatal("a candidate that renamed a file the plan does not name was accepted")
+	}
+	if !strings.Contains(err.Error(), "internal/tui/other.go") {
+		t.Fatalf("the refusal does not name the renamed-away path: %v", err)
+	}
+}
