+// license that can be found in the LICENSE file.
+
+package main
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+// fakeTransport serves a fixed response (or error) for every request.
+type fakeTransport struct {
+	status int
+	body   string
+	err    error
+}
+
+func (t fakeTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if t.err != nil {
+		return nil, t.err
+	}
+	return &http.Response{
+		StatusCode: t.status,
+		Status:     http.StatusText(t.status),
+		Body:       io.NopCloser(strings.NewReader(t.body)),
+		Request:    req,
+	}, nil
+}
+
+// readRemote runs ReadRemote with the given transport and verbosity,
+// returning the result and everything written to stderr.
+func readRemote(t *testing.T, tr http.RoundTripper, verbose bool) ([]byte, error, string) {
+	t.Helper()
+	oldTransport := http.DefaultTransport
+	oldV, oldURL := *vflag, *url
+	oldStderr := os.Stderr
+	http.DefaultTransport = tr
+	*vflag = verbose
+	*url = "https://example.invalid"
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	os.Stderr = w
+	defer func() {
+		http.DefaultTransport = oldTransport
+		*vflag, *url = oldV, oldURL
+		os.Stderr = oldStderr
+	}()
+	data, rerr := new(clientOps).ReadRemote("/lookup/x")
+	w.Close()
+	var buf bytes.Buffer
+	io.Copy(&buf, r)
+	r.Close()
+	return data, rerr, buf.String()
+}
+
+func TestReadRemoteVerbose(t *testing.T) {
+	data, err, out := readRemote(t, fakeTransport{status: 200, body: "hello world"}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != "hello world" {
+		t.Fatalf("data = %q, want %q", data, "hello world")
+	}
+	re := regexp.MustCompile(`^\d+\.\d{3}s 11 bytes https://example\.invalid/lookup/x\n$`)
+	if !re.MatchString(out) {
+		t.Fatalf("stderr = %q, want match for %v", out, re)
+	}
+}
+
+func TestReadRemoteNonVerboseSilent(t *testing.T) {
+	data, err, out := readRemote(t, fakeTransport{status: 200, body: "hello world"}, false)
+	if err != nil || string(data) != "hello world" {
+		t.Fatalf("data, err = %q, %v", data, err)
+	}
+	if out != "" {
+		t.Fatalf("stderr = %q, want empty", out)
+	}
+}
+
+func TestReadRemoteErrorsSilent(t *testing.T) {
+	for _, tr := range []fakeTransport{
+		{status: 404, body: "not found"},
+		{err: errors.New("dial failed")},
+	} {
+		data, err, out := readRemote(t, tr, true)
+		if err == nil {
+			t.Fatalf("%+v: got data %q, want error", tr, data)
+		}
+		if out != "" {
+			t.Fatalf("%+v: stderr = %q, want empty", tr, out)
+		}
+	}
+}
