ile the plan never named and the candidate was not refused\\\")\\n\\t}\\n\\tif !strings.Contains(err.Error(), \\\"generated.go\\\") {\\n\\t\\tt.Fatalf(\\\"the refusal does not name the path the formatter added: %v\\\", err)\\n\\t}\\n\\n\\t// And the refusal happens where nothing has yet consumed the widened\\n\\t// candidate: after validation returns, before its evidence is emitted and\\n\\t// before the prospective and test-edit inspections, the audit, the Level-1\\n\\t// classification, the review and admission read that diff.\\n\\tbody := funcBody(t, \\\"internal/workflow/engine.go\\\", \\\"runCandidate\\\")\\n\\tcall := \\\"confineToPlannedFiles(diff, tc.Files)\\\"\\n\\tvalidated := strings.Index(body, \\\"e.validate(ctx\\\")\\n\\tfirst := strings.Index(body, call)\\n\\tsecond := strings.Index(body[validated:], call)\\n\\tif validated \u003c 0 || first \u003c 0 || first \u003e validated || second \u003c 0 {\\n\\t\\tt.Fatal(\\\"the candidate loop no longer confines both the worker's diff and the one validation returns\\\")\\n\\t}\\n\\tsecond += validated\\n\\tfor _, downstream := range []struct {\\n\\t\\tat   int\\n\\t\\twhat string\\n\\t}{\\n\\t\\t{strings.Index(body, \\\"event.ValidationRun\\\"), \\\"the validation evidence\\\"},\\n\\t\\t{strings.Index(body, \\\"inspectProspectiveSurfaces(\\\"), \\\"the prospective inspection\\\"},\\n\\t\\t{strings.Index(body, \\\"inspectTestEdits(\\\"), \\\"the test-edit inspection\\\"},\\n\\t\\t{strings.Index(body, `sc.CallTool(\\\"awareness_audit_diff\\\"`), \\\"the audit\\\"},\\n\\t\\t{strings.Index(body, \\\"e.classifyForDarkRun(\\\"), \\\"the Level-1 classification\\\"},\\n\\t\\t{strings.Index(body, \\\"e.review(\\\"), \\\"the review\\\"},\\n\\t} {\\n\\t\\tif downstream.at \u003c 0 {\\n\\t\\t\\tt.Fatalf(\\\"the candidate loop no longer reaches %s\\\", downstream.what)\\n\\t\\t}\\n\\t\\tif second \u003e downstream.at {\\n\\t\\t\\tt.Fatalf(\\\"a candidate widened by the formatter reaches %s before it is refused\\\", downstr