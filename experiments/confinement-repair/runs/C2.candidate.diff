+// unifiedModify, unifiedDelete and unifiedRename build the diff shapes the
+// confinement check reads, in the exact spelling Git writes.
+func unifiedModify(path string) string {
+	return "diff --git a/" + path + " b/" + path + "\nindex 1111111..2222222 100644\n--- a/" + path + "\n+++ b/" + path + "\n@@ -1 +1 @@\n-before\n+after\n"
+}
+
+func unifiedDelete(path string) string {
+	return "diff --git a/" + path + " b/" + path + "\ndeleted file mode 100644\nindex 1111111..0000000\n--- a/" + path + "\n+++ /dev/null\n@@ -1 +0,0 @@\n-gone\n"
+}
+
+func unifiedRename(from, to string) string {
+	return "diff --git a/" + from + " b/" + to + "\nsimilarity index 100%\nrename from " + from + "\nrename to " + to + "\n"
+}
+
+// A candidate is confined to the files its plan names.
+//
+// The plan's file list bounded what the worker was ASKED to change, and after
+// the worker ran nothing read it again: a candidate that also edited a file
+// outside the plan reached validation, the audit, the classification, the
+// reviewer and admission as though the plan had named it. The reviewer might
+// notice; noticing is not a boundary.
+func TestCandidateWiderThanPlanIsRefusedBeforeReview(t *testing.T) {
+	planned := []string{"internal/workflow/engine.go", "./internal/workflow/testedit.go"}
+
+	// One path outside the plan refuses the candidate, and the refusal names
+	// both that path and what the plan actually authorised.
+	err := confineToPlannedFiles(unifiedModify("internal/workflow/engine.go")+unifiedModify("internal/broker/guard.go"), planned)
+	if err == nil {
+		t.Fatal("a candidate that changed a file the plan never named was accepted")
+	}
+	if !strings.Contains(err.Error(), "internal/broker/guard.go") {
+		t.Fatalf("the refusal does not name the path outside the plan: %v", err)
+	}
+	if !strings.Contains(err.Error(), "internal/workflow/engine.go") {
+		t.Fatalf("the refusal does not state which files the plan named: %v", err)
+	}
+
+	// A candidate inside its plan passes, including the plan's own "./"
+	// spelling of a file the diff spells bare.
+	if err := confineToPlannedFiles(unifiedModify("internal/workflow/engine.go")+unifiedModify("internal/workflow/testedit.go"), planned); err != nil {
+		t.Fatalf("a candidate that stayed inside its plan was refused: %v", err)
+	}
+
+	// A deletion is a change. Removing a file the plan never named is exactly
+	// the widening this refuses, and a check reading only added or modified
+	// paths would let it through.
+	if err := confineToPlannedFiles(unifiedDelete("docs/awareness/high_risk_files.yaml"), planned); err == nil ||
+		!strings.Contains(err.Error(), "docs/awareness/high_risk_files.yaml") {
+		t.Fatalf("a deletion outside the plan was not refused: %v", err)
+	}
+
+	// A rename is two paths and both must be named: moving a planned file to an
+	// unplanned one changes a file the plan did not name.
+	if err := confineToPlannedFiles(unifiedRename("internal/workflow/testedit.go", "internal/workflow/scope.go"), planned); err == nil ||
+		!strings.Contains(err.Error(), "internal/workflow/scope.go") {
+		t.Fatalf("a rename out of the plan was not refused: %v", err)
+	}
+
+	// And it refuses where a refusal still means something: in runCandidate,
+	// after the read-only refusal and before the candidate is announced,
+	// validated, audited, classified or reviewed.
+	src := rawSource(t, "internal/workflow/engine.go")
+	readOnly := strings.Index(src, "the plan was read-only and the candidate changed")
+	confine := strings.Index(src, "confineToPlannedFiles(diff")
+	announced := strings.Index(src, "event.CandidateChanged")
+	validated := strings.Index(src, "e.validate(ctx")
+	audited := strings.Index(src, `sc.CallTool("awareness_audit_diff"`)
+	classified := strings.Index(src, "e.classifyForDarkRun(")
+	if readOnly < 0 || confine < 0 || announced < 0 || validated < 0 || audited < 0 || classified < 0 {
+		t.Fatal("the candidate loop no longer holds the refusal and the steps it must precede")
+	}
+	if confine < readOnly {
+		t.Fatal("the confinement check runs before the read-only refusal")
+	}
+	for _, downstream := range []struct {
+		at   int
+		what string
+	}{{announced, "the candidate.changed event"}, {validated, "validation"}, {audited, "the audit"}, {classified, "the Level-1 classification"}} {
+		if confine > downstream.at {
+			t.Fatalf("a candidate wider than its plan reaches %s before it is refused", downstream.what)
+		}
+	}
+}
