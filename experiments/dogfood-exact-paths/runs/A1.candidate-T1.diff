+// splitQuoted decodes the C-quoted token at the start of s, returning the bytes
+// it names and whatever follows its closing quote.
+func splitQuoted(s string) (string, string, bool) {
+	if !strings.HasPrefix(s, `"`) {
+		return "", "", false
