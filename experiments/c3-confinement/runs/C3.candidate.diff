@@ -396,3 +396,62 @@ func joinGrants(prospective, edits string) string {
 	}
 	return strings.Join(parts, "\n\n")
 }
+
+// confineToPlan refuses a candidate that changed a file the plan does not
+// name.
+//
+// The bound is the plan's named files and nothing else. It is deliberately
+// NOT given the test-edit grants: a grant is operational authority to edit a
+// file the plan already names, and handing one to this check would let a
+// grant enlarge the set the plan bounds.
+//
+// Every path the diff carries counts, whatever its status. A deletion outside
+// the plan removes something the plan did not authorise removing, and a
+// rename is two paths -- reading only the surviving one would let a candidate
+// move a file out of the plan's set unremarked.
+func confineToPlan(diff string, planned []string) error {
+	// Canonicalised exactly as architecturalFiles does, because the plan's
+	// spelling is whatever the architect wrote ("./internal/x.go" included)
+	// and Git's is always clean: compared raw, a named file would read as an
+	// unnamed one and a confined candidate would be refused.
+	named := map[string]bool{}
+	var names []string
+	for _, f := range planned {
+		if strings.TrimSpace(f) == "" {
+			continue
+		}
+		c := path.Clean(strings.TrimSpace(f))
+		if named[c] {
+			continue
+		}
+		named[c] = true
+		names = append(names, c)
+	}
+	var outside []string
+	seen := map[string]bool{}
+	for _, f := range report.FromDiff(diff).Files {
+		for _, p := range []string{f.Path, f.OldPath} {
+			if strings.TrimSpace(p) == "" {
+				continue
+			}
+			c := path.Clean(strings.TrimSpace(p))
+			if named[c] || seen[c] {
+				continue
+			}
+			seen[c] = true
+			outside = append(outside, c)
+		}
+	}
+	if len(outside) == 0 {
+		return nil
+	}
+	sort.Strings(outside)
+	// A plan that named nothing is stated as such rather than rendered blank,
+	// which would read as "no constraint" -- the opposite of what it is.
+	plan := strings.Join(names, ", ")
+	if plan == "" {
+		plan = "(no files)"
+	}
+	return fmt.Errorf("the candidate changed %d file(s) the plan does not name: %s; the plan names: %s",
+		len(outside), strings.Join(outside, ", "), plan)
+}
