+// TestChangeSetHoldsEveryPathGitCanQuote pins the reason ChangeSet exists.
+//
+// A diff header is a rendering: Git quotes any path it will not print raw, so
+// `diff --git "a/caf\303\251.md" "b/caf\303\251.md"` is an ordinary header for
+// an ordinary file. A reader that expects a bare `a/` prefix does not see that
+// file, and anything deciding what the candidate touched from such a reading
+// decides it from a set the quoted path silently left.
+//
+// `--name-status -z` is the account that cannot lose one: no quoting, and NUL
+// record boundaries rather than a character a filename may contain.
+func TestChangeSetHoldsEveryPathGitCanQuote(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	repo := Repo{Root: dir}
+	mustGit(t, dir, "init", "-q", "-b", "main")
+	mustGit(t, dir, "config", "user.email", "t@t")
+	mustGit(t, dir, "config", "user.name", "t")
+
+	write(t, dir, "docs/café.md", "a\n")         // non-ASCII, to be modified
+	write(t, dir, "gone/évier.md", "b\n")        // non-ASCII, to be deleted
+	write(t, dir, "naïve.go", "package p\n")     // quoted old path of a rename
+	write(t, dir, "plain_old.go", "package p\n") // renamed INTO a quoted path
+	write(t, dir, "ctrl\x01.txt", "e\n")         // an ordinary ASCII control
+	mustGit(t, dir, "add", "-A")
+	mustGit(t, dir, "commit", "-q", "-m", "base")
+	base, err := repo.Head(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	write(t, dir, "docs/café.md", "a2\n")
+	write(t, dir, "weird/ta\tb.go", "package p\n") // a path containing a tab
+	write(t, dir, "ctrl\x01.txt", "e2\n")
+	mustGit(t, dir, "mv", "naïve.go", "plain_new.go")
+	mustGit(t, dir, "mv", "plain_old.go", "renommé.go")
+	mustGit(t, dir, "rm", "-q", "gone/évier.md")
+	mustGit(t, dir, "add", "-A")
+
+	// If Git ever stopped quoting these headers this test would prove nothing,
+	// so the premise is checked rather than assumed.
+	diff, err := repo.Diff(ctx, base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, quoted := range []string{`"a/docs/caf\303\251.md"`, `"a/weird/ta\tb.go"`, `"a/ctrl\001.txt"`} {
+		if !strings.Contains(diff, quoted) {
+			t.Fatalf("git no longer quotes %s in the diff header, so this test proves nothing:\n%s", quoted, diff)
+		}
+	}
+
+	changes, err := repo.CandidateChanges(ctx, base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []FileChange{
+		{Path: "ctrl\x01.txt", Status: Modified},
+		{Path: "docs/café.md", Status: Modified},
+		{Path: "gone/évier.md", Status: Deleted},
+		{Path: "plain_new.go", OldPath: "naïve.go", Status: Renamed},
+		{Path: "renommé.go", OldPath: "plain_old.go", Status: Renamed},
+		{Path: "weird/ta\tb.go", Status: Added},
+	}
+	if len(changes.Files) != len(want) {
+		t.Fatalf("ChangeSet holds %d file(s), want %d: %+q", len(changes.Files), len(want), changes.Files)
+	}
+	// The order is the parser's, not Git's: a set two consumers compare must
+	// read the same way to both of them.
+	for i, w := range want {
+		if changes.Files[i] != w {
+			t.Errorf("ChangeSet.Files[%d] = %+q, want %+q", i, changes.Files[i], w)
+		}
+	}
+	// Both sides of a rename are paths the candidate changed. A confinement
+	// that saw only the arrival would miss a file moved OUT of its scope.
+	paths := changes.Paths()
+	for _, p := range []string{"naïve.go", "plain_new.go", "plain_old.go", "renommé.go"} {
+		if !contains(paths, p) {
+			t.Errorf("Paths() omits %q: %+q", p, paths)
+		}
+	}
+}
+
+func contains(list []string, want string) bool {
+	for _, s := range list {
+		if s == want {
+			return true
+		}
+	}
+	return false
+}
