+// rawFuncSource returns one function's source text, verbatim, so an assertion
+// can be about what the code says and not only about which identifiers it
+// mentions. The doc comment is excluded: prose describing a rule is not the
+// rule.
+func rawFuncSource(t *testing.T, rel, name string) string {
+	t.Helper()
+	fset := token.NewFileSet()
+	parsed, err := parser.ParseFile(fset, "../../"+rel, nil, 0)
+	if err != nil {
+		t.Fatalf("parse %s: %v", rel, err)
+	}
+	src := rawSource(t, rel)
+	var out string
+	ast.Inspect(parsed, func(n ast.Node) bool {
+		fn, ok := n.(*ast.FuncDecl)
+		if !ok || fn.Name.Name != name || fn.Body == nil {
+			return true
+		}
+		out = src[fset.Position(fn.Pos()).Offset:fset.Position(fn.End()).Offset]
+		return false
+	})
+	if out == "" {
+		t.Fatalf("function %s not found in %s", name, rel)
+	}
+	return out
+}
