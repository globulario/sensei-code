Candidate(ctx context.Context, sc *sensei.Client, start certifiedStart, taskID string, tc *taskContext, initialPlan string, worker config.Agent, workspace, carried string) (bool, string, string, string, error) {\\ninternal/workflow/engine.go:3816:\\t\\taccepted, finalPlan, review, audit, err := e.runCandidate(ctx, sc, start, taskID, tc, plan, worker, workspace, carried)\\ninternal/workflow/engine.go:3865:\\t\\t\\t\\tif err := e.mintCandidateIdentity(ctx, taskID, tc, workspace, e.Repo.WorktreeBranch(taskID)); err != nil {\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}","payload":{"stream":"stdout"}}
