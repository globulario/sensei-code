+// splitQuotedHeader splits the two halves of a `diff --git` header when at
+// least one of them is C-quoted, which is what makes the split unambiguous: an
+// unquoted half can hold spaces but never a quote, because a path containing
+// one is quoted. A header with neither half quoted is not this function's case
+// and is left to the shape rule.
+func splitQuotedHeader(rest string) (left, right string, ok bool) {
+	if strings.HasPrefix(rest, `"`) {
+		token, tail, found := quotedPrefix(rest)
+		if !found || !strings.HasPrefix(tail, " ") {
+			return "", "", false
+		}
+		return token, tail[1:], true
+	}
+	if i := strings.Index(rest, ` "`); i >= 0 {
+		return rest[:i], rest[i+1:], true
+	}
+	return "", "", false
