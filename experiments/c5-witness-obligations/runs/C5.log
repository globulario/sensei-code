{"id":"20260830T003739.561587446Z-9341f8c6","time":"2026-08-30T00:37:39.561587446Z","session_id":"session-20260830T002012.706816133Z","task_id":"task-1788049212707426532","source":"claude","kind":"output","summary":"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01PFUJLnnhVLaFfmHUTDWG1M\",\"type\":\"tool_result\",\"content\":\"diff --git a/internal/workflow/engine_test.go b/internal/workflow/engine_test.go\\nindex 021e824..d591117 100644\\n--- a/internal/workflow/engine_test.go\\n+++ b/internal/workflow/engine_test.go\\n@@ -9,6 +9,9 @@ import (\\n \\t\\\"go/parser\\\"\\n \\t\\\"go/token\\\"\\n \\t\\\"os\\\"\\n+\\t\\\"os/exec\\\"\\n+\\t\\\"path/filepath\\\"\\n+\\t\\\"strconv\\\"\\n \\t\\\"strings\\\"\\n \\t\\\"testing\\\"\\n \\t\\\"time\\\"\\n@@ -18,6 +21,8 @@ import (\\n \\t\\\"github.com/globulario/sensei-code/internal/authority\\\"\\n \\t\\\"github.com/globulario/sensei-code/internal/decision\\\"\\n \\t\\\"github.com/globulario/sensei-code/internal/event\\\"\\n+\\t\\\"github.com/globulario/sensei-code/internal/gitx\\\"\\n+\\t\\\"github.com/globulario/sensei-code/internal/report\\\"\\n \\t\\\"github.com/globulario/sensei-code/internal/taskstate\\\"\\n )\\n \\n@@ -1321,3 +1326,315 @@ func TestAReadOnlyWorkerIsToldToReconcileItsOwnFindings(t *testing.T) {\\n \\t\\t}\\n \\t}\\n }\\n+\\n+// Confinement compares pathnames EXACTLY as Git reports them. A path that\\n+// differs from a planned one only by whitespace is a DIFFERENT FILE, and the\\n+// difference is invisible in prose -- which is precisely why nothing here may\\n+// trim it away.\\n+func TestAPathDifferingFromThePlanOnlyByWhitespaceIsRefused(t *testing.T) {\\n+\\tplanned := []string{\\\"internal/workflow/engine.go\\\"}\\n+\\tfor _, changed := range []string{\\n+\\t\\t\\\" internal/workflow/engine.go\\\",\\n+\\t\\t\\\"internal/workflow/engine.go \\\",\\n+\\t\\t\\\"internal/workflow/engine.go\\\\t\\\",\\n+\\t\\t\\\"internal/workflow/ engine.go\\\",\\n+\\t} {\\n+\\t\\terr := confineToPlan([]string{changed}, planned)\\n+\\t\\tif err == nil {\\n+\\t\\t\\tt.Errorf(\\\"a candidate that changed %q under a plan naming %q was admitted; they are different files\\\",\\n+\\t\\t\\t\\tchanged, planned[0])\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\t// The refusal has to SHOW the difference, or its reader cannot act on it.\\n+\\t\\tif !strings.Contains(err.Error(), strconv.Quote(changed)) {\\n+\\t\\t\\tt.Errorf(\\\"the refusal for %q does not show the path it refused: %v\\\", changed, err)\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// The plan's own spelling may be canonicalised by path.Clean and by nothing\\n+// else. Clean folds different spellings of ONE path together; it never removes\\n+// whitespace, so it cannot fold two different paths into one.\\n+func TestThePlansSpellingIsCleanedAndNeverTrimmed(t *testing.T) {\\n+\\tplanned := []string{\\\"./internal/workflow//engine.go\\\", \\\"internal/./workflow/testedit.go\\\"}\\n+\\tif err := confineToPlan([]string{\\\"internal/workflow/engine.go\\\", \\\"internal/workflow/testedit.go\\\"}, planned); err != nil {\\n+\\t\\tt.Fatalf(\\\"an in-plan candidate was refused over the plan's own spelling: %v\\\", err)\\n+\\t}\\n+\\t// A plan whose own entry carries whitespace names the whitespace-bearing\\n+\\t// file, and only that one.\\n+\\tif err := confineToPlan([]string{\\\" a.go\\\"}, []string{\\\" a.go\\\"}); err != nil {\\n+\\t\\tt.Fatalf(\\\"a plan naming %q refused a candidate that changed exactly it: %v\\\", \\\" a.go\\\", err)\\n+\\t}\\n+\\tif err := confineToPlan([]string{\\\"a.go\\\"}, []string{\\\" a.go\\\"}); err == nil {\\n+\\t\\tt.Fatal(\\\"a plan naming \\\\\\\" a.go\\\\\\\" admitted a change to \\\\\\\"a.go\\\\\\\"; the plan's whitespace was trimmed away\\\")\\n+\\t}\\n+}\\n+\\n+// The paths Git quotes in a diff header are the ones a text parser loses, so\\n+// they are the ones an out-of-plan change can hide behind. Confinement sees\\n+// them, because it reads Git's own answer rather than the header.\\n+func TestAQuotedOutOfPlanChangeIsRefused(t *testing.T) {\\n+\\tplanned := []string{\\\"internal/workflow/engine.go\\\"}\\n+\\tfor _, name := range []string{\\n+\\t\\t\\\"a quoted modification\\\", \\\"a quoted deletion\\\", \\\"an ASCII control\\\", \\\"a tab\\\",\\n+\\t} {\\n+\\t\\tvar changed []string\\n+\\t\\tswitch name {\\n+\\t\\tcase \\\"a quoted modification\\\":\\n+\\t\\t\\tchanged = []string{\\\"internal/workflow/engine.go\\\", \\\"ünïcode.go\\\"}\\n+\\t\\tcase \\\"a quoted deletion\\\":\\n+\\t\\t\\tchanged = []string{\\\"internal/workflow/engine.go\\\", \\\"doomed-é.go\\\"}\\n+\\t\\tcase \\\"an ASCII control\\\":\\n+\\t\\t\\tchanged = []string{\\\"internal/workflow/engine.go\\\", \\\"ctrl\\\\x01.go\\\"}\\n+\\t\\tcase \\\"a tab\\\":\\n+\\t\\t\\tchanged = []string{\\\"internal/workflow/engine.go\\\", \\\"tab\\\\there.go\\\"}\\n+\\t\\t}\\n+\\t\\tif err := confineToPlan(changed, planned); err == nil {\\n+\\t\\t\\tt.Errorf(\\\"%s outside the plan was admitted: %q\\\", name, changed[1])\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// A rename REMOVES a path. Confining on the new path alone would let a\\n+// candidate move a file the plan does not name and be judged only on where it\\n+// landed, which is why gitx.ChangeSet.Paths carries both sides.\\n+func TestARenameOutOfAnUnplannedPathIsRefused(t *testing.T) {\\n+\\tset := gitx.ChangeSet{Files: []gitx.FileChange{\\n+\\t\\t{Path: \\\"internal/workflow/engine.go\\\", OldPath: \\\"internal/workflow/elsewhere.go\\\", Status: gitx.Renamed},\\n+\\t}}\\n+\\terr := confineToPlan(set.Paths(), []string{\\\"internal/workflow/engine.go\\\"})\\n+\\tif err == nil {\\n+\\t\\tt.Fatal(\\\"a rename whose old path is outside the plan was admitted\\\")\\n+\\t}\\n+\\tif !strings.Contains(err.Error(), \\\"elsewhere.go\\\") {\\n+\\t\\tt.Fatalf(\\\"the refusal does not name the path the rename removed: %v\\\", err)\\n+\\t}\\n+}\\n+\\n+// An in-plan candidate is not disturbed by any of this.\\n+func TestAnInPlanCandidateStillPasses(t *testing.T) {\\n+\\tset := gitx.ChangeSet{Files: []gitx.FileChange{\\n+\\t\\t{Path: \\\"internal/gitx/git.go\\\", Status: gitx.Modified},\\n+\\t\\t{Path: \\\"internal/gitx/git_test.go\\\", Status: gitx.Added},\\n+\\t\\t{Path: \\\"internal/report/report.go\\\", OldPath: \\\"internal/report/old.go\\\", Status: gitx.Renamed},\\n+\\t}}\\n+\\tplanned := []string{\\n+\\t\\t\\\"internal/gitx/git.go\\\", \\\"internal/gitx/git_test.go\\\",\\n+\\t\\t\\\"internal/report/report.go\\\", \\\"internal/report/old.go\\\",\\n+\\t}\\n+\\tif err := confineToPlan(set.Paths(), planned); err != nil {\\n+\\t\\tt.Fatalf(\\\"an in-plan candidate was refused: %v\\\", err)\\n+\\t}\\n+}\\n+\\n+// A test-edit grant says HOW a planned file may be edited. It never adds a file\\n+// to the plan, and confinement must not be able to read one -- an operational\\n+// authority that could widen scope would be scope.\\n+func TestConfinementReadsNoTestEditGrant(t *testing.T) {\\n+\\tfn := funcBody(t, \\\"internal/workflow/testedit.go\\\", \\\"confineToPlan\\\")\\n+\\tfor _, forbidden := range []string{\\\"testEditGrant\\\", \\\"operationalFiles\\\", \\\"TrimSpace\\\", \\\"ToLower\\\", \\\"EqualFold\\\", \\\"FromSlash\\\", \\\"ToSlash\\\"} {\\n+\\t\\tif strings.Contains(fn, forbidden) {\\n+\\t\\t\\tt.Errorf(\\\"confineToPlan reads %s; it must compare Git's paths exactly and take no grant\\\", forbidden)\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// Git is the authority on what a candidate changed; report.FromDiff renders it.\\n+// When the two disagree, one of them is wrong about what this candidate IS, and\\n+// nothing downstream can tell which -- so the candidate is refused and the\\n+// disagreement is named.\\n+func TestADisagreementBetweenGitAndTheDiffRefusesTheCandidate(t *testing.T) {\\n+\\tagreeing := gitx.ChangeSet{Files: []gitx.FileChange{\\n+\\t\\t{Path: \\\"a.go\\\", Status: gitx.Modified},\\n+\\t\\t{Path: \\\"c.go\\\", OldPath: \\\"b.go\\\", Status: gitx.Renamed},\\n+\\t}}\\n+\\trendered := report.Change{Files: []report.FileChange{\\n+\\t\\t{Path: \\\"a.go\\\", Status: report.Modified},\\n+\\t\\t{Path: \\\"c.go\\\", OldPath: \\\"b.go\\\", Status: report.Renamed},\\n+\\t}}\\n+\\tif err := reconcileChangeSet(agreeing, rendered); err != nil {\\n+\\t\\tt.Fatalf(\\\"two readings that agree were refused: %v\\\", err)\\n+\\t}\\n+\\n+\\tfor _, c := range []struct {\\n+\\t\\tname    string\\n+\\t\\tdiff    report.Change\\n+\\t\\tmustSay string\\n+\\t}{\\n+\\t\\t{\\n+\\t\\t\\tname:    \\\"the diff lost a file Git reports\\\",\\n+\\t\\t\\tdiff:    report.Change{Files: rendered.Files[:1]},\\n+\\t\\t\\tmustSay: \\\"c.go\\\",\\n+\\t\\t},\\n+\\t\\t{\\n+\\t\\t\\tname: \\\"the diff reports a file Git does not\\\",\\n+\\t\\t\\tdiff: report.Change{Files: append(append([]report.FileChange{}, rendered.Files...),\\n+\\t\\t\\t\\treport.FileChange{Path: \\\"extra.go\\\", Status: report.Added})},\\n+\\t\\t\\tmustSay: \\\"extra.go\\\",\\n+\\t\\t},\\n+\\t\\t{\\n+\\t\\t\\tname: \\\"the two disagree about a status\\\",\\n+\\t\\t\\tdiff: report.Change{Files: []report.FileChange{\\n+\\t\\t\\t\\t{Path: \\\"a.go\\\", Status: report.Added},\\n+\\t\\t\\t\\t{Path: \\\"c.go\\\", OldPath: \\\"b.go\\\", Status: report.Renamed},\\n+\\t\\t\\t}},\\n+\\t\\t\\tmustSay: \\\"a.go\\\",\\n+\\t\\t},\\n+\\t\\t{\\n+\\t\\t\\tname: \\\"the two disagree about a rename's old path\\\",\\n+\\t\\t\\tdiff: report.Change{Files: []report.FileChange{\\n+\\t\\t\\t\\t{Path: \\\"a.go\\\", Status: report.Modified},\\n+\\t\\t\\t\\t{Path: \\\"c.go\\\", OldPath: \\\"elsewhere.go\\\", Status: report.Renamed},\\n+\\t\\t\\t}},\\n+\\t\\t\\tmustSay: \\\"elsewhere.go\\\",\\n+\\t\\t},\\n+\\t} {\\n+\\t\\terr := reconcileChangeSet(agreeing, c.diff)\\n+\\t\\tif err == nil {\\n+\\t\\t\\tt.Errorf(\\\"%s: the candidate was admitted on two contradictory readings\\\", c.name)\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\tif !strings.Contains(err.Error(), c.mustSay) {\\n+\\t\\t\\tt.Errorf(\\\"%s: the refusal does not name the disagreement (%s): %v\\\", c.name, c.mustSay, err)\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// The binding is over a real worktree, twice: once over what the worker\\n+// produced, and once over the re-read after validation, because a formatter is\\n+// a process that edits the worktree and can widen the candidate onto a file the\\n+// plan never named.\\n+func TestConfinementBindsTheWorktreeBeforeAndAfterAFormatterWidensIt(t *testing.T) {\\n+\\tctx := context.Background()\\n+\\tdir := t.TempDir()\\n+\\tgit := func(args ...string) {\\n+\\t\\tt.Helper()\\n+\\t\\tcmd := exec.Command(\\\"git\\\", append([]string{\\\"-C\\\", dir}, args...)...)\\n+\\t\\tif out, err := cmd.CombinedOutput(); err != nil {\\n+\\t\\t\\tt.Fatalf(\\\"git %v: %v %s\\\", args, err, out)\\n+\\t\\t}\\n+\\t}\\n+\\twrite := func(name, body string) {\\n+\\t\\tt.Helper()\\n+\\t\\tif err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o644); err != nil {\\n+\\t\\t\\tt.Fatal(err)\\n+\\t\\t}\\n+\\t}\\n+\\tgit(\\\"init\\\", \\\"-q\\\", \\\"-b\\\", \\\"main\\\")\\n+\\tgit(\\\"config\\\", \\\"user.email\\\", \\\"t@t\\\")\\n+\\tgit(\\\"config\\\", \\\"user.name\\\", \\\"t\\\")\\n+\\twrite(\\\"planned.go\\\", \\\"package p\\\\n\\\")\\n+\\twrite(\\\"unplanned.go\\\", \\\"package p\\\\n\\\")\\n+\\tgit(\\\"add\\\", \\\"-A\\\")\\n+\\tgit(\\\"commit\\\", \\\"-q\\\", \\\"-m\\\", \\\"base\\\")\\n+\\tout, err := exec.Command(\\\"git\\\", \\\"-C\\\", dir, \\\"rev-parse\\\", \\\"HEAD\\\").Output()\\n+\\tif err != nil {\\n+\\t\\tt.Fatal(err)\\n+\\t}\\n+\\tbase := strings.TrimSpace(string(out))\\n+\\n+\\tcandidate := gitx.Repo{Root: dir}\\n+\\tplanned := []string{\\\"planned.go\\\"}\\n+\\te := \u0026Engine{}\\n+\\tbind := func() error {\\n+\\t\\tt.Helper()\\n+\\t\\tdiff, err := candidate.CandidateDiff(ctx, base)\\n+\\t\\tif err != nil {\\n+\\t\\t\\tt.Fatal(err)\\n+\\t\\t}\\n+\\t\\treturn e.confineCandidate(ctx, candidate, base, diff, planned)\\n+\\t}\\n+\\n+\\t// What the worker produced: in plan.\\n+\\twrite(\\\"planned.go\\\", \\\"package p\\\\n\\\\nfunc A() {}\\\\n\\\")\\n+\\tif err := bind(); err != nil {\\n+\\t\\tt.Fatalf(\\\"an in-plan candidate was refused at the first binding point: %v\\\", err)\\n+\\t}\\n+\\t// What validation left behind: a formatter rewrote a file nobody planned.\\n+\\twrite(\\\"unplanned.go\\\", \\\"package p\\\\n\\\\nfunc B() {}\\\\n\\\")\\n+\\terr = bind()\\n+\\tif err == nil {\\n+\\t\\tt.Fatal(\\\"a candidate widened onto an unplanned file during validation reached the reviewer\\\")\\n+\\t}\\n+\\tif !strings.Contains(err.Error(), \\\"unplanned.go\\\") {\\n+\\t\\tt.Fatalf(\\\"the refusal does not name the file the candidate was widened onto: %v\\\", err)\\n+\\t}\\n+}\\n+\\n+// Both binding points exist, and the first one is upstream of every consumer of\\n+// the candidate. Each of those treats what it reads as in-scope work; a file\\n+// outside the plan that reaches any of them has already been acted on.\\n+func TestTheCandidateIsBoundToThePlanBeforeAnythingConsumesIt(t *testing.T) {\\n+\\tbody := funcBody(t, \\\"internal/workflow/engine.go\\\", \\\"runCandidate\\\")\\n+\\tif n := strings.Count(body, \\\"e.confineCandidate(\\\"); n != 2 {\\n+\\t\\tt.Fatalf(\\\"runCandidate binds the candidate to the plan %d time(s), want 2 (the worker's diff, and the re-read after validation)\\\", n)\\n+\\t}\\n+\\tfirst := strings.Index(body, \\\"e.confineCandidate(\\\")\\n+\\tlast := strings.LastIndex(body, \\\"e.confineCandidate(\\\")\\n+\\tvalidate := strings.Index(body, \\\"e.validate(\\\")\\n+\\tif validate \u003c 0 {\\n+\\t\\tt.Fatal(\\\"validation is gone from runCandidate\\\")\\n+\\t}\\n+\\tif !(first \u003c validate \u0026\u0026 validate \u003c last) {\\n+\\t\\tt.Fatalf(\\\"the two bindings do not straddle validation (first=%d validate=%d last=%d)\\\", first, validate, last)\\n+\\t}\\n+\\t// funcBody renders identifiers, so a plain call appears as its name and a\\n+\\t// method call as its selector path. resolveReview is located from the END:\\n+\\t// it is called twice, and its first call belongs to the read-only branch\\n+\\t// that returned long before this binding point exists.\\n+\\tfor _, consumer := range []struct {\\n+\\t\\tname string\\n+\\t\\tlast bool\\n+\\t}{\\n+\\t\\t{name: \\\"e.validate(\\\"},\\n+\\t\\t{name: \\\"inspectProspectiveSurfaces\\\"},\\n+\\t\\t{name: \\\"inspectTestEdits\\\"},\\n+\\t\\t{name: \\\"auditArgs\\\"},\\n+\\t\\t{name: \\\"e.classifyForDarkRun(\\\"},\\n+\\t\\t{name: \\\"e.resolveReview(\\\", last: true},\\n+\\t\\t{name: \\\"e.emitChangeReport(\\\"},\\n+\\t\\t{name: \\\"e.recordDecision(\\\"},\\n+\\t} {\\n+\\t\\tat := strings.Index(body, consumer.name)\\n+\\t\\tif consumer.last {\\n+\\t\\t\\tat = strings.LastIndex(body, consumer.name)\\n+\\t\\t}\\n+\\t\\tif at \u003c 0 {\\n+\\t\\t\\tt.Errorf(\\\"%s no longer appears in runCandidate\\\", consumer.name)\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\tif at \u003c first {\\n+\\t\\t\\tt.Errorf(\\\"%s reads the candidate before it is confined to the plan\\\", consumer.name)\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// A run that PRODUCED a candidate does not reach terminal completion while that\\n+// candidate is only working-tree state: completing there reports the candidate\\n+// ready for governed admission while the branch it names holds none of the\\n+// work. A run that produced no candidate never gets here.\\n+func TestAnUncommittedCandidateDoesNotReachTerminalCompletion(t *testing.T) {\\n+\\tbody := funcBody(t, \\\"internal/workflow/engine.go\\\", \\\"runCandidate\\\")\\n+\\tat := strings.Index(body, \\\"candidate.ChangeSet(\\\")\\n+\\tif at \u003c 0 {\\n+\\t\\tt.Fatal(\\\"nothing in runCandidate establishes whether the accepted candidate is committed\\\")\\n+\\t}\\n+\\tjudged := strings.Index(body, \\\"judgeCandidate\\\")\\n+\\tcompletion := strings.Index(body, \\\"e.emitChangeReport(\\\")\\n+\\tif judged \u003c 0 || completion \u003c 0 {\\n+\\t\\tt.Fatal(\\\"the acceptance path no longer has the shape this test describes\\\")\\n+\\t}\\n+\\tif !(judged \u003c at \u0026\u0026 at \u003c completion) {\\n+\\t\\tt.Fatalf(\\\"the commitment check is not between the resolved review and terminal completion (judged=%d check=%d completion=%d)\\\", judged, at, completion)\\n+\\t}\\n+\\tsrc := rawSource(t, \\\"internal/workflow/engine.go\\\")\\n+\\ti := strings.Index(src, `candidate.ChangeSet(ctx, \\\"HEAD\\\")`)\\n+\\tif i \u003c 0 {\\n+\\t\\tt.Fatal(\\\"the commitment check does not ask Git what is uncommitted against HEAD\\\")\\n+\\t}\\n+\\t// The refusal must name what is uncommitted; \\\"the candidate is not\\n+\\t// committed\\\" with no paths is not something a worker can act on.\\n+\\tif !strings.Contains(src[i:min(i+900, len(src))], \\\"uncommitted.Paths()\\\") {\\n+\\t\\tt.Fatal(\\\"the refusal does not name the uncommitted paths\\\")\\n+\\t}\\n+}\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"55d34540-5161-4344-aa41-f2d3346381f6\",\"uuid\":\"ef3a8a93-e0ff-4edd-a656-379e175d6f5e\",\"timestamp\":\"2026-08-30T00:37:39.559Z\",\"tool_use_result\":{\"stdout\":\"diff --git a/internal/workflow/engine_test.go b/internal/workflow/engine_test.go\\nindex 021e824..d591117 100644\\n--- a/internal/workflow/engine_test.go\\n+++ b/internal/workflow/engine_test.go\\n@@ -9,6 +9,9 @@ import (\\n \\t\\\"go/parser\\\"\\n \\t\\\"go/token\\\"\\n \\t\\\"os\\\"\\n+\\t\\\"os/exec\\\"\\n+\\t\\\"path/filepath\\\"\\n+\\t\\\"strconv\\\"\\n \\t\\\"strings\\\"\\n \\t\\\"testing\\\"\\n \\t\\\"time\\\"\\n@@ -18,6 +21,8 @@ import (\\n \\t\\\"github.com/globulario/sensei-code/internal/authority\\\"\\n \\t\\\"github.com/globulario/sensei-code/internal/decision\\\"\\n \\t\\\"github.com/globulario/sensei-code/internal/event\\\"\\n+\\t\\\"github.com/globulario/sensei-code/internal/gitx\\\"\\n+\\t\\\"github.com/globulario/sensei-code/internal/report\\\"\\n \\t\\\"github.com/globulario/sensei-code/internal/taskstate\\\"\\n )\\n \\n@@ -1321,3 +1326,315 @@ func TestAReadOnlyWorkerIsToldToReconcileItsOwnFindings(t *testing.T) {\\n \\t\\t}\\n \\t}\\n }\\n+\\n+// Confinement compares pathnames EXACTLY as Git reports them. A path that\\n+// differs from a planned one only by whitespace is a DIFFERENT FILE, and the\\n+// difference is invisible in prose -- which is precisely why nothing here may\\n+// trim it away.\\n+func TestAPathDifferingFromThePlanOnlyByWhitespaceIsRefused(t *testing.T) {\\n+\\tplanned := []string{\\\"internal/workflow/engine.go\\\"}\\n+\\tfor _, changed := range []string{\\n+\\t\\t\\\" internal/workflow/engine.go\\\",\\n+\\t\\t\\\"internal/workflow/engine.go \\\",\\n+\\t\\t\\\"internal/workflow/engine.go\\\\t\\\",\\n+\\t\\t\\\"internal/workflow/ engine.go\\\",\\n+\\t} {\\n+\\t\\terr := confineToPlan([]string{changed}, planned)\\n+\\t\\tif err == nil {\\n+\\t\\t\\tt.Errorf(\\\"a candidate that changed %q under a plan naming %q was admitted; they are different files\\\",\\n+\\t\\t\\t\\tchanged, planned[0])\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\t// The refusal has to SHOW the difference, or its reader cannot act on it.\\n+\\t\\tif !strings.Contains(err.Error(), strconv.Quote(changed)) {\\n+\\t\\t\\tt.Errorf(\\\"the refusal for %q does not show the path it refused: %v\\\", changed, err)\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// The plan's own spelling may be canonicalised by path.Clean and by nothing\\n+// else. Clean folds different spellings of ONE path together; it never removes\\n+// whitespace, so it cannot fold two different paths into one.\\n+func TestThePlansSpellingIsCleanedAndNeverTrimmed(t *testing.T) {\\n+\\tplanned := []string{\\\"./internal/workflow//engine.go\\\", \\\"internal/./workflow/testedit.go\\\"}\\n+\\tif err := confineToPlan([]string{\\\"internal/workflow/engine.go\\\", \\\"internal/workflow/testedit.go\\\"}, planned); err != nil {\\n+\\t\\tt.Fatalf(\\\"an in-plan candidate was refused over the plan's own spelling: %v\\\", err)\\n+\\t}\\n+\\t// A plan whose own entry carries whitespace names the whitespace-bearing\\n+\\t// file, and only that one.\\n+\\tif err := confineToPlan([]string{\\\" a.go\\\"}, []string{\\\" a.go\\\"}); err != nil {\\n+\\t\\tt.Fatalf(\\\"a plan naming %q refused a candidate that changed exactly it: %v\\\", \\\" a.go\\\", err)\\n+\\t}\\n+\\tif err := confineToPlan([]string{\\\"a.go\\\"}, []string{\\\" a.go\\\"}); err == nil {\\n+\\t\\tt.Fatal(\\\"a plan naming \\\\\\\" a.go\\\\\\\" admitted a change to \\\\\\\"a.go\\\\\\\"; the plan's whitespace was trimmed away\\\")\\n+\\t}\\n+}\\n+\\n+// The paths Git quotes in a diff header are the ones a text parser loses, so\\n+// they are the ones an out-of-plan change can hide behind. Confinement sees\\n+// them, because it reads Git's own answer rather than the header.\\n+func TestAQuotedOutOfPlanChangeIsRefused(t *testing.T) {\\n+\\tplanned := []string{\\\"internal/workflow/engine.go\\\"}\\n+\\tfor _, name := range []string{\\n+\\t\\t\\\"a quoted modification\\\", \\\"a quoted deletion\\\", \\\"an ASCII control\\\", \\\"a tab\\\",\\n+\\t} {\\n+\\t\\tvar changed []string\\n+\\t\\tswitch name {\\n+\\t\\tcase \\\"a quoted modification\\\":\\n+\\t\\t\\tchanged = []string{\\\"internal/workflow/engine.go\\\", \\\"ünïcode.go\\\"}\\n+\\t\\tcase \\\"a quoted deletion\\\":\\n+\\t\\t\\tchanged = []string{\\\"internal/workflow/engine.go\\\", \\\"doomed-é.go\\\"}\\n+\\t\\tcase \\\"an ASCII control\\\":\\n+\\t\\t\\tchanged = []string{\\\"internal/workflow/engine.go\\\", \\\"ctrl\\\\x01.go\\\"}\\n+\\t\\tcase \\\"a tab\\\":\\n+\\t\\t\\tchanged = []string{\\\"internal/workflow/engine.go\\\", \\\"tab\\\\there.go\\\"}\\n+\\t\\t}\\n+\\t\\tif err := confineToPlan(changed, planned); err == nil {\\n+\\t\\t\\tt.Errorf(\\\"%s outside the plan was admitted: %q\\\", name, changed[1])\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// A rename REMOVES a path. Confining on the new path alone would let a\\n+// candidate move a file the plan does not name and be judged only on where it\\n+// landed, which is why gitx.ChangeSet.Paths carries both sides.\\n+func TestARenameOutOfAnUnplannedPathIsRefused(t *testing.T) {\\n+\\tset := gitx.ChangeSet{Files: []gitx.FileChange{\\n+\\t\\t{Path: \\\"internal/workflow/engine.go\\\", OldPath: \\\"internal/workflow/elsewhere.go\\\", Status: gitx.Renamed},\\n+\\t}}\\n+\\terr := confineToPlan(set.Paths(), []string{\\\"internal/workflow/engine.go\\\"})\\n+\\tif err == nil {\\n+\\t\\tt.Fatal(\\\"a rename whose old path is outside the plan was admitted\\\")\\n+\\t}\\n+\\tif !strings.Contains(err.Error(), \\\"elsewhere.go\\\") {\\n+\\t\\tt.Fatalf(\\\"the refusal does not name the path the rename removed: %v\\\", err)\\n+\\t}\\n+}\\n+\\n+// An in-plan candidate is not disturbed by any of this.\\n+func TestAnInPlanCandidateStillPasses(t *testing.T) {\\n+\\tset := gitx.ChangeSet{Files: []gitx.FileChange{\\n+\\t\\t{Path: \\\"internal/gitx/git.go\\\", Status: gitx.Modified},\\n+\\t\\t{Path: \\\"internal/gitx/git_test.go\\\", Status: gitx.Added},\\n+\\t\\t{Path: \\\"internal/report/report.go\\\", OldPath: \\\"internal/report/old.go\\\", Status: gitx.Renamed},\\n+\\t}}\\n+\\tplanned := []string{\\n+\\t\\t\\\"internal/gitx/git.go\\\", \\\"internal/gitx/git_test.go\\\",\\n+\\t\\t\\\"internal/report/report.go\\\", \\\"internal/report/old.go\\\",\\n+\\t}\\n+\\tif err := confineToPlan(set.Paths(), planned); err != nil {\\n+\\t\\tt.Fatalf(\\\"an in-plan candidate was refused: %v\\\", err)\\n+\\t}\\n+}\\n+\\n+// A test-edit grant says HOW a planned file may be edited. It never adds a file\\n+// to the plan, and confinement must not be able to read one -- an operational\\n+// authority that could widen scope would be scope.\\n+func TestConfinementReadsNoTestEditGrant(t *testing.T) {\\n+\\tfn := funcBody(t, \\\"internal/workflow/testedit.go\\\", \\\"confineToPlan\\\")\\n+\\tfor _, forbidden := range []string{\\\"testEditGrant\\\", \\\"operationalFiles\\\", \\\"TrimSpace\\\", \\\"ToLower\\\", \\\"EqualFold\\\", \\\"FromSlash\\\", \\\"ToSlash\\\"} {\\n+\\t\\tif strings.Contains(fn, forbidden) {\\n+\\t\\t\\tt.Errorf(\\\"confineToPlan reads %s; it must compare Git's paths exactly and take no grant\\\", forbidden)\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// Git is the authority on what a candidate changed; report.FromDiff renders it.\\n+// When the two disagree, one of them is wrong about what this candidate IS, and\\n+// nothing downstream can tell which -- so the candidate is refused and the\\n+// disagreement is named.\\n+func TestADisagreementBetweenGitAndTheDiffRefusesTheCandidate(t *testing.T) {\\n+\\tagreeing := gitx.ChangeSet{Files: []gitx.FileChange{\\n+\\t\\t{Path: \\\"a.go\\\", Status: gitx.Modified},\\n+\\t\\t{Path: \\\"c.go\\\", OldPath: \\\"b.go\\\", Status: gitx.Renamed},\\n+\\t}}\\n+\\trendered := report.Change{Files: []report.FileChange{\\n+\\t\\t{Path: \\\"a.go\\\", Status: report.Modified},\\n+\\t\\t{Path: \\\"c.go\\\", OldPath: \\\"b.go\\\", Status: report.Renamed},\\n+\\t}}\\n+\\tif err := reconcileChangeSet(agreeing, rendered); err != nil {\\n+\\t\\tt.Fatalf(\\\"two readings that agree were refused: %v\\\", err)\\n+\\t}\\n+\\n+\\tfor _, c := range []struct {\\n+\\t\\tname    string\\n+\\t\\tdiff    report.Change\\n+\\t\\tmustSay string\\n+\\t}{\\n+\\t\\t{\\n+\\t\\t\\tname:    \\\"the diff lost a file Git reports\\\",\\n+\\t\\t\\tdiff:    report.Change{Files: rendered.Files[:1]},\\n+\\t\\t\\tmustSay: \\\"c.go\\\",\\n+\\t\\t},\\n+\\t\\t{\\n+\\t\\t\\tname: \\\"the diff reports a file Git does not\\\",\\n+\\t\\t\\tdiff: report.Change{Files: append(append([]report.FileChange{}, rendered.Files...),\\n+\\t\\t\\t\\treport.FileChange{Path: \\\"extra.go\\\", Status: report.Added})},\\n+\\t\\t\\tmustSay: \\\"extra.go\\\",\\n+\\t\\t},\\n+\\t\\t{\\n+\\t\\t\\tname: \\\"the two disagree about a status\\\",\\n+\\t\\t\\tdiff: report.Change{Files: []report.FileChange{\\n+\\t\\t\\t\\t{Path: \\\"a.go\\\", Status: report.Added},\\n+\\t\\t\\t\\t{Path: \\\"c.go\\\", OldPath: \\\"b.go\\\", Status: report.Renamed},\\n+\\t\\t\\t}},\\n+\\t\\t\\tmustSay: \\\"a.go\\\",\\n+\\t\\t},\\n+\\t\\t{\\n+\\t\\t\\tname: \\\"the two disagree about a rename's old path\\\",\\n+\\t\\