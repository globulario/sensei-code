nt.ProspectiveGranted,\\n2593-\\t\\t\\t\\\"prospective authority recorded for \\\"+strings.Join(names, \\\", \\\"),\\n2594-\\t\\t\\tprospectiveRecord{World: c.world, Grants: c.prospective}))\\n2595-\\t}\\n2596-\\treturn c.coverage\\n2597-}\\n2598-\\n2599-// restoreProspectiveGrants re-establishes, from the session record, the\\n2600-// prospective authorization a resumed task's inspection must check against.\\n2601-//\\n2602-// A task that declared surfaces but has no intact record for them is not\\n2603-// resumed: routing is not re-run on resume, so nothing else could establish\\n2604-// the facts, and inspecting against an empty set would either refute a valid\\n2605-// creation or accept one whose authorization was never recorded. A record from\\n2606-// another world is refused for the same reason.\\n2607-func (e *Engine) restoreProspectiveGrants(task session.Interrupted, declared []ProspectiveSurface, world string) error {\\n2608-\\tif len(declared) == 0 {\\n2609-\\t\\treturn nil\\n2610-\\t}\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"403f3038-5a27-408b-96f3-16d43628636f\",\"uuid\":\"5552affa-9b6c-4647-b2e7-a129d8c9979b\",\"timestamp\":\"2026-08-29T00:58:43.386Z\",\"tool_use_result\":{\"stdout\":\"2565:func (e *Engine) derivedCoverage(ctx context.Context, taskID string, planned []string, declarations []ProspectiveSurface) []CoverageAnchor {\\n2566-\\tc, ok := e.coverageAtWorld(ctx, taskID, planned, declarations)\\n2567-\\tif !ok {\\n2568-\\t\\treturn nil\\n2569-\\t}\\n2570-\\te.setProspectiveGrants(taskID, c.prospective)\\n2571-\\te.setTestEditGrants(taskID, c.edits)\\n2572-\\tif len(c.edits) != 0 {\\n2573-\\t\\tnames := make([]string, 0, len(c.edits))\\n2574-\\t\\tfor _, g := range c.edits {\\n2575-\\t\\t\\tnames = append(names, g.Path+\\\" beside \\\"+g.Covering)\\n2576-\\t\\t}\\n2577-\\t\\te.emit(event.New(e.SessionID, taskID, event.SourceSystem, event.TestEditGranted,\\n2578-\\t\\t\\t\\\"existing-test edit authority recorded for \\