dModify(path string) string {\\n+\\treturn \\\"diff --git a/\\\" + path + \\\" b/\\\" + path + \\\"\\\\nindex 1111111..2222222 100644\\\\n--- a/\\\" + path + \\\"\\\\n+++ b/\\\" + path + \\\"\\\\n@@ -1 +1 @@\\\\n-before\\\\n+after\\\\n\\\"\\n+}\\n+\\n+func unifiedDelete(path string) string {\\n+\\treturn \\\"diff --git a/\\\" + path + \\\" b/\\\" + path + \\\"\\\\ndeleted file mode 100644\\\\nindex 1111111..0000000\\\\n--- a/\\\" + path + \\\"\\\\n+++ /dev/null\\\\n@@ -1 +0,0 @@\\\\n-gone\\\\n\\\"\\n+}\\n+\\n+func unifiedRename(from, to string) string {\\n+\\treturn \\\"diff --git a/\\\" + from + \\\" b/\\\" + to + \\\"\\\\nsimilarity index 100%\\\\nrename from \\\" + from + \\\"\\\\nrename to \\\" + to + \\\"\\\\n\\\"\\n+}\\n+\\n+// A candidate is confined to the files its plan names.\\n+//\\n+// The plan's file list bounded what the worker was ASKED to change, and after\\n+// the worker ran nothing read it again: a candidate that also edited a file\\n+// outside the plan reached validation, the audit, the classification, the\\n+// reviewer and admission as though the plan had named it. The reviewer might\\n+// notice; noticing is not a boundary.\\n+func TestCandidateWiderThanPlanIsRefusedBeforeReview(t *testing.T) {\\n+\\tplanned := []string{\\\"internal/workflow/engine.go\\\", \\\"./internal/workflow/testedit.go\\\"}\\n+\\n+\\t// One path outside the plan refuses the candidate, and the refusal names\\n+\\t// both that path and what the plan actually authorised.\\n+\\terr := confineToPlannedFiles(unifiedModify(\\\"internal/workflow/engine.go\\\")+unifiedModify(\\\"internal/broker/guard.go\\\"), planned)\\n+\\tif err == nil {\\n+\\t\\tt.Fatal(\\\"a candidate that changed a file the plan never named was accepted\\\")\\n+\\t}\\n+\\tif !strings.Contains(err.Error(), \\\"internal/broker/guard.go\\\") {\\n+\\t\\tt.Fatalf(\\\"the refusal does not name the path outside the plan: %v\\\", err)\\n+\\t}\\n+\\tif !strings.Contains(err.Error(), \\\"internal/workflow/engine.go\\\") {\\n+\\t\\tt.Fatalf(\\\"the refusal does not state which files the plan named: %v\\\", err)\\n+\\t}\\n+\\n+\\t// A candidate inside its plan passes, including the plan's own \\\"./\\\"\\n+\\t// spelling of a file the diff spells bare.\\n+\\tif err := confineToPlannedFiles(unifiedModify(\\\"internal/workflow/engine.go\\\")+unifiedModify(\\\"internal/workflow/testedit.go\\\"), planned); err != nil {\\n+\\t\\tt.Fatalf(\\\"a candidate that stayed inside its plan was refused: %v\\\", err)\\n+\\t}\\n+\\n+\\t// A deletion is a change. Removing a file the plan never named is exactly\\n+\\t// the widening this refuses, and a check reading only added or modified\\n+\\t// paths would let it through.\\n+\\tif err := confineToPlannedFiles(unifiedDelete(\\\"docs/awareness/high_risk_files.yaml\\\"), planned); err == nil ||\\n+\\t\\t!strings.Contains(err.Error(), \\\"docs/awareness/high_risk_files.yaml\\\") {\\n+\\t\\tt.Fatalf(\\\"a deletion outside the plan was not refused: %v\\\", err)\\n+\\t}\\n+\\n+\\t// A rename is two paths and both must be named: moving a planned file to an\\n+\\t// unplanned one changes a file the plan did not name.\\n+\\tif err := confineToPlannedFiles(unifiedRename(\\\"internal/workflow/testedit.go\\\", \\\"internal/workflow/scope.go\\\"), planned); err == nil ||\\n+\\t\\t!strings.Contains(err.Error(), \\\"internal/workflow/scope.go\\\") {\\n+\\t\\tt.Fatalf(\\\"a rename out of the plan was not refused: %v\\\", err)\\n+\\t}\\n+\\n+\\t// And it refuses where a refusal still means something: in runCandidate,\\n+\\t// after the read-only refusal and before the candidate is announced,\\n+\\t// validated, audited, classified or reviewed.\\n+\\tsrc := rawSource(t, \\\"internal/workflow/engine.go\\\")\\n+\\treadOnly := strings.Index(src, \\\"the plan was read-only and the candidate changed\\\")\\n+\\tconfine := strings.Index(src, \\\"confineToPlannedFiles(diff\\\")\\n+\\tannounced := strings.Index(src, \\\"event.CandidateChanged\\\")\\n+\\tvalidated := strings.Index(src, \\\"e.validate(ctx\\\")\\n+\\taudited := strings.Index(src, `sc.CallTool(\\\"awareness_audit_diff\\\"`)\\n+\\tclassified := strings.Index(src, \\\"e.classifyForDarkRun(\\\")\\n+\\tif readOnly \u003c 0 || confine \u003c 0 || announced \u003c 0 || validated \u003c 0 || audited \u003c 0 || classified \u003c 0 {\\n+\\t\\tt.Fatal(\\\"the candidate loop no longer holds the refusal and the steps it must precede\\\")\\n+\\t}\\n+\\tif confine \u003c readOnly {\\n+\\t\\tt.Fatal(\\\"the confinement check runs before the read-only refusal\\\")\\n+\\t}\\n+\\tfor _, downstream := range []struct {\\n+\\t\\tat   int\\n+\\t\\twhat string\\n+\\t}{{announced, \\\"the candidate.changed event\\\"}, {validated, \\\"validation\\\"}, {audited, \\\"the audit\\\"}, {classified, \\\"the Level-1 classification\\\"}} {\\n+\\t\\tif confine \u003e downstream.at {\\n+\\t\\t\\tt.Fatalf(\\\"a candidate wider than its plan reaches %s before it is refused\\\", downstream.what)\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// An operational test-edit grant is authority to edit a file the plan already\\n+// names. It is not, and can never become, authority to touch one the plan does\\n+// not -- so the check that enforces the plan's bound is given no grant to read.\\n+func TestOperationalTestGrantDoesNotExpandPlanScope(t *testing.T) {\\n+\\t// The grant machinery does produce a grant for exactly this test file.\\n+\\tgrants, _ := testEditGrants(context.Background(), teWorld, []string{teS, teF}, teCovered(), teRead(map[string]string{teS: teSSrc, teF: teFSrc}))\\n+\\tif len(grants) != 1 || grants[0].Path != teF {\\n+\\t\\tt.Fatalf(\\\"the fixture no longer produces the grant this test is about: %+v\\\", grants)\\n+\\t}\\n+\\n+\\t// A plan that names only the subject does not authorise touching the test\\n+\\t// beside it, grantable or not: a grant is computed from the plan's files\\n+\\t// and cannot reach outside them.\\n+\\terr := confineToPlannedFiles(unifiedModify(teS)+unifiedModify(teF), []string{teS})\\n+\\tif err == nil || !strings.Contains(err.Error(), teF) {\\n+\\t\\tt.Fatalf(\\\"a grantable test file the plan never named was let through: %v\\\", err)\\n+\\t}\\n+\\n+\\t// The check has two inputs, the diff and the plan's files, and there is no\\n+\\t// third one a grant could arrive through.\\n+\\tsrc := rawSource(t, \\\"internal/workflow/testedit.go\\\")\\n+\\tif !strings.Contains(src, \\\"func confineToPlannedFiles(diff string, planned []string) error {\\\") {\\n+\\t\\tt.Fatal(\\\"the confinement check no longer takes exactly the diff and the plan's files\\\")\\n+\\t}\\n+\\tif !strings.Contains(rawSource(t, \\\"internal/workflow/engine.go\\\"), \\\"confineToPlannedFiles(diff, tc.Files)\\\") {\\n+\\t\\tt.Fatal(\\\"the confinement check is called with something other than the diff and the plan's files\\\")\\n+\\t}\\n+\\tbody := funcBody(t, \\\"internal/workflow/testedit.go\\\", \\\"confineToPlannedFiles\\\")\\n+\\tfor _, grant := range []string{\\\"testEditGrant\\\", \\\"testEditGrants\\\", \\\"operationalFiles\\\", \\\"grants\\\", \\\"Prospective\\\", \\\"prospectiveGrants\\\"} {\\n+\\t\\tif strings.Contains(body, grant) {\\n+\\t\\t\\tt.Fatalf(\\\"the confinement check reads %s, so a grant can enlarge the set it compares against\\\", grant)\\n+\\t\\t}\\n+\\t}\\n+}\\n+\\n+// A supplied plan is a bound authored outside the run, byte for byte. The\\n+// candidate is judged against it and never edits it: refusing a wider\\n+// candidate must leave the supplied plan's identity and file list exactly as\\n+// they were handed in.\\n+func TestASuppliedPlanIsNotWidenedByTheCandidate(t *testing.T) {\\n+\\ttc := testContext()\\n+\\ttc.PlanSource = PlanSupplied\\n+\\ttc.PlanDigest = \\\"3a5f1c0e2b7d4a9f8c6b5e4d3c2b1a09f8e7d6c5b4a39281706f5e4d3c2b1a09\\\"\\n+\\ttc.Files = []string{\\\"cmd/sensei-code/main.go\\\", \\\"internal/workflow/gate.go\\\"}\\n+\\tdigest := tc.PlanDigest\\n+\\tfiles := strings.Join(tc.Files, \\\"\\\\x00\\\")\\n+\\n+\\terr := confineToPlannedFiles(unifiedModify(\\\"cmd/sensei-code/main.go\\\")+unifiedModify(\\\"internal/authority/router.go\\\"), tc.Files)\\n+\\tif err == nil || !strings.Contains(err.Error(), \\\"internal/authority/router.go\\\") {\\n+\\t\\tt.Fatalf(\\\"a candidate wider than the supplied plan was accepted: %v\\\", err)\\n+\\t}\\n+\\tif tc.PlanDigest != digest {\\n+\\t\\tt.Fatalf(\\\"the supplied plan's digest changed: %q -\u003e %q\\\", digest, tc.PlanDigest)\\n+\\t}\\n+\\tif got := strings.Join(tc.Files, \\\"\\\\x00\\\"); got != files {\\n+\\t\\tt.Fatalf(\\\"the supplied plan's files changed: %q -\u003e %q\\\", files, got)\\n+\\t}\\n+\\tif tc.PlanSource != PlanSupplied {\\n+\\t\\tt.Fatalf(\\\"the plan stopped being supplied: %q\\\", tc.PlanSource)\\n+\\t}\\n+}\\ndiff --git a/internal/workflow/routine_test.go b/internal/workflow/routine_test.go\\nindex 740cc1c..78a3253 100644\\n--- a/internal/workflow/routine_test.go\\n+++ b/internal/workflow/routine_test.go\\n@@ -605,3 +605,41 @@ func TestArchitectProseCannotChangeTheClassification(t *testing.T) {\\n \\t\\tt.Fatal(\\\"calling a change trivial made an uncovered region routine\\\")\\n \\t}\\n }\\n+\\n+// The Level-1 classifier stops at the first categorical exclusion, so a\\n+// candidate that touches the governance path is reported as \\\"touches the\\n+// governance path\\\" and its widening is never mentioned. That is correct for a\\n+// classifier — it says why the change is not routine, not everything wrong with\\n+// it — but it means the classification cannot be where widening is caught. The\\n+// confinement check refuses the same candidate on its own, reading the plan's\\n+// files and the diff and no classification at all.\\n+func TestGovernancePathClassificationCannotMaskScopeWidening(t *testing.T) {\\n+\\tplanned := []string{\\\"internal/workflow/routine.go\\\"}\\n+\\tdiff := unifiedModify(\\\"internal/workflow/routine.go\\\") + unifiedModify(\\\"internal/tui/model.go\\\")\\n+\\n+\\td := classifyRoutine(qualifyingPreflight(), nil, cleanEditCheck(), planned, shapeOf(diff))\\n+\\tif d.Routine {\\n+\\t\\tt.Fatal(\\\"a candidate touching the governance path was classified routine\\\")\\n+\\t}\\n+\\tif !strings.Contains(d.Blocking, \\\"governance path\\\") {\\n+\\t\\tt.Fatalf(\\\"the classification blocked for another reason: %q\\\", d.Blocking)\\n+\\t}\\n+\\tif strings.Contains(d.Blocking, \\\"internal/tui/model.go\\\") {\\n+\\t\\tt.Fatalf(\\\"this test assumes the classification stops before the widening; it now reports it: %q\\\", d.Blocking)\\n+\\t}\\n+\\n+\\t// Refused anyway, by name.\\n+\\terr := confineToPlannedFiles(diff, planned)\\n+\\tif err == nil || !strings.Contains(err.Error(), \\\"internal/tui/model.go\\\") {\\n+\\t\\tt.Fatalf(\\\"a candidate wider than its plan survived because its widening was masked: %v\\\", err)\\n+\\t}\\n+\\n+\\t// And the refusal owes nothing to the classification: no verdict, no\\n+\\t// exclusion list, no fast-path condition can change what it compares.\\n+\\tbody := funcBody(t, \\\"internal/workflow/testedit.go\\\", \\\"confineToPlannedFiles\\\")\\n+\\tfor _, classification := range []string{\\\"classifyRoutine\\\", \\\"RoutineDecision\\\", \\\"categoricallyExcluded\\\", \\\"governancePath\\\", \\\"notPlanned\\\", \\\"shapeOf\\\"} {\\n+\\t\\tif strings.Contains(body, classification) {\\n+\\t\\t\\tt.Fatalf(\\\"the confinement check consults %s, so a classification can decide what it refuses\\\", classification)\\n+\\t\\t}\\n+\\t}\\n+}\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}","payload":{"stream":"stdout"}}
