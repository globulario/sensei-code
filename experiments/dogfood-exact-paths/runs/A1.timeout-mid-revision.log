system will not hold %q: %v\\\", n, err)\\n\\t\\t}\\n\\t}\\n\\tgit(\\\"add\\\", \\\"-A\\\")\\n\\tgit(\\\"commit\\\", \\\"-q\\\", \\\"-m\\\", \\\"base\\\")\\n\\tout, _ := exec.Command(\\\"git\\\", \\\"-C\\\", repo.Root, \\\"rev-parse\\\", \\\"HEAD\\\").Output()\\n\\tbase := strings.TrimSpace(string(out))\\n\\n\\t// modify most, delete two, rename two, add two\\n\\tfor _, n := range names[:13] {\\n\\t\\tf, _ := os.OpenFile(filepath.Join(repo.Root, n), os.O_APPEND|os.O_WRONLY, 0o644)\\n\\t\\tf.WriteString(\\\"changed\\\\n\\\")\\n\\t\\tf.Close()\\n\\t}\\n\\tos.Remove(filepath.Join(repo.Root, \\\"gone quoted\\\\t.txt\\\"))\\n\\tos.Remove(filepath.Join(repo.Root, \\\"b/confusing a/name.txt\\\"))\\n\\tgit(\\\"mv\\\", \\\"old plain.txt\\\", \\\"renamed plain.txt\\\")\\n\\tgit(\\\"mv\\\", \\\"old\\\\tquoted.txt\\\", \\\"renamed\\\\tquoted.txt\\\")\\n\\tos.WriteFile(filepath.Join(repo.Root, \\\"added\\\\ttab.txt\\\"), []byte(\\\"new\\\\n\\\"), 0o644)\\n\\tos.WriteFile(filepath.Join(repo.Root, \\\"added plain.txt\\\"), []byte(\\\"new\\\\n\\\"), 0o644)\\n\\n\\tcapture, err := repo.CandidateCapture(context.Background(), base, nil)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tc, err := report.FromCapture(capture.Diff, capture.Paths)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"FromCapture: %v\\\\n---diff---\\\\n%s\\\\n---paths---\\\\n%q\\\", err, capture.Diff, capture.Paths)\\n\\t}\\n\\tfor _, f := range c.Files {\\n\\t\\tt.Logf(\\\"%-9s %q old=%q\\\", f.Status, f.Path, f.OldPath)\\n\\t}\\n\\tadded, modified, deleted := c.Counts()\\n\\tt.Logf(\\\"counts a=%d m=%d d=%d files=%d paths=%d\\\", added, modified, deleted, len(c.Files), len(capture.Paths))\\n}\\nGOEOF\\ngo test ./internal/workflow/ -run ScratchManyAwkward -v 2\u003e\u00261 | tail -30\",\"description\":\"Stress test against real git output\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":3445,\"cache