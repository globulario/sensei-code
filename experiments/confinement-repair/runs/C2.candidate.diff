+// An operational test-edit grant is authority to edit a file the plan already
+// names. It is not, and can never become, authority to touch one the plan does
+// not -- so the check that enforces the plan's bound is given no grant to read.
+func TestOperationalTestGrantDoesNotExpandPlanScope(t *testing.T) {
+	// The grant machinery does produce a grant for exactly this test file.
+	grants, _ := testEditGrants(context.Background(), teWorld, []string{teS, teF}, teCovered(), teRead(map[string]string{teS: teSSrc, teF: teFSrc}))
+	if len(grants) != 1 || grants[0].Path != teF {
+		t.Fatalf("the fixture no longer produces the grant this test is about: %+v", grants)
+	}
+
+	// A plan that names only the subject does not authorise touching the test
+	// beside it, grantable or not: a grant is computed from the plan's files
+	// and cannot reach outside them.
+	err := confineToPlannedFiles(unifiedModify(teS)+unifiedModify(teF), []string{teS})
+	if err == nil || !strings.Contains(err.Error(), teF) {
+		t.Fatalf("a grantable test file the plan never named was let through: %v", err)
+	}
+
+	// The check has two inputs, the diff and the plan's files, and there is no
+	// third one a grant could arrive through.
+	src := rawSource(t, "internal/workflow/testedit.go")
+	if !strings.Contains(src, "func confineToPlannedFiles(diff string, planned []string) error {") {
+		t.Fatal("the confinement check no longer takes exactly the diff and the plan's files")
+	}
+	if !strings.Contains(rawSource(t, "internal/workflow/engine.go"), "confineToPlannedFiles(diff, tc.Files)") {
+		t.Fatal("the confinement check is called with something other than the diff and the plan's files")
+	}
+	body := funcBody(t, "internal/workflow/testedit.go", "confineToPlannedFiles")
+	for _, grant := range []string{"testEditGrant", "testEditGrants", "operationalFiles", "grants", "Prospective", "prospectiveGrants"} {
+		if strings.Contains(body, grant) {
+			t.Fatalf("the confinement check reads %s, so a grant can enlarge the set it compares against", grant)
+		}
+	}
+}
