(line, \\\"rename to \\\"):\\ninternal/report/report.go-92-\\t\\t\\t// The rename lines carry both paths whole, however many spaces\\ninternal/report/report.go-93-\\t\\t\\t// they hold; they outrank the header's guess.\\ninternal/report/report.go-94-\\t\\t\\tcurrent = strings.TrimPrefix(line, \\\"rename to \\\")\\ninternal/report/report.go-95-\\t\\tcase strings.HasPrefix(line, \\\"+++ b/\\\") \u0026\u0026 current == \\\"\\\":\\ninternal/report/report.go-96-\\t\\t\\tcurrent = strings.TrimSuffix(strings.TrimPrefix(line, \\\"+++ b/\\\"), \\\"\\\\t\\\")\\ninternal/report/report.go-97-\\t\\tcase strings.HasPrefix(line, \\\"+\\\") \u0026\u0026 !strings.HasPrefix(line, \\\"+++\\\"):\\ninternal/report/report.go-98-\\t\\t\\tif kind := awarenessKind(current); kind != \\\"\\\" \u0026\u0026 isEntryStart(line) {\\ninternal/report/report.go-99-\\t\\t\\t\\tchange.Awareness[kind]++\\ninternal/report/report.go-100-\\t\\t\\t}\\ninternal/report/report.go-101-\\t\\t}\\ninternal/report/report.go-102-\\t}\\ninternal/report/report.go-103-\\tflush()\\ninternal/report/report.go-104-\\treturn change\\ninternal/report/report.go-105-}\\ninternal/report/report.go-106-\\ninternal/report/report.go-107-// diffPath takes the b-side path from a `diff --git a/P b/P` header.\\ninternal/report/report.go-108-//\\ninternal/report/report.go-109-// It used to split the line on whitespace, which lost every path containing\\ninternal/report/report.go-110-// a space -- and a granted test file at such a path then read as untouched\\ninternal/report/report.go-111-// and skipped inspection (sensei-code#101 review). Git does not quote spaces\\ninternal/report/report.go-112-// in this header, so the line is parsed by its shape instead: for an\\ninternal/report/report.go-113-// unrenamed file both halves are the same path, and the one split that makes\\ninternal/report/report.go-114-// them equal is the answer. A header whose halves differ (a rename) yields\\ninternal/report/report.go-115-// \\\"\\\" here and is completed by the `rename to` line that follows it.\\ninternal/report/report.go-116-func diffPath(line string) string {\\ninternal/report/report.go-117-\\trest := strings.TrimPrefix(line, \\\"diff --git \\\")\\ninternal/report/report.go-118-\\tif !strings.HasPrefix(rest, \\\"a/\\\") {\\ninternal/report/report.go-119-\\t\\treturn \\\"\\\"\\ninternal/report/report.go-120-\\t}\\ninternal/report/report.go-121-\\tfor i := len(rest) - 1; i \u003e 0; i-- {\\ninternal/report/report.go-122-\\t\\tif !strings.HasPrefix(rest[i:], \\\" b/\\\") {\\ninternal/report/report.go-123-\\t\\t\\tcontinue\\ninternal/report/report.go-124-\\t\\t}\\ninternal/report/report.go-125-\\t\\tleft, right := strings.TrimPrefix(rest[:i], \\\"a/\\\"), strings.TrimPrefix(rest[i+1:], \\\"b/\\\")\\ninternal/report/report.go-126-\\t\\tif left == right {\\ninternal/report/report.go-127-\\t\\t\\treturn right\\ninternal/report/report.go-128-\\t\\t}\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"403f3038-5a27-408b-96f3-16d43628636f\",\"uuid\":\"f77156a0-929b-4772-9995-2423d7cd6075\",\"timestamp\":\"2026-08-29T00:57:19.341Z\",\"tool_use_result\":{\"stdout\":\"internal/report/report.go:68:func FromDiff(diff string) Change {\\ninternal/report/report.go-69-\\tchange := Change{Awareness: map[string]int{}}\\ninternal/report/report.go-70-\\tvar current, old string\\ninternal/report/report.go-71-\\tstatus := Modified\\ninternal/report/report.go-72-\\tflush := func() {\\ninternal/report/report.go-73-\\t\\tif current == \\\"\\\" {\\ninternal/report/report.go-74-\\t\\t\\treturn\\ninternal/report/report.go-75-\\t\\t}\\ninternal/report/report.go-76-\\t\\tchange.Files = append(change.Files, FileChange{Path: current, Status: status, OldPath: old})\\ninternal/report/report.go-77-\\t}\\ninternal/report/report.go-78-\\tfor _, line := range strings.Split(diff, \\\"\\\\n\\\") {\\ninternal/report/report.go-79-\\t\\tswitch {\\ninternal/report/report.go-80-\\t\\tcase strings.HasPrefix(line, \\\"diff --git \\\"):\\n