+// Both binding points, in order, and both before anything that reads the
+// candidate.
+//
+// The second is not a duplicate of the first: a formatter runs inside
+// e.validate and may rewrite the candidate, so the set established before it
+// is evidence about bytes that no longer exist. A formatter that widened the
+// candidate past the plan is caught by the second binding point.
+func TestConfinementRefusesAtBothBindingPoints(t *testing.T) {
+	body := rawFuncSource(t, "internal/workflow/engine.go", "runCandidate")
+	lane := strings.Index(body, "the plan was read-only and the candidate changed")
+	if lane < 0 {
+		t.Fatal("the read-only refusal is gone, so the first binding point cannot be located")
+	}
+	// Everything from the read-only refusal on is the lane a candidate that
+	// changed something travels.
+	body = body[lane:]
+
+	if got := strings.Count(body, "confineToPlan(changes.Paths(), tc.Files)"); got != 2 {
+		t.Fatalf("confinement binds %d time(s) over the authoritative change set, want 2", got)
+	}
+	if strings.Contains(body, "confineToPlan(changedPaths(") {
+		t.Fatal("confinement re-parses the diff instead of using the authoritative change set")
+	}
+
+	first := strings.Index(body, "confineToPlan")
+	validate := strings.Index(body, "e.validate(")
+	second := strings.LastIndex(body, "confineToPlan")
+	if validate < 0 {
+		t.Fatal("validation no longer runs in the candidate lane")
+	}
+	if !(first < validate && validate < second) {
+		t.Fatalf("confinement does not bind both before validation and after it (first=%d validate=%d second=%d)", first, validate, second)
+	}
+	// Each binding takes Git's own account first, so a disagreement refuses
+	// before the scope question is even asked.
+	if got := strings.Count(body, "authoritativeChanges(ctx, candidate, tc.Identity.BaseSHA, diff)"); got != 2 {
+		t.Fatalf("the authoritative change set is obtained %d time(s), want 2", got)
+	}
+	if strings.Index(body, "authoritativeChanges") > first {
+		t.Fatal("confinement runs before the change set it confines is established")
+	}
+
+	// The reason the second binding is not a duplicate: a formatter is a
+	// validation check (validation.Format), and one that reformatted a file
+	// the plan does not name has widened the candidate since the first
+	// binding read it.
+	widened := gitx.ChangeSet{Files: []gitx.FileChange{
+		{Path: "internal/workflow/engine.go", Status: gitx.Modified},
+		{Path: "internal/other/formatted.go", Status: gitx.Modified},
+	}}
+	if err := confineToPlan(widened.Paths(), planned("internal/workflow/engine.go")); err == nil {
+		t.Fatal("a candidate a formatter widened past the plan was accepted")
+	}
+
+	// Nothing downstream sees a candidate whose changed files are unestablished
+	// or outside the plan.
+	for _, consumer := range []string{
+		"inspectProspectiveSurfaces(",
+		"inspectTestEdits(",
+		`sc.CallTool("awareness_audit_diff"`,
+		"sensei.DecodeDiffAudit(",
+		"e.classifyForDarkRun(",
+		"e.resolveReview(",
+	} {
+		at := strings.Index(body, consumer)
+		if at < 0 {
+			t.Fatalf("%s no longer runs in the candidate lane; this test no longer proves what it claims", consumer)
+		}
+		if at < second {
+			t.Fatalf("%s reads the candidate before confinement has finished with it", consumer)
+		}
+	}
+}
