+// confineToPlannedFiles refuses a candidate that changed any path the plan did
+// not name.
+//
+// The plan's named files are the whole of what a candidate may touch: every
+// path the diff carries -- added, modified, deleted, or renamed, and both
+// sides of a rename -- must be one of them. A path outside the set refuses the
+// candidate, so nothing downstream (validation, audit, Level-1 classification,
+// review, admission) is ever handed a wider change than the one that was
+// planned.
+//
+// It takes the diff and the named files and NOTHING ELSE. In particular it
+// takes no test-edit grants: a grant is operational authority to edit a file
+// the plan already names (see testEditGrants), never authority to touch one it
+// does not, and a check that could read grants would be a check a grant could
+// widen. The named set is canonicalised exactly as architecturalFiles does, so
+// a plan that spells a file "./pkg/x.go" and a diff that spells it "pkg/x.go"
+// are the same file here.
+func confineToPlannedFiles(diff string, planned []string) error {
+	named := map[string]bool{}
+	var namedList []string
+	for _, f := range planned {
+		if strings.TrimSpace(f) == "" {
+			continue
+		}
+		c := path.Clean(strings.TrimSpace(f))
+		if named[c] {
+			continue
+		}
+		named[c] = true
+		namedList = append(namedList, c)
+	}
+	var outside []string
+	seen := map[string]bool{}
+	for _, f := range report.FromDiff(diff).Files {
+		for _, p := range []string{f.Path, f.OldPath} {
+			if strings.TrimSpace(p) == "" {
+				continue
+			}
+			c := path.Clean(strings.TrimSpace(p))
+			if named[c] || seen[c] {
+				continue
+			}
+			seen[c] = true
+			outside = append(outside, c)
+		}
+	}
+	if len(outside) == 0 {
+		return nil
+	}
+	sort.Strings(outside)
+	return fmt.Errorf("the candidate changed %d path(s) the plan did not name: %s; the plan names: %s",
+		len(outside), strings.Join(outside, ", "), plannedOrNone(namedList))
+}
+
+// plannedOrNone keeps a plan that named no file from reading as a rendering
+// bug. A plan that names nothing authorizes nothing, and saying so is the
+// answer.
+func plannedOrNone(named []string) string {
+	if len(named) == 0 {
+		return "(no file)"
+	}
+	return strings.Join(named, ", ")
+}
