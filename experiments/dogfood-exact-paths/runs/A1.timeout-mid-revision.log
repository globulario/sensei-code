\n4570-\\t\\t\\tcontinue\\n4571-\\t\\t}\\n4572-\\t\\tout = append(out, validation.Check{\\n4573-\\t\\t\\tKind: kind, Command: c.Command, Args: c.Args,\\n4574-\\t\\t\\tMutates:      kind == validation.Format \u0026\u0026 !c.FailIfOutput,\\n4575-\\t\\t\\tFailIfOutput: c.FailIfOutput,\\n4576-\\t\\t})\\n4577-\\t}\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}","payload":{"stream":"stdout"}}
