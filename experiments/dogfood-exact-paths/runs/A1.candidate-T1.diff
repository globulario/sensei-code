+	var out []byte
+	for i := 1; i < len(s); {
+		c := s[i]
+		if c == '"' {
+			return string(out), s[i+1:], true
+		}
+		if c != '\\' {
+			out = append(out, c)
+			i++
+			continue
+		}
+		if i+1 >= len(s) {
+			return "", "", false
+		}
+		if e := s[i+1]; e >= '0' && e <= '7' {
